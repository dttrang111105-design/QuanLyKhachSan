@model QuanLyKhachSan.Models.Review
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Chi tiết đánh giá";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <h2 class="mb-1">Phòng @Model.Room?.RoomNumber</h2>
                        <p class="text-muted mb-0">
                            @(Model.Room?.RoomType?.Name ?? "Chưa xác định loại phòng")
                        </p>
                    </div>
                    <div class="text-nowrap">
                        @for (int star = 1; star <= 5; star++)
                        {
                            <span class="@(star <= Model.Rating ? "text-warning" : "text-secondary") fs-4">★</span>
                        }
                    </div>
                </div>
                <div class="mb-4">
                    <h6 class="fw-bold">Nhận xét</h6>
                    @if (!string.IsNullOrWhiteSpace(Model.Comment))
                    {
                        <p style="white-space: pre-line;">@Model.Comment</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">Không có nội dung nhận xét.</p>
                    }
                </div>
                <dl class="row mb-4">
                    <dt class="col-sm-4">Ngày gửi</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-sm-4">Cập nhật lần cuối</dt>
                        <dd class="col-sm-8">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }
                </dl>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Sửa đánh giá
                    </a>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
