@model IEnumerable<QuanLyKhachSan.Models.Review>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Đánh giá của tôi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h2 class="mb-1">Đánh giá của tôi</h2>
        <p class="text-muted mb-0">
            Quản lý các đánh giá phòng bạn đã gửi.
        </p>
    </div>

    <a asp-controller="Bookings"
       asp-action="MyBookings"
       class="btn btn-outline-primary mt-3 mt-md-0">
        <i class="bi bi-calendar-check me-1"></i>
        Xem Booking của tôi
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show">
        @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h5 class="mb-1">
                                    Phòng @item.Room?.RoomNumber
                                </h5>
                                <div class="text-muted small">
                                    @(item.Room?.RoomType?.Name ?? "Chưa xác định loại phòng")
                                </div>
                            </div>

                            <div class="text-nowrap" aria-label="@item.Rating trên 5 sao">
                                @for (int star = 1; star <= 5; star++)
                                {
                                    <span class="@(star <= item.Rating ? "text-warning" : "text-secondary") fs-5">★</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Comment))
                        {
                            <p class="mb-3" style="white-space: pre-line;">@item.Comment</p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-3">
                                Bạn chưa nhập nhận xét.
                            </p>
                        }

                        <div class="text-muted small mb-3">
                            Gửi lúc @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            @if (item.UpdatedAt.HasValue)
                            {
                                <span> · Cập nhật @item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-info btn-sm">
                                Chi tiết
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Sửa đánh giá
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">
                                Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="display-5 mb-3">⭐</div>
            <h4>Bạn chưa có đánh giá nào</h4>
            <p class="text-muted">
                Sau khi checkout, hãy mở Booking của tôi và chọn “Đánh giá phòng”.
            </p>
            <a asp-controller="Bookings"
               asp-action="MyBookings"
               class="btn btn-primary">
                Mở Booking của tôi
            </a>
        </div>
    </div>
}
