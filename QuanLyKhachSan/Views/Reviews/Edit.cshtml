@model QuanLyKhachSan.ViewModels.Reviews.ReviewFormViewModel
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Sửa đánh giá";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning p-4">
                <h3 class="mb-1">Sửa đánh giá phòng @Model.RoomNumber</h3>
                <p class="mb-0">@Model.RoomTypeName</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="RoomId" type="hidden" />
                    <div class="mb-4">
                        <label asp-for="Rating" class="form-label fw-semibold"></label>
                        <select asp-for="Rating" class="form-select">
                            <option value="5">5 sao - Tuyệt vời</option>
                            <option value="4">4 sao - Tốt</option>
                            <option value="3">3 sao - Bình thường</option>
                            <option value="2">2 sao - Chưa tốt</option>
                            <option value="1">1 sao - Rất không hài lòng</option>
                        </select>
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Comment" class="form-label fw-semibold"></label>
                        <textarea asp-for="Comment"
                                  class="form-control"
                                  rows="6"
                                  maxlength="1000"></textarea>
                        <div class="form-text">Tối đa 1000 ký tự.</div>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-warning">
                            Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
