@model QuanLyKhachSan.Models.Employee
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}
<style>
    .employee-edit-page {
        max-width: 1080px;
        margin: 0 auto;
    }
    .employee-edit-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }
    .employee-edit-kicker {
        display: block;
        margin-bottom: 6px;
        color: #b58a42;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }
    .employee-edit-heading h2 {
        margin: 0;
        color: #252a35;
        font-size: 30px;
        font-weight: 800;
    }
    .employee-edit-back {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border: 1px solid #dfe2e8;
        border-radius: 11px;
        background: #ffffff;
        color: #555c69;
        font-size: 13px;
        font-weight: 700;
    }
    .employee-edit-card {
        overflow: hidden;
        border: 1px solid #e7e9ee;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 22px 55px rgba(34,38,51,.08);
    }
    .employee-edit-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 26px 28px;
        background: radial-gradient(circle at 90% 10%, rgba(200,169,106,.25), transparent 28%), linear-gradient(135deg,#111111,#332717);
        color: #ffffff;
    }
    .employee-edit-icon {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 56px;
        border-radius: 16px;
        background: linear-gradient(145deg,#e5c470,#ad7729);
        color: #171008;
        font-size: 25px;
    }
    .employee-edit-card-header h3 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
    }
    .employee-edit-card-header p {
        margin: 0;
        color: rgba(255,255,255,.65);
    }
    .employee-edit-body {
        padding: 30px;
    }
    .employee-edit-field label {
        margin-bottom: 7px;
        color: #3c424d;
        font-size: 13px;
        font-weight: 700;
    }
    .employee-edit-field .form-control,
    .employee-edit-field .form-select {
        min-height: 50px;
        border: 1px solid #dfe2e8;
        border-radius: 11px;
        background: #fcfcfd;
        box-shadow: none;
    }
        .employee-edit-field .form-control:focus,
        .employee-edit-field .form-select:focus {
            border-color: #b58a42;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(181,138,66,.12);
        }
    .employee-edit-status {
        min-height: 50px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        border: 1px solid #dfe2e8;
        border-radius: 11px;
        background: #fcfcfd;
    }
    .employee-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #eceef2;
    }
    .employee-edit-save,
    .employee-edit-cancel {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 21px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 800;
    }
    .employee-edit-save {
        border: 1px solid #b58a42;
        background: linear-gradient(145deg,#d8b25e,#a8752d);
        color: #ffffff;
    }
    .employee-edit-cancel {
        border: 1px solid #dfe2e8;
        background: #ffffff;
        color: #555c69;
    }
    @@media (max-width: 767.98px) {
        .employee-edit-heading {
            align-items: flex-start;
            flex-direction: column;
        }
        .employee-edit-card-header,
        .employee-edit-body {
            padding: 22px;
        }
        .employee-edit-actions {
            flex-direction: column;
        }
        .employee-edit-save,
        .employee-edit-cancel {
            width: 100%;
        }
    }
</style>
<div class="employee-edit-page">
    <div class="employee-edit-heading">
        <div>
            <span class="employee-edit-kicker">Quản lý nhân viên</span>
            <h2>Chỉnh sửa nhân viên</h2>
        </div>
        <a asp-controller="Employees"
           asp-action="Index"
           class="employee-edit-back">
            <i class="bi bi-arrow-left"></i>
            Quay lại danh sách
        </a>
    </div>
    <div class="employee-edit-card">
        <div class="employee-edit-card-header">
            <span class="employee-edit-icon">
                <i class="bi bi-person-gear"></i>
            </span>
            <div>
                <h3>@Model.FullName</h3>
                <p>Cập nhật hồ sơ, chức vụ và trạng thái làm việc.</p>
            </div>
        </div>
        <div class="employee-edit-body">
            <form asp-controller="Employees"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>
                <div class="row g-4">
                    <div class="col-md-6 employee-edit-field">
                        <label>Tài khoản đăng nhập</label>
                        <input type="text"
                               value="@ViewBag.AccountUsername"
                               class="form-control"
                               readonly />
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="FullName">Họ và tên</label>
                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Nhập họ tên nhân viên" />
                        <span asp-validation-for="FullName"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Gender">Giới tính</label>
                        <select asp-for="Gender"
                                class="form-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <span asp-validation-for="Gender"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="DateOfBirth">Ngày sinh</label>
                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DateOfBirth"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Phone">Số điện thoại</label>
                        <input asp-for="Phone"
                               class="form-control" />
                        <span asp-validation-for="Phone"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Position">Chức vụ</label>
                        <input asp-for="Position"
                               class="form-control" />
                        <span asp-validation-for="Position"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Salary">Lương</label>
                        <div class="input-group">
                            <input asp-for="Salary"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   class="form-control" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Salary"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="HireDate">Ngày vào làm</label>
                        <input asp-for="HireDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="HireDate"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Status">Trạng thái</label>
                        <div class="employee-edit-status">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="Status"
                                       class="form-check-input" />
                                <label asp-for="Status"
                                       class="form-check-label">
                                    Đang làm việc
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 employee-edit-field">
                        <label asp-for="Avatar">Đường dẫn ảnh đại diện</label>
                        <input asp-for="Avatar"
                               class="form-control"
                               placeholder="/uploads/avatar/..." />
                        <span asp-validation-for="Avatar"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-12 employee-edit-field">
                        <label asp-for="Address">Địa chỉ</label>
                        <input asp-for="Address"
                               class="form-control" />
                        <span asp-validation-for="Address"
                              class="text-danger small"></span>
                    </div>
                </div>
                <div class="employee-edit-actions">
                    <button type="submit"
                            class="employee-edit-save">
                        <i class="bi bi-check-circle"></i>
                        Lưu thay đổi
                    </button>
                    <a asp-controller="Employees"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="employee-edit-cancel">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
