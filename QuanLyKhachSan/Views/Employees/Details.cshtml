@model QuanLyKhachSan.Models.Employee
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết nhân viên";
    string displayName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Nhân viên"
        : Model.FullName;
    string avatarUrl = string.IsNullOrWhiteSpace(Model.Avatar)
        ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&size=220&background=c8a96a&color=111111"
        : Model.Avatar;
    string statusText = Model.Status ? "Đang làm việc" : "Ngừng hoạt động";
    string statusClass = Model.Status ? "success" : "secondary";
}
<style>
    .employee-details-page {
        max-width: 1120px;
        margin: 0 auto;
    }
    .employee-details-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }
    .employee-details-kicker {
        display: block;
        margin-bottom: 6px;
        color: #b58a42;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }
    .employee-details-heading h2 {
        margin: 0;
        color: #252a35;
        font-size: 30px;
        font-weight: 800;
    }
    .employee-details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }
    .employee-details-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }
        .employee-details-button.back {
            border: 1px solid #dfe2e8;
            background: #ffffff;
            color: #555c69;
        }
        .employee-details-button.edit {
            border: 1px solid #b58a42;
            background: linear-gradient(145deg,#d8b25e,#a8752d);
            color: #ffffff;
        }
    .employee-details-card {
        overflow: hidden;
        border: 1px solid #e7e9ee;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 22px 55px rgba(34,38,51,.08);
    }
    .employee-details-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 28px;
        background: radial-gradient(circle at 90% 10%, rgba(200,169,106,.25), transparent 28%), linear-gradient(135deg,#111111,#332717);
        color: #ffffff;
    }
    .employee-details-avatar {
        width: 94px;
        height: 94px;
        object-fit: cover;
        border: 4px solid rgba(255,255,255,.18);
        border-radius: 50%;
    }
    .employee-details-header h3 {
        margin: 0 0 5px;
        font-size: 27px;
        font-weight: 800;
    }
    .employee-details-header p {
        margin: 0 0 10px;
        color: rgba(255,255,255,.65);
    }
    .employee-details-body {
        padding: 30px;
    }
    .employee-summary-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    .employee-summary-item {
        padding: 20px;
        border: 1px solid #e8e9ee;
        border-radius: 16px;
        background: #fcfcfd;
    }
        .employee-summary-item span {
            display: block;
            margin-bottom: 7px;
            color: #8a909b;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .employee-summary-item strong {
            color: #282d38;
            font-size: 18px;
            font-weight: 800;
        }
    .employee-info-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 14px;
    }
    .employee-info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 17px 18px;
        border: 1px solid #eceef2;
        border-radius: 14px;
        background: #ffffff;
    }
        .employee-info-item i {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 38px;
            border-radius: 10px;
            background: #f4ead7;
            color: #8f692f;
        }
        .employee-info-item span {
            display: block;
            color: #8a909b;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .employee-info-item strong {
            display: block;
            color: #343944;
            font-size: 13px;
            word-break: break-word;
        }
    @@media (max-width: 991.98px) {
        .employee-summary-grid {
            grid-template-columns: 1fr;
        }
    }
    @@media (max-width: 767.98px) {
        .employee-details-heading {
            align-items: flex-start;
            flex-direction: column;
        }
        .employee-details-actions {
            width: 100%;
        }
        .employee-details-button {
            flex: 1;
        }
        .employee-details-header {
            align-items: flex-start;
            flex-direction: column;
        }
        .employee-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<div class="employee-details-page">
    <div class="employee-details-heading">
        <div>
            <span class="employee-details-kicker">Quản lý nhân viên</span>
            <h2>Chi tiết nhân viên</h2>
        </div>
        <div class="employee-details-actions">
            <a asp-controller="Employees"
               asp-action="Index"
               class="employee-details-button back">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
            <a asp-controller="Employees"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="employee-details-button edit">
                <i class="bi bi-pencil-square"></i>
                Chỉnh sửa
            </a>
        </div>
    </div>
    <div class="employee-details-card">
        <div class="employee-details-header">
            <img src="@avatarUrl"
                 class="employee-details-avatar"
                 alt="Ảnh nhân viên" />
            <div>
                <h3>@displayName</h3>
                <p>@(Model.Account?.Username ?? "Chưa có tài khoản")</p>
                <span class="badge bg-@statusClass">@statusText</span>
            </div>
        </div>
        <div class="employee-details-body">
            <div class="employee-summary-grid">
                <div class="employee-summary-item">
                    <span>Chức vụ</span>
                    <strong>@(Model.Position ?? "Chưa cập nhật")</strong>
                </div>
                <div class="employee-summary-item">
                    <span>Lương</span>
                    <strong>@Model.Salary.ToString("N0") VNĐ</strong>
                </div>
                <div class="employee-summary-item">
                    <span>Ngày vào làm</span>
                    <strong>@Model.HireDate.ToString("dd/MM/yyyy")</strong>
                </div>
            </div>
            <div class="employee-info-grid">
                <div class="employee-info-item">
                    <i class="bi bi-person-badge"></i>
                    <div>
                        <span>Tài khoản</span>
                        <strong>@(Model.Account?.Username ?? "Chưa liên kết")</strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <span>Vai trò</span>
                        <strong>@(Model.Account?.Role.ToString() ?? "Chưa xác định")</strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-gender-ambiguous"></i>
                    <div>
                        <span>Giới tính</span>
                        <strong>@(Model.Gender ?? "Chưa cập nhật")</strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-calendar3"></i>
                    <div>
                        <span>Ngày sinh</span>
                        <strong>
                            @(Model.DateOfBirth.HasValue
                                                        ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy")
                                                        : "Chưa cập nhật")
                        </strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-telephone"></i>
                    <div>
                        <span>Số điện thoại</span>
                        <strong>@(Model.Phone ?? "Chưa cập nhật")</strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-envelope"></i>
                    <div>
                        <span>Email</span>
                        <strong>@(Model.Email ?? "Chưa cập nhật")</strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <span>Địa chỉ</span>
                        <strong>@(Model.Address ?? "Chưa cập nhật")</strong>
                    </div>
                </div>
                <div class="employee-info-item">
                    <i class="bi bi-clock-history"></i>
                    <div>
                        <span>Cập nhật gần nhất</span>
                        <strong>
                            @(Model.UpdatedAt.HasValue
                                                        ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                        : "Chưa cập nhật")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
