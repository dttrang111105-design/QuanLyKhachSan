@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const searchInput =
                    document.getElementById(
                        "employeeSearch"
                    );

                const positionFilter =
                    document.getElementById(
                        "employeePositionFilter"
                    );

                const statusFilter =
                    document.getElementById(
                        "employeeStatusFilter"
                    );

                const rows =
                    document.querySelectorAll(
                        ".employee-row"
                    );

                const emptyState =
                    document.getElementById(
                        "employeeFilterEmpty"
                    );

                function filterEmployees() {

                    const keyword =
                        searchInput?.value
                            .trim()
                            .toLowerCase()
                        ?? "";

                    const position =
                        positionFilter?.value
                        ?? "";

                    const status =
                        statusFilter?.value
                        ?? "";

                    let visibleCount = 0;

                    rows.forEach(function (row) {

                        const rowSearch =
                            row.dataset.search
                            ?? "";

                        const rowPosition =
                            row.dataset.position
                            ?? "";

                        const rowStatus =
                            row.dataset.status
                            ?? "";

                        const keywordMatched =
                            !keyword ||
                            rowSearch.includes(keyword);

                        const positionMatched =
                            !position ||
                            rowPosition === position;

                        const statusMatched =
                            !status ||
                            rowStatus === status;

                        const visible =
                            keywordMatched &&
                            positionMatched &&
                            statusMatched;

                        row.classList.toggle(
                            "d-none",
                            !visible
                        );

                        if (visible) {
                            visibleCount++;
                        }

                    });

                    if (emptyState) {
                        emptyState.classList.toggle(
                            "d-none",
                            visibleCount > 0
                        );
                    }
                }

                searchInput?.addEventListener(
                    "input",
                    filterEmployees
                );

                positionFilter?.addEventListener(
                    "change",
                    filterEmployees
                );

                statusFilter?.addEventListener(
                    "change",
                    filterEmployees
                );

            }
        );
    </script>
}