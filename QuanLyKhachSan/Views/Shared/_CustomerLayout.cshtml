@{
    string currentPath = Context.Request.Path.Value?
        .TrimEnd('/')
        .ToLowerInvariant() ?? string.Empty;

    bool isHome = string.IsNullOrWhiteSpace(currentPath)
        || currentPath == "/"
        || currentPath == "/home"
        || currentPath == "/home/index";

    bool isAuthPage = currentPath == "/auth/login"
        || currentPath == "/auth/register";

    string homeUrl = Url.Action("Index", "Home") ?? "/";
    string displayName = User.Identity?.Name ?? "Tài khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="Luxury Hotel & Resort - Đặt phòng và dịch vụ khách sạn trực tuyến." />

    <title>@ViewData["Title"] - Luxury Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @if (isHome)
    {
        <link rel="stylesheet"
              href="~/css/home.css"
              asp-append-version="true" />
    }

    @if (isAuthPage)
    {
        <link rel="stylesheet"
              href="~/css/auth.css"
              asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(isHome ? "public-home-page" : isAuthPage ? "public-auth-page" : "public-inner-page")">

    <header class="public-header">
        <nav id="mainNavbar"
             class="navbar navbar-expand-lg fixed-top public-navbar @(isHome ? "public-navbar-home navbar-home" : "public-navbar-solid")">

            <div class="container">

                <a class="navbar-brand public-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="public-brand-icon">
                        <i class="bi bi-building-fill"></i>
                    </span>

                    <span class="public-brand-text">
                        <strong>LUXURY</strong>
                        <small>HOTEL &amp; RESORT</small>
                    </span>
                </a>

                <button class="navbar-toggler public-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainMenu"
                        aria-controls="mainMenu"
                        aria-expanded="false"
                        aria-label="Mở menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainMenu">

                    <ul class="navbar-nav mx-auto public-nav-list">

                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Rooms"
                               asp-action="Search">
                                Tìm phòng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@(homeUrl + "#rooms")">
                                Danh sách phòng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@(homeUrl + "#services")">
                                Dịch vụ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@(homeUrl + "#promotion")">
                                Khuyến mãi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="tel:0123456789">
                                Liên hệ
                            </a>
                        </li>

                    </ul>

                    <div class="public-navbar-actions">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown public-account-dropdown">

                                <button class="btn public-account-button dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="public-account-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </span>

                                    <span class="public-account-copy">
                                        <small>Xin chào</small>
                                        <strong>@displayName</strong>
                                    </span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end public-account-menu">

                                    <li>
                                        <div class="public-account-menu-header">

                                            <span class="public-account-menu-avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </span>

                                            <div>
                                                <strong>@displayName</strong>
                                                <small>@User.Identity.Name</small>
                                            </div>

                                        </div>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Bookings"
                                           asp-action="MyBookings">

                                            <i class="bi bi-calendar-check"></i>
                                            Booking của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Invoices"
                                           asp-action="MyInvoices">

                                            <i class="bi bi-receipt"></i>
                                            Hóa đơn của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Reviews"
                                           asp-action="Index">

                                            <i class="bi bi-star"></i>
                                            Đánh giá của tôi
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Services"
                                           asp-action="CustomerServices">

                                            <i class="bi bi-bag-check"></i>
                                            Đặt dịch vụ
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Profile"
                                           asp-action="Index">

                                            <i class="bi bi-person-vcard"></i>
                                            Trang cá nhân
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item public-logout-item"
                                           asp-controller="Auth"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="btn public-login-button">

                                <i class="bi bi-person"></i>
                                Đăng nhập
                            </a>

                            <a asp-controller="Auth"
                               asp-action="Register"
                               class="btn public-register-button">
                                Đăng ký
                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>
    </header>

    <main class="@(isHome ? "public-home-main" : isAuthPage ? "public-auth-main" : "public-inner-main")">
        @RenderBody()
    </main>

    <button type="button"
            class="scroll-top"
            aria-label="Cuộn lên đầu trang">

        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>