                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : string.Empty)"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@(homeUrl + "#rooms")">
                                Phòng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@(homeUrl + "#services")">
                                Dịch vụ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@(homeUrl + "#promotion")">
                                Khuyến mãi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="tel:0123456789">
                                Liên hệ
                            </a>
                        </li>
                    </ul>

                    <div class="public-navbar-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown public-account-dropdown">
                                <button class="btn public-account-button dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <span class="public-account-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </span>

                                    <span class="public-account-copy">
                                        <small>Xin chào</small>
                                        <strong>@displayName</strong>
                                    </span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end public-account-menu">
                                    <li>
                                        <div class="public-account-menu-header">
                                            <span class="public-account-menu-avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </span>
                                            <div>
                                                <strong>@displayName</strong>
                                                <small>@User.Identity.Name</small>
                                            </div>
                                        </div>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    @if (User.IsInRole("Customer"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Bookings"
                                               asp-action="MyBookings">
                                                <i class="bi bi-calendar-check"></i>
                                                Booking của tôi
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Invoices"
                                               asp-action="MyInvoices">

                                                <i class="bi bi-receipt"></i>
                                                <span>Hóa đơn của tôi</span>

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Reviews"
                                               asp-action="Index">

                                                <i class="bi bi-star"></i>
                                                Đánh giá của tôi

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Services"
                                               asp-action="CustomerServices">
                                                <i class="bi bi-bag-check"></i>
                                                Đặt dịch vụ
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Profile"
                                           asp-action="Index">
                                            <i class="bi bi-person-vcard"></i>
                                            Trang cá nhân
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item public-logout-item"
                                           asp-controller="Auth"
                                           asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="btn public-login-button">
                                <i class="bi bi-person"></i>
                                Đăng nhập
                            </a>

                            <a asp-controller="Auth"
                               asp-action="Register"
                               class="btn public-register-button">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="@(isHome ? "public-home-main" : "public-inner-main")">
        @RenderBody()
    </main>

   
      

