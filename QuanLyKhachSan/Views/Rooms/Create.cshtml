@model QuanLyKhachSan.Models.Room
@using QuanLyKhachSan.Enums
@{
    ViewData["Title"] = "Thêm phòng mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <style>
        .room-form-page {
            max-width: 1100px;
            margin: 0 auto;
        }
        .room-form-card {
            background: #ffffff;
            border: 1px solid #dcebf3;
            border-radius: 18px;
            box-shadow: 0 12px 35px rgba(30, 91, 122, 0.10);
            overflow: hidden;
        }
        .room-form-header {
            padding: 24px 28px;
            background: linear-gradient(135deg, #eaf7fc, #f8fcfe);
            border-bottom: 1px solid #dcebf3;
        }
            .room-form-header h2 {
                margin: 0 0 6px;
                color: #123f56;
                font-size: 26px;
                font-weight: 700;
            }
            .room-form-header p {
                margin: 0;
                color: #668494;
            }
        .room-form-body {
            padding: 28px;
        }
        .room-form-label {
            color: #244f64;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .room-form-control,
        .room-form-select {
            min-height: 46px;
            border: 1px solid #cfe0e9;
            border-radius: 10px;
        }
            .room-form-control:focus,
            .room-form-select:focus {
                border-color: #2c86aa;
                box-shadow: 0 0 0 0.2rem rgba(44, 134, 170, 0.15);
            }
        textarea.room-form-control {
            min-height: 130px;
            resize: vertical;
        }
        .room-form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding-top: 10px;
        }
        .btn-room-back,
        .btn-room-save {
            min-width: 135px;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 600;
        }
        .btn-room-back {
            color: #31566a;
            background: #eef5f8;
            border: 1px solid #d2e2e9;
        }
        .btn-room-save {
            color: #ffffff;
            background: #19779c;
            border: 1px solid #19779c;
        }
            .btn-room-save:hover {
                color: #ffffff;
                background: #145f7d;
                border-color: #145f7d;
            }
    </style>
}
<div class="room-form-page">
    <div class="room-form-card">
        <div class="room-form-header">
            <h2><i class="bi bi-door-open me-2"></i>Thêm phòng mới</h2>
            <p>Nhập đầy đủ thông tin để tạo phòng mới trong hệ thống.</p>
        </div>
        <div class="room-form-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="RoomNumber" class="form-label room-form-label">Số phòng</label>
                        <input asp-for="RoomNumber" class="form-control room-form-control" placeholder="Ví dụ: 101" />
                        <span asp-validation-for="RoomNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RoomTypeId" class="form-label room-form-label">Loại phòng</label>
                        <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypeId" class="form-select room-form-select">
                            <option value="">-- Chọn loại phòng --</option>
                        </select>
                        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Floor" class="form-label room-form-label">Tầng</label>
                        <input asp-for="Floor" type="number" min="1" class="form-control room-form-control" />
                        <span asp-validation-for="Floor" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RoomSize" class="form-label room-form-label">Diện tích (m²)</label>
                        <input asp-for="RoomSize" type="number" min="1" step="0.01" class="form-control room-form-control" />
                        <span asp-validation-for="RoomSize" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MaxOccupancy" class="form-label room-form-label">Sức chứa</label>
                        <input asp-for="MaxOccupancy" type="number" min="1" class="form-control room-form-control" />
                        <span asp-validation-for="MaxOccupancy" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PriceDay" class="form-label room-form-label">Giá/ngày</label>
                        <input asp-for="PriceDay" type="number" min="0" step="1000" class="form-control room-form-control" />
                        <span asp-validation-for="PriceDay" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PriceWeek" class="form-label room-form-label">Giá/tuần</label>
                        <input asp-for="PriceWeek" type="number" min="0" step="1000" class="form-control room-form-control" />
                        <span asp-validation-for="PriceWeek" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label room-form-label">Trạng thái</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="form-select room-form-select"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label room-form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control room-form-control" placeholder="Nhập mô tả phòng..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="room-form-actions">
                    <a asp-action="Index" class="btn btn-room-back">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-room-save">
                        <i class="bi bi-check-circle me-1"></i>Lưu phòng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
