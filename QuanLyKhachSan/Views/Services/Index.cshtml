                }
        }
    </style>
}
@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const searchInput =
                    document.getElementById(
                        "serviceSearch"
                    );
                const categoryFilter =
                    document.getElementById(
                        "serviceCategoryFilter"
                    );
                const statusFilter =
                    document.getElementById(
                        "serviceStatusFilter"
                    );
                const rows =
                    document.querySelectorAll(
                        ".service-row"
                    );
                const emptyState =
                    document.getElementById(
                        "serviceFilterEmpty"
                    );
                function filterServices() {
                    const keyword =
                        searchInput?.value
                            .trim()
                            .toLowerCase()
                        ?? "";
                    const category =
                        categoryFilter?.value
                        ?? "";
                    const status =
                        statusFilter?.value
                        ?? "";
                    let visibleCount = 0;
                    rows.forEach(function (row) {
                        const rowSearch =
                            row.dataset.search
                            ?? "";
                        const rowCategory =
                            row.dataset.category
                            ?? "";
                        const rowStatus =
                            row.dataset.status
                            ?? "";
                        const keywordMatched =
                            !keyword ||
                            rowSearch.includes(keyword);
                        const categoryMatched =
                            !category ||
                            rowCategory === category;
                        const statusMatched =
                            !status ||
                            rowStatus === status;
                        const visible =
                            keywordMatched &&
                            categoryMatched &&
                            statusMatched;
                        row.classList.toggle(
                            "d-none",
                            !visible
                        );
                        if (visible) {
                            visibleCount++;
                        }
                    });
                    if (emptyState) {
                        emptyState.classList.toggle(
                            "d-none",
                            visibleCount > 0
                        );
                    }
                }
                searchInput?.addEventListener(
                    "input",
                    filterServices
                );
                categoryFilter?.addEventListener(
                    "change",
                    filterServices
                );
                statusFilter?.addEventListener(
                    "change",
                    filterServices
                );
            }
        );
    </script>
}