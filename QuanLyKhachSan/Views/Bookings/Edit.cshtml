@using QuanLyKhachSan.Enums
@model QuanLyKhachSan.Models.Booking

@{
    ViewData["Title"] = "Cập nhật Booking";
}

<h2 class="mb-4">Cập nhật Booking</h2>

<div class="row">

    <div class="col-md-6">

        <form asp-action="Edit">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Mã Booking
                </label>

                <input class="form-control"
                       value="@Model.BookingCode"
                       readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Ngày đặt
                </label>

                <input class="form-control"
                       value="@Model.BookingDate.ToString("dd/MM/yyyy HH:mm")"
                       readonly />
            </div>

            <div class="mb-3">

                <label asp-for="CheckInDate"
                       class="form-label">
                </label>

                <input asp-for="CheckInDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="CheckInDate"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="CheckOutDate"
                       class="form-label">
                </label>

                <input asp-for="CheckOutDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="CheckOutDate"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Adult"
                       class="form-label">
                </label>

                <input asp-for="Adult"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Children"
                       class="form-label">
                </label>

                <input asp-for="Children"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Deposit"
                       class="form-label">
                </label>

                <input asp-for="Deposit"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Status"
                       class="form-label">
                </label>

                <select asp-for="Status"
                        class="form-select">

                    <option value="@BookingStatus.Pending">
                        Chờ xác nhận
                    </option>

                    <option value="@BookingStatus.Confirmed">
                        Đã xác nhận
                    </option>

                    <option value="@BookingStatus.CheckedIn">
                        Đang ở
                    </option>

                    <option value="@BookingStatus.CheckedOut">
                        Đã trả phòng
                    </option>

                    <option value="@BookingStatus.Cancelled">
                        Đã hủy
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="Note"
                       class="form-label">
                </label>

                <textarea asp-for="Note"
                          rows="4"
                          class="form-control">
                </textarea>

            </div>

            <button class="btn btn-primary" type="submit">

                Lưu

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Quay lại

            </a>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}