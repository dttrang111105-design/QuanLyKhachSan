@model IEnumerable<QuanLyKhachSan.Models.Booking>
@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models
@{
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
    bool isCustomer = User.IsInRole("Customer");
    if (isAdmin)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
        ViewData["Title"] = "Quản lý Booking";
    }
    else if (isReceptionist)
    {
        Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
        ViewData["Title"] = "Danh sách Booking";
    }
    else if (isCustomer)
    {
        Layout = "~/Views/Shared/_CustomerLayout.cshtml";
        ViewData["Title"] = "Booking của tôi";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
        ViewData["Title"] = "Danh sách Booking";
    }
    List<Booking> bookings = Model?.ToList() ?? new List<Booking>();
    var reviewByRoom = ViewBag.ReviewByRoom
            as IDictionary<int, int> ?? new Dictionary<int, int>();
    int pendingCount = bookings.Count(x => x.Status == BookingStatus.Pending);
    int confirmedCount = bookings.Count(x => x.Status == BookingStatus.Confirmed);
    int checkedInCount = bookings.Count(x => x.Status == BookingStatus.CheckedIn);
    int checkedOutCount = bookings.Count(x => x.Status == BookingStatus.CheckedOut);
    int cancelledCount = bookings.Count(x => x.Status == BookingStatus.Cancelled);
    decimal totalBookingAmount = bookings
            .Where(x => x.Status != BookingStatus.Cancelled)
            .Sum(x => x.TotalAmount);
    string StatusText(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "Chờ xác nhận",
            BookingStatus.Confirmed => "Đã xác nhận",
            BookingStatus.CheckedIn => "Đang lưu trú",
            BookingStatus.CheckedOut => "Đã trả phòng",
            BookingStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }
    string StatusClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "booking-status-pending",
            BookingStatus.Confirmed => "booking-status-confirmed",
            BookingStatus.CheckedIn => "booking-status-checkedin",
            BookingStatus.CheckedOut =>  "booking-status-checkedout",
            BookingStatus.Cancelled => "booking-status-cancelled", 
            _ => "booking-status-default"
        };
    }
    string RoomNumbers(Booking booking)
    {
        if (booking.BookingDetails == null)
        {
            return "Chưa xếp phòng";
        }
        List<string> roomNumbers = booking.BookingDetails
                .Where(x => !x.IsDeleted && x.Room != null)
                .Select(x => x.Room!.RoomNumber)
                .Distinct()
                .ToList();
        return roomNumbers.Any() ? string.Join(", ", roomNumbers) : "Chưa xếp phòng";
    }
    string CustomerInitial(string? fullName)
    {
        return string.IsNullOrWhiteSpace(fullName) ? "K" : fullName.Trim()
                .Substring(0, 1)
                .ToUpper();
    }
}
<style>
    .booking-page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
    }
