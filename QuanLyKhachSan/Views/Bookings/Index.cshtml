            margin: 5px 0 7px;
            font-weight: 700;
        }
        .booking-page-heading p {
            margin: 0;
            color: #818694;
        }
    .booking-page-kicker {
        color: #b58a42;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }
    .booking-heading-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }
    .booking-heading-button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 16px;
        border: 1px solid #e1e3e9;
        border-radius: 11px;
        background: #ffffff;
        color: #555c69;
        font-size: 13px;
        font-weight: 700;
    }
        .booking-heading-button:hover {
            border-color: #b58a42;
            color: #8f692f;
        }
        .booking-heading-button.primary {
            border-color: #b58a42;
            background: #b58a42;
            color: #ffffff;
        }
            .booking-heading-button.primary:hover {
                background: #936c2d;
                color: #ffffff;
            }
    .booking-stat-card {
        height: 100%;
        padding: 20px;
        border: 1px solid #e8e9ee;
        border-radius: 17px;
        background: #ffffff;
        box-shadow: 0 16px 40px rgba(34, 38, 51, 0.065);
