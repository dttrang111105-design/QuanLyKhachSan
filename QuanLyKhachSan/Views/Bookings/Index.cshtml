            background: #eaf0ff;
            color: #4f6fd8;
        }
        .booking-stat-icon.orange {
            background: #fff1d9;
            color: #b87610;
        }
        .booking-stat-icon.green {
            background: #e4f7ef;
            color: #27875e;
        }
        .booking-stat-icon.purple {
            background: #f0ebff;
            color: #8567d4;
        }
    .booking-stat-label {
        padding: 5px 9px;
        border-radius: 20px;
        background: #f3f4f7;
        color: #838897;
        font-size: 10px;
        font-weight: 700;
    }
    .booking-stat-title {
        display: block;
        color: #838897;
        font-size: 12px;
        font-weight: 600;
    }
    .booking-stat-value {
        display: block;
        margin: 4px 0 8px;
        color: #252a35;
        font-size: 31px;
        font-weight: 800;
    }
        .booking-stat-value.money {
            font-size: 23px;
        }
        .booking-stat-value small {
            color: #8c919d;
            font-size: 9px;
        }
    .booking-stat-card > small {
        color: #9297a3;
        font-size: 10px;
    }
    .booking-panel {
        overflow: hidden;
        border: 1px solid #e8e9ee;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(34, 38, 51, 0.07);
    }
    .booking-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 21px 22px;
        border-bottom: 1px solid #e8e9ee;
    }
        .booking-panel-header h3 {
            margin: 3px 0;
            font-size: 20px;
            font-weight: 700;
        }
        .booking-panel-header p {
            margin: 0;
            color: #858a97;
            font-size: 11px;
        }
    .booking-filter-area {
        display: flex;
        align-items: center;
        gap: 9px;
    }
    .booking-search {
        position: relative;
    }
        .booking-search i {
            position: absolute;
            top: 50%;
            left: 13px;
            color: #999eaa;
            transform: translateY(-50%);
        }
        .booking-search input {
            width: 270px;
            min-height: 42px;
            padding: 9px 13px 9px 38px;
            border: 1px solid #e1e3e9;
            border-radius: 11px;
            outline: none;
            font-size: 12px;
        }
    .booking-filter-area .form-select {
        width: 180px;
        min-height: 42px;
        border-color: #e1e3e9;
        border-radius: 11px;
        font-size: 12px;
    }
        .booking-search input:focus,
        .booking-filter-area .form-select:focus {
            border-color: #b58a42;
            box-shadow: 0 0 0 3px rgba(181, 138, 66, 0.12);
        }
    .booking-table thead th {
        padding: 14px 12px;
        border-bottom: 1px solid #e8e9ee;
        background: #fafafb;
        color: #818795;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .booking-table tbody td {
        padding: 15px 12px;
        border-bottom: 1px solid #eff0f3;
        color: #555b68;
        font-size: 11px;
        vertical-align: middle;
    }
    .booking-table tbody tr:hover {
        background: #fcfbf9;
    }
    .booking-code-cell,
    .booking-customer-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .booking-code-icon,
    .booking-customer-avatar {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-weight: 800;
    }
    .booking-code-icon {
        background: #f4ead7;
        color: #8f692f;
    }
    .booking-customer-avatar {
        background: #eaf0ff;
        color: #4f6fd8;
    }
    .booking-code-cell div,
    .booking-customer-cell div,
    .booking-date-cell {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }
        .booking-code-cell strong,
        .booking-customer-cell strong,
        .booking-date-cell strong {
            color: #343944;
            font-size: 11px;
        }
        .booking-code-cell small,
        .booking-customer-cell small,
        .booking-date-cell small {
            color: #9297a3;
            font-size: 9px;
        }
    .booking-customer-cell strong,
    .booking-customer-cell small {
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .booking-room-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 9px;
        background: #f3f4f7;
        color: #555c69;
        font-weight: 700;
        white-space: nowrap;
    }
    .booking-money {
        color: #343944;
        font-weight: 700;
        white-space: nowrap;
    }
        .booking-money.total {
            color: #c44f59;
        }
        .booking-money small {
            color: #969ba7;
            font-size: 8px;
        }
    .booking-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }
    .booking-status-pending {
        background: #fff1d9;
        color: #b87610;
    }
    .booking-status-confirmed {
        background: #eaf0ff;
        color: #4f6fd8;
    }
    .booking-status-checkedin {
        background: #e3f6ec;
        color: #258459;
    }
    .booking-status-checkedout {
        background: #eceef2;
        color: #616876;
    }
    .booking-status-cancelled {
        background: #fde7e9;
        color: #c34c55;
    }
    .booking-action-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 5px;
    }
    .booking-action {
        min-height: 33px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 10px;
        border: 1px solid #e1e3e8;
        border-radius: 9px;
        background: #ffffff;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
        transition: 0.2s ease;
    }
        .booking-action:hover {
            transform: translateY(-2px);
        }
        .booking-action.view {
            color: #4f6fd8;
        }
        .booking-action.edit {
            color: #b58025;
        }
        .booking-action.checkin {
            color: #27875e;
        }
        .booking-action.checkout {
            color: #5f6673;
        }
        .booking-action.cancel,
        .booking-action.delete {
            color: #cf535d;
        }
        .booking-action.review {
            color: #9a722d;
        }
        .booking-action.view:hover {
            border-color: #4f6fd8;
            background: #eaf0ff;
        }
        .booking-action.edit:hover,
        .booking-action.review:hover {
            border-color: #d49a36;
            background: #fff3df;
        }
        .booking-action.checkin:hover {
            border-color: #27875e;
            background: #e4f7ef;
        }
        .booking-action.checkout:hover {
            border-color: #747b88;
            background: #eceef2;
        }
        .booking-action.cancel:hover,
        .booking-action.delete:hover {
            border-color: #cf535d;
            background: #fde9eb;
        }
    .booking-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 70px 20px;
        color: #858b98;
        text-align: center;
    }
        .booking-empty-state i {
            margin-bottom: 12px;
            color: #c1c5ce;
            font-size: 48px;
        }
        .booking-empty-state h4 {
            color: #454b57;
        }
    @@media (max-width: 1199.98px) {
        .booking-panel-header {
            align-items: flex-start;
            flex-direction: column;
        }
        .booking-filter-area {
            width: 100%;
        }
        .booking-search {
            flex: 1;
        }
            .booking-search input {
                width: 100%;
            }
    }
    @@media (max-width: 767.98px) {
        .booking-page-heading {
            align-items: flex-start;
            flex-direction: column;
        }
        .booking-heading-actions {
            width: 100%;
        }
        .booking-heading-button {
            flex: 1;
        }
        .booking-filter-area {
            align-items: stretch;
            flex-direction: column;
        }
            .booking-filter-area .form-select {
                width: 100%;
            }
    }
</style>
<!-- TIÊU ĐỀ -->
<section class="booking-page-heading">
    <div>
        <span class="booking-page-kicker">
            @(isCustomer ? "Quản lý chuyến đi" : "Vận hành khách sạn")
        </span>
        <h2>
            @(isCustomer ? "Booking của tôi" : "Quản lý Booking")
        </h2>
        <p>
            @if (isCustomer)
            {
                <text>
                    Theo dõi trạng thái, thông tin phòng,
                    thanh toán và đánh giá sau khi lưu trú.
                </text>
            }
            else
            {
                <text>
                    Theo dõi, xác nhận, nhận phòng và trả phòng
                    cho các Booking trong hệ thống.
                </text>
            }
        </p>
    </div>
    <div class="booking-heading-actions">
        @if (isCustomer)
        {
            <a asp-controller="Rooms" asp-action="Search" class="booking-heading-button primary">
                <i class="bi bi-search"></i>
                Tìm phòng
            </a>
        }
        else
        {
            <a asp-controller="Rooms" asp-action="Index" class="booking-heading-button">
                <i class="bi bi-door-open"></i>
                Tình trạng phòng
            </a>
            <a asp-controller="Home" asp-action="Dashboard" class="booking-heading-button primary">
                <i class="bi bi-grid-1x2"></i>
                Tổng quan
            </a>
        }
    </div>
</section>
<!-- THÔNG BÁO -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng">
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng">
        </button>
    </div>
}
<!-- THỐNG KÊ -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="booking-stat-card">
            <div class="booking-stat-top">
                <span class="booking-stat-icon blue">
                    <i class="bi bi-calendar2-check"></i>
                </span>
                <span class="booking-stat-label">
                    Tất cả
                </span>
            </div>
            <span class="booking-stat-title">
                Tổng Booking
            </span>
            <strong class="booking-stat-value">
                @bookings.Count
            </strong>
            <small>
                Booking trong danh sách
            </small>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="booking-stat-card">
            <div class="booking-stat-top">
                <span class="booking-stat-icon orange">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <span class="booking-stat-label">
                    Cần xử lý
                </span>
            </div>
            <span class="booking-stat-title">
                Chờ xác nhận
            </span>
            <strong class="booking-stat-value">
                @pendingCount
            </strong>
            <small>
                @confirmedCount Booking đã xác nhận
            </small>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="booking-stat-card">
            <div class="booking-stat-top">
                <span class="booking-stat-icon green">
                    <i class="bi bi-building-check"></i>
                </span>
                <span class="booking-stat-label">
                    Hiện tại
                </span>
            </div>
            <span class="booking-stat-title">
                Đang lưu trú
            </span>
            <strong class="booking-stat-value">
                @checkedInCount
            </strong>
            <small>
                @checkedOutCount Booking đã trả phòng
            </small>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="booking-stat-card">
            <div class="booking-stat-top">
                <span class="booking-stat-icon purple">
                    <i class="bi bi-cash-stack"></i>
                </span>
                <span class="booking-stat-label">
                    Giá trị
                </span>
            </div>
            <span class="booking-stat-title">
                Tổng tiền Booking
            </span>
            <strong class="booking-stat-value money">
                @totalBookingAmount.ToString("N0")
                <small>VNĐ</small>
            </strong>
            <small>
                Không tính @cancelledCount Booking đã hủy
            </small>
        </div>
    </div>
</div>
<!-- DANH SÁCH BOOKING -->
<div class="booking-panel">
    <div class="booking-panel-header">
        <div>
            <span class="booking-page-kicker">
                Danh sách dữ liệu
            </span>
            <h3>
                @(isCustomer ? "Lịch sử Booking" : "Booking khách sạn")
            </h3>
            <p>
                Có @bookings.Count Booking được hiển thị.
            </p>
        </div>
        <div class="booking-filter-area">
            <div class="booking-search">
                <i class="bi bi-search"></i>
                <input type="text" id="bookingSearch" placeholder="Tìm mã Booking, phòng, khách hàng..." />
            </div>
            <select id="bookingStatusFilter"
                    class="form-select">
                <option value="">
                    Tất cả trạng thái
                </option>
                <option value="Pending">
                    Chờ xác nhận
                </option>
                <option value="Confirmed">
                    Đã xác nhận
                </option>
                <option value="CheckedIn">
                    Đang lưu trú
                </option>
                <option value="CheckedOut">
                    Đã trả phòng
                </option>
                <option value="Cancelled">
                    Đã hủy
                </option>
            </select>
        </div>
    </div>
    @if (bookings.Any())
    {
        <div class="table-responsive">
            <table class="table booking-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">
                            Mã Booking
                        </th>
                        @if (!isCustomer)
                        {
                            <th>
                                Khách hàng
                            </th>
                        }
                        <th>
                            Phòng
                        </th>
                        <th>
                            Ngày đặt
                        </th>
                        <th>
                            Nhận phòng
                        </th>
                        <th>
                            Trả phòng
                        </th>
                        <th>
                            Tiền cọc
                        </th>
                        <th>
                            Tổng tiền
                        </th>
                        <th>
                            Trạng thái
                        </th>
                        <th class="text-end pe-4">
                            Thao tác
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Booking booking in bookings)
                    {
                        string rooms = RoomNumbers(booking);
                        string customerName = booking.Customer?.FullName ?? "Không xác định";
                        string customerPhone = booking.Customer?.Phone ?? "Chưa có số điện thoại";
                        string searchData = $"{booking.BookingCode} {rooms} {customerName}"
                                .ToLower();
                        <tr class="booking-row" data-status="@booking.Status" data-search="@searchData">
                            <!-- Mã Booking -->
                            <td class="ps-4">
                                <div class="booking-code-cell">
                                    <span class="booking-code-icon">
                                        <i class="bi bi-calendar2-check"></i>
                                    </span>
                                    <div>
                                        <strong>
                                            @booking.BookingCode
                                        </strong>
                                        <small>
                                            #@booking.Id
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <!-- Khách hàng -->
                            @if (!isCustomer)
                            {
                                <td>
                                    <div class="booking-customer-cell">
                                        <span class="booking-customer-avatar">
                                            @CustomerInitial(customerName)
                                        </span>
                                        <div>
                                            <strong>
                                                @customerName
                                            </strong>
                                            <small>
                                                @customerPhone
                                            </small>
                                        </div>
                                    </div>
                                </td>
                            }
                            <!-- Phòng -->
                            <td>
                                <span class="booking-room-badge">
                                    <i class="bi bi-door-open"></i>
                                    @rooms
                                </span>
                            </td>
                            <!-- Ngày đặt -->
                            <td>
                                <div class="booking-date-cell">
                                    <strong>
                                        @booking.BookingDate.ToString(
                                            "dd/MM/yyyy")
                                    </strong>
                                    <small>
                                        @booking.BookingDate.ToString(
                                            "HH:mm")
                                    </small>
                                </div>
                            </td>
                            <!-- Ngày nhận -->
                            <td>
                                <div class="booking-date-cell">
                                    <strong>
                                        @booking.CheckInDate.ToString(
                                            "dd/MM/yyyy")
                                    </strong>
                                    <small>
                                        Nhận phòng
                                    </small>
                                </div>
                            </td>
                            <!-- Ngày trả -->
                            <td>
                                <div class="booking-date-cell">
                                    <strong>
                                        @booking.CheckOutDate.ToString(
                                            "dd/MM/yyyy")
                                    </strong>
                                    <small>
                                        Trả phòng
                                    </small>
                                </div>
                            </td>
                            <!-- Tiền cọc -->
                            <td>
                                <span class="booking-money">
                                    @booking.Deposit.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Tổng tiền -->
                            <td>
                                <span class="booking-money total">
                                    @booking.TotalAmount.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Trạng thái -->
                            <td>
                                <span class="booking-status
                                    @StatusClass(booking.Status)">
                                    @switch (booking.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <i class="bi bi-hourglass-split"></i>
                                            break;
                                        case BookingStatus.Confirmed:
                                            <i class="bi bi-check-circle"></i>
                                            break;
                                        case BookingStatus.CheckedIn:
                                            <i class="bi bi-building-check"></i>
                                            break;
                                        case BookingStatus.CheckedOut:
                                            <i class="bi bi-box-arrow-right"></i>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <i class="bi bi-x-circle"></i>
                                            break;
                                    }
                                    @StatusText(booking.Status)
                                </span>
                            </td>
                            <!-- Thao tác -->
                            <td class="text-end pe-4">
                                <div class="booking-action-group">
                                    <a asp-controller="Bookings" asp-action="Details"
                                       asp-route-id="@booking.Id" class="booking-action view">
                                        <i class="bi bi-eye"></i>
                                        Chi tiết
                                    </a>
                                    @if (isCustomer && booking.Status == BookingStatus.Pending)
                                    {
                                        <a asp-controller="Bookings" asp-action="Cancel" asp-route-id="@booking.Id"
                                           class="booking-action cancel" onclick="return confirm(
                                            'Bạn có chắc muốn hủy Booking này?');">
                                            <i class="bi bi-x-circle"></i>
                                            Hủy
                                        </a>
                                    }
                                    @if (isCustomer &&
                                         booking.Status == BookingStatus.CheckedOut && booking.BookingDetails != null)
                                    {
                                        foreach (BookingDetail detail in booking.BookingDetails
                                                .Where(x => !x.IsDeleted && x.Room != null))
                                        {
                                            if (reviewByRoom.TryGetValue(detail.RoomId, out int reviewId))
                                            {
                                                <a asp-controller="Reviews" asp-action="Edit"
                                                   asp-route-id="@reviewId" class="booking-action review">
                                                    <i class="bi bi-pencil-square"></i>
                                                    Sửa đánh giá
                                                    @detail.Room!.RoomNumber
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Reviews" asp-action="Create" asp-route-bookingId="@booking.Id"
                                                   asp-route-roomId="@detail.RoomId" class="booking-action review">
                                                    <i class="bi bi-star"></i>
                                                    Đánh giá
                                                    @detail.Room!.RoomNumber
                                                </a>
                                            }
                                        }
                                    }
                                    @if (isAdmin || isReceptionist)
                                    {
                                        <a asp-controller="Bookings" asp-action="Edit"
                                           asp-route-id="@booking.Id" class="booking-action edit">
                                            <i class="bi bi-pencil-square"></i>
                                            Sửa
                                        </a>
                                        @if (booking.Status == BookingStatus.Pending ||
                                             booking.Status == BookingStatus.Confirmed)
                                        {
                                            <a asp-controller="Bookings" asp-action="CheckIn" asp-route-id="@booking.Id"
                                               class="booking-action checkin" onclick="return confirm(
                                                'Xác nhận Check In Booking này?');">
                                                <i class="bi bi-box-arrow-in-right"></i>
                                                Check In
                                            </a>
                                        }
                                        @if (booking.Status == BookingStatus.CheckedIn)
                                        {
                                            <a asp-controller="Bookings" asp-action="CheckOut" asp-route-id="@booking.Id"
                                               class="booking-action checkout" onclick="return confirm(
                                                'Xác nhận Check Out Booking này?');">
                                                <i class="bi bi-box-arrow-right"></i>
                                                Check Out
                                            </a>
                                        }
                                        @if (isAdmin)
                                        {
                                            <a asp-controller="Bookings" asp-action="Delete"
                                               asp-route-id="@booking.Id" class="booking-action delete">
                                                <i class="bi bi-trash"></i>
                                                Xóa
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="bookingFilterEmpty" class="booking-empty-state d-none">
            <i class="bi bi-search"></i>
            <h4>
                Không tìm thấy Booking
            </h4>
            <p>
                Hãy thử từ khóa hoặc trạng thái khác.
            </p>
        </div>
    }
    else
    {
        <div class="booking-empty-state">
            <i class="bi bi-calendar-x"></i>
            <h4>
                Chưa có Booking
            </h4>
            <p>
                @if (isCustomer)
                {
                    <text>
                        Bạn chưa thực hiện đặt phòng nào.
                    </text>
                }
                else
                {
                    <text>
                        Hệ thống chưa có Booking để hiển thị.
                    </text>
                }
            </p>
            @if (isCustomer)
            {
                <a asp-controller="Rooms" asp-action="Search" class="btn btn-warning">
                    <i class="bi bi-search me-1"></i>
                    Tìm phòng ngay
                </a>
            }
        </div>
    }
</div>
<script>
    document.addEventListener("DOMContentLoaded",
        function () {
            const searchInput = document.getElementById("bookingSearch");
            const statusFilter = document.getElementById("bookingStatusFilter");
            const rows = document.querySelectorAll(".booking-row");
            const emptyState = document.getElementById("bookingFilterEmpty");
            function filterBookings() {
                const keyword = searchInput?.value.trim().toLowerCase() ?? "";
                const status = statusFilter?.value ?? "";
                let visibleCount = 0;
                rows.forEach(function (row) {
                    const rowSearch = row.dataset.search ?? "";
                    const rowStatus = row.dataset.status ?? "";
                    const searchMatched = !keyword || rowSearch.includes(keyword);
                    const statusMatched = !status || rowStatus === status;
                    const visible = searchMatched && statusMatched;
                    row.classList.toggle( "d-none", !visible);
                    if (visible) {
                        visibleCount++;
                    }
                });
                if (emptyState) {
                    emptyState.classList.toggle("d-none", visibleCount > 0);
                }
            }
            searchInput?.addEventListener("input", filterBookings);
            statusFilter?.addEventListener("change", filterBookings);
        }
    );
</script>