@using System.Globalization
@model QuanLyKhachSan.ViewModels.RoomInspectionViewModel
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Kiểm tra phòng Checkout";
}
<style>
    .inspection-page {
        max-width: 1180px;
        margin: 0 auto;
    }
    .inspection-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
    }
    .inspection-kicker {
        display: block;
        margin-bottom: 6px;
        color: #b58a42;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.6px;
        text-transform: uppercase;
    }
    .inspection-heading h2 {
        margin: 0;
        color: #252a35;
        font-size: 30px;
        font-weight: 800;
    }
    .inspection-heading p {
        margin: 7px 0 0;
        color: #737986;
        font-size: 14px;
    }
    .inspection-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 42px;
        padding: 9px 15px;
        border: 1px solid #dfe2e8;
        border-radius: 10px;
        background: #fff;
        color: #555c69;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }
    .inspection-info {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 12px;
        margin-bottom: 22px;
    }
    .inspection-info-item {
        padding: 15px 17px;
        border: 1px solid #e7e9ee;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 10px 28px rgba(34,38,51,.04);
    }
    .inspection-info-item span {
        display: block;
        margin-bottom: 5px;
        color: #8a909b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
    }
    .inspection-info-item strong {
        color: #313641;
        font-size: 14px;
    }
    .inspection-card {
        overflow: hidden;
        margin-bottom: 22px;
        border: 1px solid #e7e9ee;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 18px 45px rgba(34,38,51,.06);
    }
    .inspection-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 22px;
        background: linear-gradient(135deg,#151515,#3a2c19);
        color: #fff;
    }
    .inspection-card-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
    }
    .inspection-card-header span {
        color: rgba(255,255,255,.65);
        font-size: 12px;
    }
    .inspection-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 18px 22px 10px;
        color: #343943;
        font-size: 15px;
        font-weight: 800;
    }
    .inspection-table {
        margin: 0;
    }
    .inspection-table thead th {
        padding: 11px 15px;
        border-bottom: 1px solid #eceef2;
        background: #f8f9fb;
        color: #686e79;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .4px;
        text-transform: uppercase;
    }
    .inspection-table tbody td {
        padding: 13px 15px;
        vertical-align: middle;
        border-color: #eef0f3;
        color: #414752;
        font-size: 13px;
    }
    .inspection-name {
        font-weight: 800;
        color: #2e333d;
    }
    .inspection-price {
        white-space: nowrap;
        color: #676d78;
        font-weight: 700;
    }
    .inspection-quantity {
        width: 100px;
        min-height: 39px;
        border: 1px solid #dfe2e8;
        border-radius: 8px;
        text-align: center;
        box-shadow: none;
    }
    .inspection-status {
        min-width: 145px;
        min-height: 39px;
        border: 1px solid #dfe2e8;
        border-radius: 8px;
        box-shadow: none;
    }
    .inspection-amount {
        white-space: nowrap;
        color: #9a6c23;
        font-weight: 800;
    }
    .inspection-note {
        margin-bottom: 22px;
        padding: 20px 22px;
        border: 1px solid #e7e9ee;
        border-radius: 16px;
        background: #fff;
    }
    .inspection-note label {
        margin-bottom: 7px;
        color: #3c424d;
        font-size: 13px;
        font-weight: 800;
    }
    .inspection-note textarea {
        min-height: 95px;
        border: 1px solid #dfe2e8;
        border-radius: 10px;
        box-shadow: none;
        resize: vertical;
    }
    .inspection-summary {
        position: sticky;
        bottom: 16px;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 17px 20px;
        border: 1px solid #e3d3ae;
        border-radius: 15px;
        background: rgba(255,250,240,.97);
        box-shadow: 0 18px 45px rgba(38,31,20,.13);
        backdrop-filter: blur(10px);
    }
    .inspection-total span {
        display: block;
        color: #806834;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }
    .inspection-total strong {
        display: block;
        margin-top: 2px;
        color: #9a6820;
        font-size: 24px;
        font-weight: 900;
    }
    .inspection-actions {
        display: flex;
        gap: 10px;
    }
    .inspection-submit,
    .inspection-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 45px;
        padding: 9px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
    }
    .inspection-submit {
        border: 1px solid #b58a42;
        background: linear-gradient(145deg,#d8b25e,#a8752d);
        color: #fff;
    }
    .inspection-cancel {
        border: 1px solid #dfe2e8;
        background: #fff;
        color: #555c69;
    }
    .inspection-warning {
        margin-bottom: 20px;
        padding: 13px 16px;
        border: 1px solid #f0e2bd;
        border-radius: 11px;
        background: #fffaf0;
        color: #705929;
        font-size: 13px;
    }
    @@media (max-width: 991.98px) {
        .inspection-info {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
        .inspection-card {
            overflow-x: auto;
        }
        .inspection-table {
            min-width: 760px;
        }
    }
    @@media (max-width: 767.98px) {
        .inspection-heading,
        .inspection-summary {
            align-items: stretch;
            flex-direction: column;
        }
        .inspection-info {
            grid-template-columns: 1fr;
        }
        .inspection-actions {
            flex-direction: column-reverse;
        }
    }
</style>
<div class="inspection-page">
    <div class="inspection-heading">
        <div>
            <span class="inspection-kicker">Checkout</span>
            <h2>Kiểm tra phòng trước khi trả</h2>
            <p>Xác nhận minibar và tình trạng tài sản. Hệ thống sẽ lấy lại giá từ database khi lưu.</p>
        </div>
        <a asp-controller="Bookings"
           asp-action="Index"
           class="inspection-back">
            <i class="bi bi-arrow-left"></i>
            Quay lại Booking
        </a>
    </div>
    <div class="inspection-info">
        <div class="inspection-info-item">
            <span>Mã Booking</span>
            <strong>@Model.BookingCode</strong>
        </div>
        <div class="inspection-info-item">
            <span>Khách hàng</span>
            <strong>@Model.CustomerName</strong>
        </div>
        <div class="inspection-info-item">
            <span>Ngày nhận</span>
            <strong>@Model.CheckInDate.ToString("dd/MM/yyyy")</strong>
        </div>
        <div class="inspection-info-item">
            <span>Ngày trả</span>
            <strong>@Model.CheckOutDate.ToString("dd/MM/yyyy")</strong>
        </div>
    </div>
    <form asp-controller="Bookings"
          asp-action="ConfirmCheckOut"
          method="post"
          id="inspectionForm">
        @Html.AntiForgeryToken()
        <input asp-for="BookingId" type="hidden" />
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>
        @for (int roomIndex = 0; roomIndex < Model.Rooms.Count; roomIndex++)
        {
            <input asp-for="Rooms[roomIndex].RoomId" type="hidden" />
            <div class="inspection-card">
                <div class="inspection-card-header">
                    <h3>
                        <i class="bi bi-door-closed me-2"></i>
                        Phòng @Model.Rooms[roomIndex].RoomNumber
                    </h3>
                    <span>Kiểm tra đầy đủ trước khi xác nhận</span>
                </div>
                <div class="inspection-section-title">
                    <i class="bi bi-cup-straw"></i>
                    MiniBar đã sử dụng
                </div>
                <div class="table-responsive">
                    <table class="table inspection-table">
                        <thead>
                            <tr>
                                <th>Mặt hàng</th>
                                <th>Đơn giá</th>
                                <th class="text-center">Hiện có</th>
                                <th>Số lượng đã dùng</th>
                                <th class="text-end">Tạm tính</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var miniBarCount = Model.Rooms[roomIndex].Items
                                    .Count(item => item.Category == "MiniBar");
                            }

                            @if (miniBarCount == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Phòng này chưa được thiết lập minibar.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (int itemIndex = 0; itemIndex < Model.Rooms[roomIndex].Items.Count; itemIndex++)
                                {
                                    var item = Model.Rooms[roomIndex].Items[itemIndex];
                                    if (item.Category != "MiniBar")
                                    {
                                        continue;
                                    }

                                    <tr class="inspection-row minibar-row"
                                        data-used-price="@item.UsedPrice.ToString(CultureInfo.InvariantCulture)"
                                        data-available="@item.AvailableQuantity">
                                        <td>
                                            <input asp-for="Rooms[roomIndex].Items[itemIndex].RoomChargeItemId"
                                                   type="hidden" />
                                            <input asp-for="Rooms[roomIndex].Items[itemIndex].RoomMiniBarItemId"
                                                   type="hidden" />
                                            <input asp-for="Rooms[roomIndex].Items[itemIndex].ResultType"
                                                   type="hidden" />
                                            <span class="inspection-name">@item.Name</span>
                                        </td>
                                        <td class="inspection-price">
                                            @item.UsedPrice.ToString("N0") VNĐ
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">
                                                @item.AvailableQuantity
                                            </span>
                                        </td>
                                        <td>
                                            <input asp-for="Rooms[roomIndex].Items[itemIndex].Quantity"
                                                   type="number"
                                                   min="0"
                                                   max="@item.AvailableQuantity"
                                                   class="form-control inspection-quantity quantity-input minibar-quantity" />
                                            <div class="small text-muted mt-1">
                                                Tối đa @item.AvailableQuantity
                                            </div>
                                        </td>
                                        <td class="text-end inspection-amount">0 VNĐ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="inspection-section-title border-top">
                    <i class="bi bi-house-gear"></i>
                    Tình trạng tài sản
                </div>
                <div class="table-responsive">
                    <table class="table inspection-table">
                        <thead>
                            <tr>
                                <th>Tài sản</th>
                                <th>Giá hỏng</th>
                                <th>Giá mất</th>
                                <th>Trạng thái</th>
                                <th>Số lượng</th>
                                <th class="text-end">Tạm tính</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int itemIndex = 0; itemIndex < Model.Rooms[roomIndex].Items.Count; itemIndex++)
                            {
                                var item = Model.Rooms[roomIndex].Items[itemIndex];
                                if (item.Category != "Asset")
                                {
                                    continue;
                                }
                                <tr class="inspection-row asset-row"
                                    data-damaged-price="@item.DamagedPrice.ToString(CultureInfo.InvariantCulture)"
                                    data-lost-price="@item.LostPrice.ToString(CultureInfo.InvariantCulture)">
                                    <td>
                                        <input asp-for="Rooms[roomIndex].Items[itemIndex].RoomChargeItemId"
                                               type="hidden" />
                                        <span class="inspection-name">@item.Name</span>
                                    </td>
                                    <td class="inspection-price">
                                        @item.DamagedPrice.ToString("N0") VNĐ
                                    </td>
                                    <td class="inspection-price">
                                        @item.LostPrice.ToString("N0") VNĐ
                                    </td>
                                    <td>
                                        <select asp-for="Rooms[roomIndex].Items[itemIndex].ResultType"
                                                class="form-select inspection-status result-select">
                                            <option value="Normal">Bình thường</option>
                                            <option value="Damaged">Hỏng</option>
                                            <option value="Lost">Mất</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input asp-for="Rooms[roomIndex].Items[itemIndex].Quantity"
                                               type="number"
                                               min="0"
                                               max="1000"
                                               class="form-control inspection-quantity quantity-input asset-quantity" />
                                    </td>
                                    <td class="text-end inspection-amount">0 VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        <div class="inspection-note">
            <label asp-for="Note"></label>
            <textarea asp-for="Note"
                      class="form-control"
                      placeholder="Ví dụ: Khách xác nhận đã sử dụng minibar, tài sản kiểm tra cùng khách..."></textarea>
            <span asp-validation-for="Note" class="text-danger small"></span>
        </div>
        <div class="inspection-summary">
            <div class="inspection-total">
                <span>Phụ thu kiểm tra phòng dự kiến</span>
                <strong id="inspectionTotal">0 VNĐ</strong>
            </div>
            <div class="inspection-actions">
                <a asp-controller="Bookings"
                   asp-action="Index"
                   class="inspection-cancel">
                    Hủy
                </a>
                <button type="submit" class="inspection-submit">
                    <i class="bi bi-check2-circle"></i>
                    Xác nhận kiểm tra &amp; Checkout
                </button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const formatMoney = value =>
                new Intl.NumberFormat('vi-VN').format(value) + ' VNĐ';

            const refreshRow = row => {
                const quantityInput = row.querySelector('.quantity-input');
                const amountElement = row.querySelector('.inspection-amount');
                let quantity = Number(quantityInput?.value || 0);
                let amount = 0;

                if (row.classList.contains('minibar-row')) {
                    const price = Number(row.dataset.usedPrice || 0);
                    const available = Number(row.dataset.available || 0);

                    quantity = Math.max(0, quantity);

                    if (quantity > available) {
                        quantity = available;
                        quantityInput.value = available;
                    }

                    amount = price * quantity;
                } else {
                    const resultSelect = row.querySelector('.result-select');
                    const result = resultSelect?.value || 'Normal';
                    if (result === 'Normal') {
                        quantityInput.value = 0;
                        quantityInput.disabled = true;
                        amount = 0;
                    } else {
                        quantityInput.disabled = false;
                        if (quantity <= 0) {
                            quantity = 1;
                            quantityInput.value = 1;
                        }
                        const price = result === 'Damaged'
                            ? Number(row.dataset.damagedPrice || 0)
                            : Number(row.dataset.lostPrice || 0);
                        amount = price * quantity;
                    }
                }

                row.dataset.amount = amount.toString();
                amountElement.textContent = formatMoney(amount);
            };

            const refreshTotal = () => {
                let total = 0;
                document.querySelectorAll('.inspection-row').forEach(row => {
                    refreshRow(row);
                    total += Number(row.dataset.amount || 0);
                });
                document.getElementById('inspectionTotal').textContent = formatMoney(total);
            };

            document.querySelectorAll('.quantity-input, .result-select').forEach(element => {
                element.addEventListener('input', refreshTotal);
                element.addEventListener('change', refreshTotal);
            });

            document.getElementById('inspectionForm').addEventListener('submit', event => {
                document.querySelectorAll('.asset-quantity:disabled').forEach(input => {
                    input.disabled = false;
                    input.value = 0;
                });
                if (!confirm('Xác nhận kết quả kiểm tra và hoàn tất Checkout?')) {
                    event.preventDefault();
                    refreshTotal();
                }
            });

            refreshTotal();
        })();
    </script>
}
