@model QuanLyKhachSan.ViewModels.BookingCreateViewModel

@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Đặt phòng";

    int numberOfNights =
        Model.CheckOutDate > Model.CheckInDate
        ? (Model.CheckOutDate - Model.CheckInDate).Days
        : 0;

    decimal estimatedTotal =
        Model.PricePerNight * numberOfNights;
}

<div class="mb-4">

    <h2 class="mb-1">
        Đặt phòng
    </h2>

    <p class="text-muted mb-0">
        Kiểm tra thông tin và xác nhận đặt phòng.
    </p>

</div>

<div class="row g-4">

    <!-- Form đặt phòng -->
    <div class="col-lg-7">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <form asp-controller="Bookings"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <input asp-for="RoomId"
                           type="hidden" />

                    <div class="row g-3">

                        <!-- Số phòng -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Phòng
                            </label>

                            <input class="form-control"
                                   value="@Model.RoomNumber"
                                   readonly />

                        </div>

                        <!-- Giá phòng -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Giá mỗi đêm
                            </label>

                            <input class="form-control"
                                   value="@Model.PricePerNight.ToString("N0") VNĐ"
                                   readonly />

                        </div>

                        <!-- Ngày nhận -->
                        <div class="col-md-6">

                            <label asp-for="CheckInDate"
                                   class="form-label fw-semibold">
                                Ngày nhận phòng
                            </label>

                            <input asp-for="CheckInDate"
                                   type="date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />

                            <span asp-validation-for="CheckInDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Ngày trả -->
                        <div class="col-md-6">

                            <label asp-for="CheckOutDate"
                                   class="form-label fw-semibold">
                                Ngày trả phòng
                            </label>

                            <input asp-for="CheckOutDate"
                                   type="date"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                   class="form-control" />

                            <span asp-validation-for="CheckOutDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Người lớn -->
                        <div class="col-md-6">

                            <label asp-for="Adult"
                                   class="form-label fw-semibold">
                                Số người lớn
                            </label>

                            <input asp-for="Adult"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control" />

                            <span asp-validation-for="Adult"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Trẻ em -->
                        <div class="col-md-6">

                            <label asp-for="Children"
                                   class="form-label fw-semibold">
                                Số trẻ em
                            </label>

                            <input asp-for="Children"
                                   type="number"
                                   min="0"
                                   max="20"
                                   class="form-control" />

                            <span asp-validation-for="Children"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Tiền cọc -->
                        <div class="col-12">

                            <label asp-for="Deposit"
                                   class="form-label fw-semibold">
                                Tiền cọc
                            </label>

                            <div class="input-group">

                                <input asp-for="Deposit"
                                       type="number"
                                       min="0"
                                       step="10000"
                                       class="form-control" />

                                <span class="input-group-text">
                                    VNĐ
                                </span>

                            </div>

                            <span asp-validation-for="Deposit"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Ghi chú -->
                        <div class="col-12">

                            <label asp-for="Note"
                                   class="form-label fw-semibold">
                                Ghi chú
                            </label>

                            <textarea asp-for="Note"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Nhập yêu cầu đặc biệt nếu có...">
                            </textarea>

                            <span asp-validation-for="Note"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle me-1"></i>
                            Xác nhận đặt phòng
                        </button>

                        <a asp-controller="Rooms"
                           asp-action="Search"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Quay lại tìm phòng
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- Thông tin tóm tắt -->
    <div class="col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-dark text-white">

                <h5 class="mb-0">
                    Thông tin đặt phòng
                </h5>

            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Phòng
                    </span>

                    <strong>
                        @Model.RoomNumber
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Ngày nhận
                    </span>

                    <strong>
                        @Model.CheckInDate.ToString("dd/MM/yyyy")
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Ngày trả
                    </span>

                    <strong>
                        @Model.CheckOutDate.ToString("dd/MM/yyyy")
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Số đêm
                    </span>

                    <strong>
                        @numberOfNights
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span class="text-muted">
                        Giá mỗi đêm
                    </span>

                    <strong>
                        @Model.PricePerNight.ToString("N0") VNĐ
                    </strong>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <span class="fw-semibold">
                        Tổng tiền dự kiến
                    </span>

                    <strong class="text-danger fs-5">
                        @estimatedTotal.ToString("N0") VNĐ
                    </strong>

                </div>

                <div class="alert alert-info small mt-4 mb-0">

                    Tổng tiền thực tế có thể thay đổi khi sử dụng
                    thêm dịch vụ tại khách sạn.

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}