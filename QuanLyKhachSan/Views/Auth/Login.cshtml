@model QuanLyKhachSan.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_CustomerLayout";
}
<section class="auth-page auth-login-page">
    <div class="auth-shell auth-shell-login">
        <aside class="auth-visual" aria-label="Giới thiệu Luxury Hotel">
            <div class="auth-overlay"></div>
            <a class="auth-brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Về trang chủ Luxury Hotel">
                <span class="auth-brand-icon" aria-hidden="true">
                    <i class="bi bi-building-fill"></i>
                </span>
                <span class="auth-brand-copy">
                    <strong>LUXURY</strong>
                    <small>HOTEL &amp; RESORT</small>
                </span>
            </a>
            <div class="auth-visual-content">
                <span class="auth-kicker">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    Trải nghiệm đẳng cấp
                </span>
                <h1>Chào mừng bạn quay trở lại</h1>
                <p>
                    Đăng nhập để quản lý Booking, hóa đơn,
                    dịch vụ và thông tin cá nhân của bạn.
                </p>
                <div class="auth-highlights" aria-label="Quyền lợi khách hàng">
                    <div>
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>Bảo mật an toàn</span>
                    </div>
                    <div>
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                        <span>Hỗ trợ 24/7</span>
                    </div>
                    <div>
                        <i class="bi bi-gem" aria-hidden="true"></i>
                        <span>Dịch vụ cao cấp</span>
                    </div>
                </div>
            </div>
            <div class="auth-visual-footer">
                <span></span>
                <p>Luxury Hotel &amp; Resort</p>
            </div>
        </aside>
        <div class="auth-form-panel">
            <div class="auth-form-wrap">
                <div class="auth-form-heading">
                    <span>Đăng nhập tài khoản</span>
                    <h2>Xin chào!</h2>
                    <p>Nhập thông tin của bạn để tiếp tục kỳ nghỉ trọn vẹn.</p>
                </div>
                @if (TempData["AuthError"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        @TempData["AuthError"]
                    </div>
                }
                @if (TempData["AuthSuccess"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["AuthSuccess"]
                    </div>
                }
                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post"
                      novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly"
                         class="auth-validation-summary"
                         role="alert">
                    </div>
                    <div class="auth-field">
                        <label asp-for="Username">Tên đăng nhập</label>
                        <div class="auth-input-group">
                            <span class="auth-input-icon" aria-hidden="true">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Username"
                                   class="auth-input"
                                   placeholder="Nhập tên đăng nhập"
                                   autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username"
                              class="auth-error"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="auth-input-group">
                            <span class="auth-input-icon" aria-hidden="true">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password"
                                   type="password"
                                   id="loginPassword"
                                   class="auth-input auth-password-input"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="loginPassword"
                                    aria-label="Hiện hoặc ẩn mật khẩu">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password"
                              class="auth-error"></span>
                    </div>
                    <button type="submit"
                            class="auth-primary-button">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        Đăng nhập
                    </button>
                    <div class="auth-divider">
                        <span>hoặc tiếp tục với</span>
                    </div>
                    <a asp-controller="Auth"
                       asp-action="GoogleLogin"
                       asp-route-returnUrl="@ViewData["ReturnUrl"]"
                       class="auth-google-button">
                        <i class="bi bi-google" aria-hidden="true"></i>
                        Đăng nhập bằng Google
                    </a>
                    <p class="auth-switch">
                        Chưa có tài khoản?
                        <a asp-controller="Auth"
                           asp-action="Register">
                            Đăng ký ngay
                        </a>
                    </p>
                    <p class="auth-security-note">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                        Thông tin của bạn được bảo vệ an toàn.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll(".auth-password-toggle").forEach(function (button) {
            button.addEventListener("click", function () {
                const input = document.getElementById(button.dataset.target);
                if (!input) {
                    return;
                }
                const isPassword = input.type === "password";
                input.type = isPassword ? "text" : "password";
                const icon = button.querySelector("i");
                if (icon) {
                    icon.className = isPassword
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";
                }
            });
        });
    </script>
}