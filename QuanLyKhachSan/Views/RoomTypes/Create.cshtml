@model QuanLyKhachSan.Models.RoomType
@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";
    ViewData["Title"] = "Thêm loại phòng";
}
<div class="container-fluid px-0">
    <!-- Tiêu đề -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-building-add text-primary me-2"></i>
                Thêm loại phòng mới
            </h2>
            <p class="text-muted mb-0">
                Nhập đầy đủ thông tin để tạo một loại phòng mới trong hệ thống.
            </p>
        </div>
        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách
        </a>
    </div>
    <div class="row g-4">
        <!-- Form nhập dữ liệu -->
        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm room-type-card">
                <div class="card-header bg-white border-0 px-4 pt-4 pb-0">
                    <h5 class="fw-bold mb-1">
                        Thông tin loại phòng
                    </h5>
                    <p class="text-muted small mb-0">
                        Các trường có dấu
                        <span class="text-danger">*</span>
                        là thông tin bắt buộc.
                    </p>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="RoomTypes"
                          asp-action="Create"
                          method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>
                        <div class="row g-3">
                            <!-- Tên loại phòng -->
                            <div class="col-md-6">
                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                    Tên loại phòng
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-door-open"></i>
                                    </span>
                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Ví dụ: Phòng Deluxe"
                                           autocomplete="off" />
                                </div>
                                <span asp-validation-for="Name"
                                      class="text-danger small">
                                </span>
                            </div>
                            <!-- Giá cơ bản -->
                            <div class="col-md-6">
                                <label asp-for="BasePrice"
                                       class="form-label fw-semibold">
                                    Giá cơ bản
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-cash-stack"></i>
                                    </span>
                                    <input asp-for="BasePrice"
                                           type="number"
                                           min="0"
                                           step="10000"
                                           class="form-control"
                                           placeholder="Ví dụ: 800000" />
                                    <span class="input-group-text">
                                        VNĐ
                                    </span>
                                </div>
                                <span asp-validation-for="BasePrice"
                                      class="text-danger small">
                                </span>
                            </div>
                            <!-- Sức chứa -->
                            <div class="col-md-6">
                                <label asp-for="MaxOccupancy"
                                       class="form-label fw-semibold">
                                    Sức chứa tối đa
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-people"></i>
                                    </span>
                                    <input asp-for="MaxOccupancy"
                                           type="number"
                                           min="1"
                                           max="20"
                                           class="form-control"
                                           placeholder="Ví dụ: 2" />
                                    <span class="input-group-text">
                                        người
                                    </span>
                                </div>
                                <span asp-validation-for="MaxOccupancy"
                                      class="text-danger small">
                                </span>
                            </div>
                            <!-- Loại giường -->
                            <div class="col-md-6">
                                <label asp-for="BedType"
                                       class="form-label fw-semibold">
                                    Loại giường
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-moon-stars"></i>
                                    </span>
                                    <input asp-for="BedType"
                                           class="form-control"
                                           placeholder="Ví dụ: Giường đôi Queen Size"
                                           autocomplete="off" />
                                </div>
                                <span asp-validation-for="BedType"
                                      class="text-danger small">
                                </span>
                            </div>
                            <!-- Diện tích -->
                            <div class="col-md-6">
                                <label asp-for="Area"
                                       class="form-label fw-semibold">
                                    Diện tích phòng
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-aspect-ratio"></i>
                                    </span>
                                    <input asp-for="Area"
                                           type="number"
                                           min="1"
                                           step="0.1"
                                           class="form-control"
                                           placeholder="Ví dụ: 35" />
                                    <span class="input-group-text">
                                        m²
                                    </span>
                                </div>
                                <span asp-validation-for="Area"
                                      class="text-danger small">
                                </span>
                            </div>
                            <!-- Mô tả -->
                            <div class="col-12">
                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                    Mô tả loại phòng
                                </label>
                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="5"
                                          maxlength="1000"
                                          placeholder="Nhập mô tả về không gian, tiện nghi và đặc điểm của loại phòng..."></textarea>
                                <div class="d-flex justify-content-between mt-1">
                                    <span asp-validation-for="Description"
                                          class="text-danger small">
                                    </span>
                                    <small class="text-muted">
                                        Tối đa 1000 ký tự
                                    </small>
                                </div>
                            </div>
                        </div>
                        <hr class="my-4" />
                        <!-- Các nút -->
                        <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">
                            <a asp-action="Index"
                               class="btn btn-light border px-4">
                                <i class="bi bi-x-circle me-1"></i>
                                Hủy bỏ
                            </a>
                            <button type="reset"
                                    class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Nhập lại
                            </button>
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>
                                Thêm loại phòng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Khung hướng dẫn -->
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm room-type-card mb-4">
                <div class="card-body p-4">
                    <div class="guide-icon mb-3">
                        <i class="bi bi-lightbulb"></i>
                    </div>
                    <h5 class="fw-bold">
                        Hướng dẫn nhập dữ liệu
                    </h5>
                    <p class="text-muted small">
                        Loại phòng được sử dụng để phân nhóm các phòng có cùng
                        đặc điểm, mức giá và sức chứa.
                    </p>
                    <div class="guide-item">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>
                            Tên loại phòng phải rõ ràng và không trùng lặp.
                        </span>
                    </div>
                    <div class="guide-item">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>
                            Giá cơ bản phải lớn hơn hoặc bằng 0.
                        </span>
                    </div>
                    <div class="guide-item">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>
                            Sức chứa phải phù hợp với diện tích phòng.
                        </span>
                    </div>
                    <div class="guide-item">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>
                            Mô tả nên nêu rõ tiện nghi và đặc điểm nổi bật.
                        </span>
                    </div>
                </div>
            </div>
            <div class="alert alert-info border-0 shadow-sm">
                <div class="d-flex gap-3">
                    <i class="bi bi-info-circle-fill fs-4"></i>
                    <div>
                        <strong>Lưu ý</strong>
                        <p class="small mb-0 mt-1">
                            Sau khi tạo loại phòng, bạn có thể sử dụng loại phòng
                            này trong chức năng thêm phòng mới.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .room-type-card {
        border-radius: 18px;
    }
        .room-type-card .form-control,
        .room-type-card .input-group-text {
            min-height: 46px;
        }
        .room-type-card textarea.form-control {
            min-height: 130px;
            resize: vertical;
        }
        .room-type-card .form-control:focus {
            border-color: rgba(13, 110, 253, 0.5);
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }
    .guide-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background-color: #fff3cd;
        color: #997404;
        font-size: 24px;
    }
    .guide-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 0;
        font-size: 14px;
        border-bottom: 1px dashed #dee2e6;
    }
        .guide-item:last-child {
            border-bottom: 0;
        }
    @@media (max-width: 767.98px) {
        .room-type-card .card-body {
            padding: 20px !important;
        }
    }
</style>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}