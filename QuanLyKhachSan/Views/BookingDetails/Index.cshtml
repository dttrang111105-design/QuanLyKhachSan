@model IEnumerable<QuanLyKhachSan.Models.BookingDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã đặt phòng</th>
            <th>Số phòng</th>
            <th>
                @Html.DisplayNameFor(model => model.PricePerNight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumberOfNights)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiscountPercent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPrice)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Booking?.BookingCode
            </td>
            <td>
                @item.Room?.RoomNumber
            </td>
            <td>
                @Html.DisplayFor(model => item.PricePerNight)
            </td>
            <td>
                @Html.DisplayFor(model => item.NumberOfNights)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiscountPercent)
            </td>
            <td>
                @Html.DisplayFor(model => item.TotalPrice)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
