}
@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const searchInput =
                    document.getElementById(
                        "customerSearch"
                    );
                const genderFilter =
                    document.getElementById(
                        "customerGenderFilter"
                    );
                const accountFilter =
                    document.getElementById(
                        "customerAccountFilter"
                    );
                const rows =
                    document.querySelectorAll(
                        ".customer-row"
                    );
                const emptyState =
                    document.getElementById(
                        "customerFilterEmpty"
                    );
                function filterCustomers() {
                    const keyword =
                        searchInput?.value
                            .trim()
                            .toLowerCase()
                        ?? "";
                    const gender =
                        genderFilter?.value
                        ?? "";
                    const account =
                        accountFilter?.value
                        ?? "";
                    let visibleCount = 0;
                    rows.forEach(function (row) {
                        const rowSearch =
                            row.dataset.search
                            ?? "";
                        const rowGender =
                            row.dataset.gender
                            ?? "";
                        const rowAccount =
                            row.dataset.account
                            ?? "";
                        const keywordMatched =
                            !keyword ||
                            rowSearch.includes(keyword);
                        const genderMatched =
                            !gender ||
                            rowGender === gender;
                        const accountMatched =
                            !account ||
                            rowAccount === account;
                        const visible =
                            keywordMatched &&
                            genderMatched &&
                            accountMatched;
                        row.classList.toggle(
                            "d-none",
                            !visible
                        );
                        if (visible) {
                            visibleCount++;
                        }
                    });
                    if (emptyState) {
                        emptyState.classList.toggle(
                            "d-none",
                            visibleCount > 0
                        );
                    }
                }
                searchInput?.addEventListener(
                    "input",
                    filterCustomers
                );
                genderFilter?.addEventListener(
                    "change",
                    filterCustomers
                );
                accountFilter?.addEventListener(
                    "change",
                    filterCustomers
                );
            }
        );
    </script>
}