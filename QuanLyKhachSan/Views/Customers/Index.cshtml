            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }
        .account-linked {
            background: #e3f6ec;
            color: #258459;
        }
        .account-unlinked {
            background: #eceef2;
            color: #646b79;
        }
        .customer-contact-cell,
        .customer-created-cell {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
            .customer-contact-cell span,
            .customer-contact-cell small {
                max-width: 190px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
            .customer-contact-cell i {
                width: 15px;
                color: #b58a42;
            }
            .customer-contact-cell small,
            .customer-created-cell small {
                color: #9297a3;
                font-size: 9px;
            }
        .customer-gender,
        .customer-date,
        .customer-citizen-id {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
            .customer-gender i,
            .customer-date i,
            .customer-citizen-id i {
