                color: #4f6fd8;
            }
            .customer-stat-icon.purple {
                background: #f0ebff;
                color: #8567d4;
            }
            .customer-stat-icon.green {
                background: #e4f7ef;
                color: #27875e;
            }
            .customer-stat-icon.gold {
                background: #fff1d9;
                color: #b87610;
            }
        .customer-stat-tag {
