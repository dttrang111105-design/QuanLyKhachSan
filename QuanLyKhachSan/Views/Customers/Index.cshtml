@model IEnumerable<QuanLyKhachSan.Models.Customer>
@using QuanLyKhachSan.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý khách hàng";
    List<Customer> customers = Model?.ToList() ?? new List<Customer>();
    int totalCustomers = customers.Count;
    int linkedAccounts = customers.Count(customer => customer.Account != null);
    int totalBookings = customers.Sum(customer => customer.Bookings?
            .Count(booking => !booking.IsDeleted) ?? 0);
    int totalReviews = customers.Sum(customer => customer.Reviews?
            .Count(review => !review.IsDeleted) ?? 0);
    DateTime monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    int newCustomersThisMonth = customers.Count(customer => customer.CreatedAt >= monthStart);
    List<string> genders = customers
        .Select(customer => Convert.ToString(customer.Gender)?.Trim())
        .Where(gender => !string.IsNullOrWhiteSpace(gender))
        .Select(gender => gender!)
        .Distinct()
        .OrderBy(gender => gender)
        .ToList();
    int BookingCount(Customer customer)
    {
        return customer.Bookings?.Count(booking => !booking.IsDeleted) ?? 0;
    }
    int ReviewCount(Customer customer)
    {
        return customer.Reviews?.Count(review => !review.IsDeleted) ?? 0;
    }
    string CustomerInitial(string? fullName)
    {
        return string.IsNullOrWhiteSpace(fullName) ? "K" : fullName.Trim().Substring(0, 1).ToUpper();
    }
    string GenderText(object? gender)
    {
        string value = Convert.ToString(gender)?.Trim() ?? string.Empty;
        return value.ToLower() switch
        {
            "male" => "Nam",
            "female" => "Nữ",
            "other" => "Khác",
            "nam" => "Nam",
            "nữ" => "Nữ",
            "nu" => "Nữ",
            "" => "Chưa cập nhật",
            _ => value
        };
    }
    string GenderIcon(object? gender)
    {
        string value = Convert.ToString(gender)?.Trim().ToLower() ?? string.Empty;
        return value switch
        {
            "male" or "nam" => "bi-gender-male",
            "female" or "nữ" or "nu" => "bi-gender-female",
            _ => "bi-person"
        };
    }
    string MaskCitizenId(string? citizenId)
    {
        if (string.IsNullOrWhiteSpace(citizenId))
        {
            return "Chưa cập nhật";
        }
        string value = citizenId.Trim();
        if (value.Length <= 4)
        {
            return value;
        }
        return new string('•', value.Length - 4) + value.Substring(value.Length - 4);
    }
}
<!-- TIÊU ĐỀ -->
<section class="customer-page-heading">
    <div>
        <span class="customer-page-kicker">
            Quản trị hệ thống
        </span>
        <h2>
            Quản lý khách hàng
        </h2>
        <p>
            Theo dõi hồ sơ, thông tin liên hệ, tài khoản,
            Booking và đánh giá của khách hàng.
        </p>
    </div>
    <div class="customer-heading-actions">
        <a asp-controller="Bookings" asp-action="Index"
           class="customer-heading-button">
            <i class="bi bi-calendar2-check"></i>
            Xem Booking
        </a>
        <a asp-controller="Customers" asp-action="Create"
           class="customer-heading-button primary">
            <i class="bi bi-person-plus"></i>
            Thêm khách hàng
        </a>
    </div>
</section>
<!-- THÔNG BÁO -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng">
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng">
        </button>
    </div>
}
<!-- THỐNG KÊ -->
<div class="row g-4 mb-4">
    <!-- Tổng khách hàng -->
    <div class="col-xl-3 col-md-6">
        <div class="customer-stat-card">
            <div class="customer-stat-top">
                <span class="customer-stat-icon blue">
                    <i class="bi bi-people-fill"></i>
                </span>
                <span class="customer-stat-tag">
                    Tổng cộng
                </span>
            </div>
            <span class="customer-stat-title">
                Khách hàng
            </span>
            <strong class="customer-stat-value">
                @totalCustomers
            </strong>
            <small>
                @newCustomersThisMonth khách mới trong tháng
            </small>
        </div>
    </div>
    <!-- Tài khoản -->
    <div class="col-xl-3 col-md-6">
        <div class="customer-stat-card">
            <div class="customer-stat-top">
                <span class="customer-stat-icon purple">
                    <i class="bi bi-person-check-fill"></i>
                </span>
                <span class="customer-stat-tag">
                    Đã liên kết
                </span>
            </div>
            <span class="customer-stat-title">
                Có tài khoản
            </span>
            <strong class="customer-stat-value">
                @linkedAccounts
            </strong>
            <small>
                Có thể đăng nhập hệ thống
            </small>
        </div>
    </div>
    <!-- Booking -->
    <div class="col-xl-3 col-md-6">
        <div class="customer-stat-card">
            <div class="customer-stat-top">
                <span class="customer-stat-icon green">
                    <i class="bi bi-calendar2-check-fill"></i>
                </span>
                <span class="customer-stat-tag">
                    Hoạt động
                </span>
            </div>
            <span class="customer-stat-title">
                Tổng Booking
            </span>
            <strong class="customer-stat-value">
                @totalBookings
            </strong>
            <small>
                Booking của các khách hàng
            </small>
        </div>
    </div>
    <!-- Đánh giá -->
    <div class="col-xl-3 col-md-6">
        <div class="customer-stat-card">
            <div class="customer-stat-top">
                <span class="customer-stat-icon gold">
                    <i class="bi bi-star-fill"></i>
                </span>
                <span class="customer-stat-tag">
                    Phản hồi
                </span>
            </div>
            <span class="customer-stat-title">
                Tổng đánh giá
            </span>
            <strong class="customer-stat-value">
                @totalReviews
            </strong>
            <small>
                Đánh giá phòng chưa bị xóa
            </small>
        </div>
    </div>
</div>
<!-- DANH SÁCH KHÁCH HÀNG -->
<div class="customer-panel">
    <div class="customer-panel-header">
        <div>
            <span class="customer-page-kicker">
                Danh sách dữ liệu
            </span>
            <h3>
                Hồ sơ khách hàng
            </h3>
            <p>
                Có @totalCustomers khách hàng được hiển thị.
            </p>
        </div>
        <div class="customer-filter-area">
            <div class="customer-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="customerSearch" placeholder="Tìm tên, điện thoại, email, CCCD..." />
            </div>
            <select id="customerGenderFilter" class="form-select">
                <option value="">
                    Tất cả giới tính
                </option>
                @foreach (string gender in genders)
                {
                    <option value="@gender">
                        @GenderText(gender)
                    </option>
                }
            </select>
            <select id="customerAccountFilter" class="form-select">
                <option value="">
                    Tất cả tài khoản
                </option>
                <option value="linked">
                    Đã có tài khoản
                </option>
                <option value="unlinked">
                    Chưa có tài khoản
                </option>
            </select>
        </div>
    </div>
    @if (customers.Any())
    {
        <div class="table-responsive">
            <table class="table customer-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4"> Khách hàng </th>
                        <th> Tài khoản </th>
                        <th> Liên hệ </th>
                        <th> Giới tính </th>
                        <th> Ngày sinh </th>
                        <th> CCCD </th>
                        <th> Booking </th>
                        <th> Đánh giá </th>
                        <th> Ngày tham gia </th>
                        <th class="text-end pe-4"> Thao tác </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Customer customer in customers)
                    {
                        int bookingCount = BookingCount(customer);
                        int reviewCount = ReviewCount(customer);
                        bool hasAccount = customer.Account != null;
                        string gender = Convert.ToString(customer.Gender)?.Trim() ?? string.Empty;
                        string accountStatus = hasAccount ? "linked" : "unlinked";
                        string searchData =
                            $"{customer.FullName} " +
                            $"{customer.Phone} " +
                            $"{customer.Email} " +
                            $"{customer.CitizenId} " +
                            $"{customer.Account?.Username}"
                                .ToLower();
                        <tr class="customer-row" data-gender="@gender"
                            data-account="@accountStatus" data-search="@searchData">
                            <!-- Khách hàng -->
                            <td class="ps-4">
                                <div class="customer-name-cell">
                                    @if (!string.IsNullOrWhiteSpace(
                                        customer.Avatar))
                                    {
                                        <img src="@customer.Avatar" alt="@customer.FullName"
                                             class="customer-avatar-image" />
                                    }
                                    else
                                    {
                                        <span class="customer-avatar-fallback">
                                            @CustomerInitial(customer.FullName)
                                        </span>
                                    }
                                    <div>
                                        <strong>
                                            @(string.IsNullOrWhiteSpace(customer.FullName)
                                                ? "Chưa cập nhật họ tên" : customer.FullName)
                                        </strong>
                                        <small>
                                            Mã khách hàng: #@customer.Id
                                        </small>
                                        @if (!string.IsNullOrWhiteSpace(
                                            customer.Address))
                                        {
                                            <span title="@customer.Address">
                                                <i class="bi bi-geo-alt"></i>
                                                @customer.Address
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <!-- Tài khoản -->
                            <td>
                                @if (hasAccount)
                                {
                                    <span class="customer-account account-linked">
                                        <i class="bi bi-person-check-fill"></i>
                                        @customer.Account!.Username
                                    </span>
                                }
                                else
                                {
                                    <span class="customer-account account-unlinked">
                                        <i class="bi bi-person-x"></i>
                                        Chưa liên kết
                                    </span>
                                }
                            </td>
                            <!-- Liên hệ -->
                            <td>
                                <div class="customer-contact-cell">
                                    <span>
                                        <i class="bi bi-telephone"></i>
                                        @(string.IsNullOrWhiteSpace(customer.Phone)
                                            ? "Chưa cập nhật" : customer.Phone)
                                    </span>
                                    <small title="@customer.Email">
                                        <i class="bi bi-envelope"></i>
                                        @(string.IsNullOrWhiteSpace(customer.Email)
                                            ? "Chưa cập nhật email" : customer.Email)
                                    </small>
                                </div>
                            </td>
                            <!-- Giới tính -->
                            <td>
                                <span class="customer-gender">
                                    <i class="bi @GenderIcon(customer.Gender)">
                                    </i>
                                    @GenderText(customer.Gender)
                                </span>
                            </td>
                            <!-- Ngày sinh -->
                            <td>
                                <span class="customer-date">
                                    <i class="bi bi-cake2"></i>
                                    @Html.DisplayFor(modelItem => customer.DateOfBirth)
                                </span>
                            </td>
                            <!-- CCCD -->
                            <td>
                                <span class="customer-citizen-id" title="@customer.CitizenId">
                                    <i class="bi bi-person-vcard"></i>
                                    @MaskCitizenId(customer.CitizenId)
                                </span>
                            </td>
                            <!-- Booking -->
                            <td>
                                <a asp-controller="Bookings" asp-action="Index"
                                   class="customer-count-badge booking">
                                    <i class="bi bi-calendar2-check"></i>
                                    @bookingCount
                                </a>
                            </td>
                            <!-- Đánh giá -->
                            <td>
                                <span class="customer-count-badge review">
                                    <i class="bi bi-star-fill"></i>
                                    @reviewCount
                                </span>
                            </td>
                            <!-- Ngày tham gia -->
                            <td>
                                <div class="customer-created-cell">
                                    <strong>
                                        @(customer.CreatedAt.ToString("dd/MM/yyyy"))
                                    </strong>
                                    <small>
                                        @customer.CreatedAt.ToString("HH:mm")
                                    </small>
                                </div>
                            </td>
                            <!-- Thao tác -->
                            <td class="text-end pe-4">
                                <div class="customer-action-group">
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id"
                                       class="customer-action view" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.Id"
                                       class="customer-action edit" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-controller="Customers" asp-action="Delete" asp-route-id="@customer.Id"
                                       class="customer-action delete" title="Xóa khách hàng">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="customerFilterEmpty" class="customer-empty-state d-none">
            <i class="bi bi-search"></i>
            <h4>
                Không tìm thấy khách hàng
            </h4>
            <p>
                Hãy thử từ khóa hoặc bộ lọc khác.
            </p>
        </div>
    }
    else
    {
        <div class="customer-empty-state">
            <i class="bi bi-person-x"></i>
            <h4>
                Chưa có khách hàng
            </h4>
            <p>
                Khách hàng đăng ký hoặc được thêm mới
                sẽ xuất hiện tại đây.
            </p>
            <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i>
                Thêm khách hàng đầu tiên
            </a>
        </div>
    }
</div>
@section Styles
{
    <style>
        .customer-page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 26px;
        }
            .customer-page-heading h2 {
                margin: 5px 0 7px;
                color: #252a35;
                font-weight: 700;
            }
            .customer-page-heading p {
                margin: 0;
                color: #838897;
            }
        .customer-page-kicker {
            color: #b58a42;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }
        .customer-heading-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }
        .customer-heading-button {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 16px;
            border: 1px solid #e1e3e9;
            border-radius: 11px;
            background: #ffffff;
            color: #555c69;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s ease;
        }
            .customer-heading-button:hover {
                border-color: #b58a42;
                color: #8f692f;
                transform: translateY(-2px);
            }
            .customer-heading-button.primary {
                border-color: #b58a42;
                background: linear-gradient( 135deg, #c49a51, #8f692f );
                color: #ffffff;
                box-shadow: 0 10px 23px rgba(181, 138, 66, 0.2);
            }
                .customer-heading-button.primary:hover {
                    color: #ffffff;
                }
        .customer-stat-card {
            height: 100%;
            padding: 21px;
            border: 1px solid #e8e9ee;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(34, 38, 51, 0.065);
        }
        .customer-stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 17px;
        }
        .customer-stat-icon {
            width: 48px;
            height: 48px;
            display: inline-flex;
