    <a asp-controller="Customers" asp-action="Index" class="admin-stat-card stat-customer">
        <div class="admin-stat-card-top">
            <span class="admin-stat-icon">
                <i class="bi bi-people-fill"></i>
            </span>
            <span class="admin-stat-trend positive">
                <i class="bi bi-person-check"></i>
                Đang hoạt động
