@using System.Text.Json
@using QuanLyKhachSan.Enums
@model QuanLyKhachSan.ViewModels.Dashboard.DashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan quản trị";
    ViewData["BodyClass"] = "admin-dashboard-page";
    double occupancyRate = Model.TotalRooms > 0 ? (double)Model.OccupiedRooms / Model.TotalRooms * 100 : 0;
    double availableRate = Model.TotalRooms > 0 ? (double)Model.AvailableRooms / Model.TotalRooms * 100 : 0;
    double maintenanceRate = Model.TotalRooms > 0 ? (double)Model.MaintenanceRooms / Model.TotalRooms * 100 : 0;
    string occupancyRateCss = System.Math.Min(100, System.Math.Max(0, occupancyRate))
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string occupancyRateText = occupancyRate.ToString("0.0");
    string BookingStatusText(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "Chờ xác nhận",
            BookingStatus.Confirmed => "Đã xác nhận",
            BookingStatus.CheckedIn => "Đang lưu trú",
            BookingStatus.CheckedOut => "Đã trả phòng",
            BookingStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }
    string BookingStatusClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "status-pending",
            BookingStatus.Confirmed => "status-confirmed",
            BookingStatus.CheckedIn => "status-checkedin",
            BookingStatus.CheckedOut => "status-checkedout",
            BookingStatus.Cancelled => "status-cancelled",
            _ => string.Empty
        };
    }
    string Initial(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "K" : value.Trim().Substring(0, 1).ToUpper();
    }
    string RoomList(QuanLyKhachSan.Models.Booking booking)
    {
        var roomNumbers = booking.BookingDetails
            .Where(detail => !detail.IsDeleted)
            .Select(detail => detail.Room)
            .OfType<QuanLyKhachSan.Models.Room>()
            .Select(room => room.RoomNumber)
            .Where(roomNumber => !string.IsNullOrWhiteSpace(roomNumber))
            .Distinct()
            .ToList();

        return roomNumbers.Count > 0 ? string.Join(", ", roomNumbers) : "Chưa xếp phòng";
    }
}
<section class="admin-dashboard-hero" aria-labelledby="adminDashboardTitle">
    <div class="admin-dashboard-hero-content">
        <span class="admin-dashboard-kicker">
            <i class="bi bi-stars"></i>
            Luxury Hotel Management
        </span>
        <h2 id="adminDashboardTitle">
            Chào mừng trở lại,
            <span>
                @(Model.FullName ?? User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Quản trị viên")
            </span>
        </h2>
        <p>
            Theo dõi doanh thu, công suất phòng, khách lưu trú và các hoạt động
            vận hành quan trọng của khách sạn trên một màn hình quản trị thống nhất.
        </p>
        <div class="admin-dashboard-actions">
            <a asp-controller="Bookings" asp-action="Index" class="admin-outline-action">
                <i class="bi bi-calendar2-check"></i>
                Quản lý Booking
            </a>
            <a asp-controller="Rooms" asp-action="Create" class="admin-primary-action">
                <i class="bi bi-plus-lg"></i>
                Thêm phòng mới
            </a>
        </div>
    </div>
    <div class="admin-dashboard-hero-overview" aria-label="Tổng quan vận hành">
        <div class="admin-hero-overview-card admin-hero-overview-main">
            <div class="admin-hero-overview-heading">
                <span>Công suất phòng hiện tại</span>
                <i class="bi bi-bar-chart-line-fill"></i>
            </div>
            <strong>@occupancyRate.ToString("0.0")%</strong>
            <div class="admin-hero-progress" aria-hidden="true">
                <span style="width: @occupancyRateCss%"></span>
            </div>
            <small>
                @Model.OccupiedRooms phòng đang có khách trên tổng số @Model.TotalRooms phòng
            </small>
        </div>
        <div class="admin-hero-overview-grid">
            <div class="admin-hero-mini-card">
                <span class="admin-hero-mini-icon">
                    <i class="bi bi-door-open"></i>
                </span>
                <div>
                    <small>Phòng trống</small>
                    <strong>@Model.AvailableRooms</strong>
                </div>
            </div>
            <div class="admin-hero-mini-card">
                <span class="admin-hero-mini-icon gold">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <div>
                    <small>Chờ xác nhận</small>
                    <strong>@Model.PendingBookings</strong>
                </div>
            </div>
        </div>
    </div>
</section>
