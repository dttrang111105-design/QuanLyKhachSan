<section class="admin-dashboard-insights-grid">
    <article class="admin-panel admin-revenue-panel">
        <div class="admin-panel-header admin-revenue-panel-header">
            <div>
                <span>Phân tích doanh thu</span>
                <h3 id="adminRevenueTitle">
                    Doanh thu theo tuần
                </h3>
            </div>

            <div class="admin-revenue-header-actions">
                <div class="admin-revenue-control-stack">
                    <div class="admin-revenue-period-switch"
                         role="group" aria-label="Chọn khoảng thời gian xem doanh thu">

                        <button type="button" class="admin-revenue-period-button active"
                                data-revenue-period="week" aria-pressed="true">
                            Tuần
                        </button>

                        <button type="button" class="admin-revenue-period-button"
                                data-revenue-period="month" aria-pressed="false">
                            Tháng
                        </button>

                        <button type="button" class="admin-revenue-period-button"
                                data-revenue-period="quarter" aria-pressed="false">
                            Quý
                        </button>
                    </div>

                    <div class="admin-week-navigation" id="adminWeekNavigation"
                         data-week-offset="@Model.WeekOffset">

                        <button type="button" id="adminPreviousWeekButton"
                                class="admin-week-navigation-button" title="Xem tuần trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <span class="admin-week-range" id="adminWeekRange">
                            @Model.SelectedWeekRange
                        </span>

                        <button type="button" id="adminNextWeekButton"
                                class="admin-week-navigation-button" title="Xem tuần kế tiếp">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <div class="admin-panel-summary">
                    <small id="adminRevenueSummaryLabel">
                        Tổng doanh thu tuần
                    </small>

                    <strong id="adminRevenueSummaryValue">
                        @Model.RevenueThisWeek.ToString("N0") VNĐ
                    </strong>
                </div>
            </div>
        </div>

        <div class="admin-chart-container admin-revenue-chart">
            <canvas id="adminRevenueChart" role="img" aria-label="Biểu đồ doanh thu tuần này">
            </canvas>
        </div>
    </article>
    <article class="admin-panel admin-room-panel">
        <div class="admin-panel-header">
            <div>
                <span>Tình trạng phòng</span>
                <h3>Cơ cấu sử dụng phòng</h3>
            </div>
        </div>
        <div class="admin-chart-container admin-room-chart">
            <canvas id="adminRoomChart" role="img" aria-label="Biểu đồ tình trạng phòng"></canvas>
        </div>
        <div class="admin-room-legend">
            <div>
                <span class="legend-dot available"></span>
                <div>
                    <small>Còn trống</small>
                    <strong>@Model.AvailableRooms</strong>
                    <span>@availableRate.ToString("0.0")%</span>
                </div>
            </div>
            <div>
                <span class="legend-dot occupied"></span>
                <div>
                    <small>Đang có khách</small>
                    <strong>@Model.OccupiedRooms</strong>
                    <span>@occupancyRate.ToString("0.0")%</span>
                </div>
            </div>
            <div>
                <span class="legend-dot maintenance"></span>
                <div>
                    <small>Bảo trì</small>
                    <strong>@Model.MaintenanceRooms</strong>
                    <span>@maintenanceRate.ToString("0.0")%</span>
                </div>
            </div>
        </div>
    </article>
</section>
<section class="admin-dashboard-bottom-grid">
    <article class="admin-panel admin-quick-panel">
        <div class="admin-panel-header">
            <div>
                <span>Truy cập nhanh</span>
                <h3>Thao tác quản trị</h3>
            </div>
        </div>
        <div class="admin-quick-actions">
            <a asp-controller="Bookings" asp-action="Index" class="admin-quick-action">
                <span class="quick-action-icon booking">
                    <i class="bi bi-calendar-plus"></i>
                </span>
                <div>
                    <strong>Quản lý Booking</strong>
                    <small>Xác nhận, Check In và Check Out</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-controller="Rooms" asp-action="Create" class="admin-quick-action">
                <span class="quick-action-icon room">
                    <i class="bi bi-door-open"></i>
                </span>
                <div>
                    <strong>Thêm phòng mới</strong>
                    <small>Cập nhật kho phòng khách sạn</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-controller="Employees" asp-action="Create" class="admin-quick-action">
                <span class="quick-action-icon employee">
                    <i class="bi bi-person-plus"></i>
                </span>
                <div>
                    <strong>Thêm nhân viên</strong>
                    <small>Quản lý nhân sự khách sạn</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </article>
    <article class="admin-panel admin-booking-panel">
        <div class="admin-panel-header">
            <div>
                <span>Hoạt động mới nhất</span>
                <h3>Booking gần đây</h3>
            </div>
            <a asp-controller="Bookings" asp-action="Index" class="admin-panel-link">
                Xem tất cả
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="table-responsive admin-dashboard-table-wrap">
            <table class="table admin-dashboard-table align-middle">
                <thead>
                    <tr>
                        <th>Mã Booking</th>
                        <th>Khách hàng</th>
                        <th>Phòng</th>
                        <th>Nhận phòng</th>
                        <th>Trạng thái</th>
                        <th><span class="visually-hidden">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                    {
                        foreach (var booking in Model.RecentBookings)
                        {
                            <tr>
                                <td>
                                    <strong class="admin-booking-code">
                                        @booking.BookingCode
                                    </strong>
                                    <small>
                                        @booking.BookingDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <div class="admin-customer-cell">
                                        <span class="admin-customer-avatar">
                                            @Initial(booking.Customer?.FullName)
                                        </span>
                                        <div>
                                            <strong>
                                                @(booking.Customer?.FullName ?? "Không xác định")
                                            </strong>
                                            <small>
                                                @(booking.Customer?.Phone ?? "Chưa có SĐT")
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="admin-room-list">
                                        <i class="bi bi-door-closed"></i>
                                        @RoomList(booking)
                                    </span>
                                </td>
                                <td>
                                    <span class="admin-checkin-date">
                                        <i class="bi bi-calendar3"></i>
                                        @booking.CheckInDate.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="admin-status-badge @BookingStatusClass(booking.Status)">
                                        @BookingStatusText(booking.Status)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id"
                                       class="admin-table-action" title="Xem chi tiết"
                                       aria-label="Xem chi tiết booking @booking.BookingCode">
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="admin-empty-state">
                                    <i class="bi bi-calendar-x"></i>
                                    <strong>Chưa có Booking</strong>
                                    <span>Booking mới sẽ xuất hiện tại đây.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>
@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
                    const revenueSeries = {
            week: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.RevenueWeekLabels)),
                values:@Html.Raw(JsonSerializer.Serialize(Model.RevenueWeekValues)),
                title: "Doanh thu theo tuần",
                summaryLabel: @Html.Raw(JsonSerializer.Serialize($"Tổng tuần {Model.SelectedWeekRange}")),
                total: @Html.Raw(JsonSerializer.Serialize(Model.RevenueThisWeek)),
                ariaLabel: @Html.Raw(JsonSerializer.Serialize($"Biểu đồ doanh thu tuần {Model.SelectedWeekRange}"))
        },

            month: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.RevenueMonthLabels)),
                values: @Html.Raw(JsonSerializer.Serialize(Model.RevenueMonthValues)),
                title: "Doanh thu tháng này",
                summaryLabel: "Tổng doanh thu tháng",
                total: @Html.Raw(JsonSerializer.Serialize(Model.RevenueThisMonth)),
                ariaLabel: "Biểu đồ doanh thu tháng này"
            },

            quarter: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.RevenueQuarterLabels)),
                values: @Html.Raw(JsonSerializer.Serialize(Model.RevenueQuarterValues)),
                title: "Doanh thu quý này",
                summaryLabel: "Tổng doanh thu quý",
                total: @Html.Raw(JsonSerializer.Serialize(Model.RevenueThisQuarter)),
                ariaLabel: "Biểu đồ doanh thu quý này"
            }
        };

        const revenueLabels = revenueSeries.week.labels;
        const revenueValues = revenueSeries.week.values;
            const roomValues = [@Model.AvailableRooms, @Model.OccupiedRooms, @Model.MaintenanceRooms];
            const bodyStyles = getComputedStyle(document.body);
            const luxuryBlue = bodyStyles.getPropertyValue("--dashboard-blue").trim() || "#2f7395";
            const luxuryNavy = bodyStyles.getPropertyValue("--dashboard-navy").trim() || "#123d55";
            const luxuryGold = bodyStyles.getPropertyValue("--dashboard-gold").trim() || "#c9a96e";
            const luxuryGreen = "#3b9b7a";
            const luxuryWarning = "#d9a24a";
            const mutedText = "#7d919c";
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            Chart.defaults.font.family = "Poppins, DM Sans, sans-serif";
            Chart.defaults.color = mutedText;
            const revenueCanvas = document.getElementById("adminRevenueChart");
            let revenueChart = null;
            if (revenueCanvas && window.Chart) {
                const revenueContext = revenueCanvas.getContext("2d");
                const revenueGradient = revenueContext.createLinearGradient(0, 0, 0, 330);
                revenueGradient.addColorStop(0, "rgba(47, 115, 149, 0.28)");
                revenueGradient.addColorStop(1, "rgba(47, 115, 149, 0.01)");
                revenueChart = new Chart(revenueCanvas, {
                    type: "line",
                    data: {
                        labels: revenueLabels,
                        datasets: [
                            {
                                label: "Doanh thu",
                                data: revenueValues,
                                borderColor: luxuryBlue,
                                backgroundColor: revenueGradient,
                                pointBackgroundColor: "#ffffff",
                                pointBorderColor: luxuryBlue,
                                pointBorderWidth: 3,
                                pointRadius: 4,
                                pointHoverRadius: 7,
                                borderWidth: 3,
                                fill: true,
                                tension: 0.38
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: reducedMotion ? false : {
                            duration: 850,
                            easing: "easeOutQuart"
                        },
                        interaction: {
                            intersect: false,
                            mode: "index"
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: luxuryNavy,
                                titleColor: "#ffffff",
                                bodyColor: "#ffffff",
                                borderColor: "rgba(201, 169, 110, 0.45)",
                                borderWidth: 1,
                                padding: 13,
                                displayColors: false,
                                callbacks: {
                                    label: function (context) {
                                        return new Intl.NumberFormat("vi-VN").format(
                                            context.parsed.y
                                        ) + " VNĐ";
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    color: mutedText,
                                    font: {
                                        size: 11,
                                        weight: "500"
                                    }
                                },
                                border: {
                                    display: false
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: "rgba(23, 56, 76, 0.075)",
                                    drawTicks: false
                                },
                                ticks: {
                                    color: mutedText,
                                    padding: 10,
                                    callback: function (value) {
                                        if (value >= 1000000) {
                                            return (value / 1000000).toLocaleString("vi-VN") + "tr";
                                        }
                                        if (value >= 1000) {
                                            return (value / 1000).toLocaleString("vi-VN") + "k";
                                        }
                                        return value;
                                    }
                                },
                                border: {
                                    display: false
                                }
                            }
                        }
                    }
                });
        const revenueTitle = document.getElementById("adminRevenueTitle");
        const revenueSummaryLabel = document.getElementById("adminRevenueSummaryLabel");
        const revenueSummaryValue = document.getElementById("adminRevenueSummaryValue");
        const revenuePeriodButtons = document.querySelectorAll("[data-revenue-period]");
        const weekNavigation = document.getElementById("adminWeekNavigation");
        const previousWeekButton = document.getElementById("adminPreviousWeekButton");
        const nextWeekButton = document.getElementById("adminNextWeekButton");
        const weekRange = document.getElementById("adminWeekRange");
        const weeklyRevenueUrl = '@Url.Action("GetWeeklyRevenue", "Home")';
        let selectedWeekOffset = Number(weekNavigation?.dataset.weekOffset ?? 0);
        let isLoadingWeek = false;
        /* CHUYỂN TUẦN - THÁNG - QUÝ */
        revenuePeriodButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                const period = button.dataset.revenuePeriod;
                const selectedSeries = revenueSeries[period];
                if (!selectedSeries || !revenueChart) {
                    return;
                }
                // Chỉ hiện nút chuyển tuần khi chọn Tuần.
                if (weekNavigation) {
                    weekNavigation.hidden = period !== "week";
                }
                revenueChart.data.labels = selectedSeries.labels;
                revenueChart.data.datasets[0].data = selectedSeries.values;
                revenueChart.update();
                if (revenueTitle) {
                    revenueTitle.textContent = selectedSeries.title;
                }
                if (revenueSummaryLabel) {
                    revenueSummaryLabel.textContent = selectedSeries.summaryLabel;
                }
                if (revenueSummaryValue) {
                    revenueSummaryValue.textContent = new Intl.NumberFormat("vi-VN").format(selectedSeries.total) + " VNĐ";
                }
                revenueCanvas.setAttribute("aria-label", selectedSeries.ariaLabel);
                revenuePeriodButtons.forEach(
                    function (periodButton) {
                        const isActive = periodButton === button;
                        periodButton.classList.toggle("active", isActive);
                        periodButton.setAttribute("aria-pressed", isActive ? "true" : "false");
                    }
                );
            });
        });

        /* BẬT/TẮT NÚT CHUYỂN TUẦN */
        function updateWeekButtonState() {
            if (previousWeekButton) {
                previousWeekButton.disabled = isLoadingWeek || selectedWeekOffset <= -260;
            }
            if (nextWeekButton) {
                nextWeekButton.disabled = isLoadingWeek || selectedWeekOffset >= 0;
            }
            if (weekNavigation) {
                weekNavigation.classList.toggle( "is-loading", isLoadingWeek);
            }
        }
        /* CẬP NHẬT URL NHƯNG KHÔNG TẢI LẠI */
        function updateWeekUrl() {
            const currentUrl = new URL(window.location.href);
            if (selectedWeekOffset === 0) {
                currentUrl.searchParams.delete("weekOffset");
            } else {
                currentUrl.searchParams.set("weekOffset", selectedWeekOffset.toString());
            }
            window.history.replaceState({}, "", currentUrl.toString());
        }
        /* LẤY DOANH THU TUẦN BẰNG FETCH */
        async function loadWeeklyRevenue(newWeekOffset) {
            if (isLoadingWeek || !revenueChart) {
                return;
            }
            isLoadingWeek = true;
            updateWeekButtonState();
            try {
                const requestUrl = weeklyRevenueUrl + "?weekOffset=" + encodeURIComponent(newWeekOffset);

                const response = await fetch(requestUrl, {
                    method: "GET",
                    credentials: "same-origin",
                    headers: {
                        "Accept": "application/json", "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!response.ok) {
                    throw new Error("HTTP " + response.status );
                }
                const data = await response.json();
                selectedWeekOffset = Number(data.weekOffset);
                // Lưu dữ liệu tuần vừa tải.
                revenueSeries.week.labels = data.labels ?? [];
                revenueSeries.week.values = data.values ?? [];
                revenueSeries.week.total = Number(data.total ?? 0);
                revenueSeries.week.title = "Doanh thu theo tuần";
                revenueSeries.week.summaryLabel = "Tổng tuần " + data.selectedWeekRange;
                revenueSeries.week.ariaLabel = "Biểu đồ doanh thu tuần " + data.selectedWeekRange;
                // Cập nhật biểu đồ.
                revenueChart.data.labels = revenueSeries.week.labels;
                revenueChart.data.datasets[0].data = revenueSeries.week.values;
                revenueChart.update();
                // Cập nhật khoảng ngày.
                if (weekRange) {
                    weekRange.textContent = data.selectedWeekRange;
                }
                // Cập nhật tiêu đề.
                if (revenueTitle) {
                    revenueTitle.textContent = revenueSeries.week.title;
                }
                // Cập nhật tổng tiền.
                if (revenueSummaryLabel) {
                    revenueSummaryLabel.textContent = revenueSeries.week.summaryLabel;
                }
                if (revenueSummaryValue) {
                    revenueSummaryValue.textContent = new Intl.NumberFormat("vi-VN").format(revenueSeries.week.total) + " VNĐ";
                }
                revenueCanvas.setAttribute("aria-label", revenueSeries.week.ariaLabel );
                if (weekNavigation) {
                    weekNavigation.dataset.weekOffset = selectedWeekOffset.toString();
                }
                updateWeekUrl();
            } catch (error) {
                console.error("Lỗi tải doanh thu tuần:", error);
                alert("Không thể tải dữ liệu doanh thu tuần. " +"Hãy kiểm tra lại kết nối hoặc đăng nhập.");
            } finally {
                isLoadingWeek = false;
                updateWeekButtonState();
            }
        }
        /* SỰ KIỆN NÚT TUẦN TRƯỚC */
        if (previousWeekButton) {
            previousWeekButton.addEventListener("click", function () {
                    loadWeeklyRevenue(selectedWeekOffset - 1);
                });
        }
        /* SỰ KIỆN NÚT TUẦN SAU*/
        if (nextWeekButton) {
            nextWeekButton.addEventListener("click", function () {
                    if (selectedWeekOffset < 0) {
                        loadWeeklyRevenue(selectedWeekOffset + 1);
                    }
                });
        }

        updateWeekButtonState();
        }
            const roomCanvas = document.getElementById("adminRoomChart");
            if (roomCanvas && window.Chart) {
                const centerTextPlugin = {
                    id: "roomCenterText", afterDraw(chart) {
                        const { ctx, chartArea } = chart;
                        if (!chartArea) {
                            return;
                        }
                        const centerX = (chartArea.left + chartArea.right) / 2;
                        const centerY = (chartArea.top + chartArea.bottom) / 2;
                        ctx.save();
                        ctx.textAlign = "center";
                        ctx.textBaseline = "middle";
                        ctx.fillStyle = luxuryNavy;
                        ctx.font = "700 25px Poppins";
                        ctx.fillText("@occupancyRateText%", centerX, centerY - 7);
                        ctx.fillStyle = mutedText;
                        ctx.font = "500 10px Poppins";
                        ctx.fillText("CÔNG SUẤT", centerX, centerY + 17);
                        ctx.restore();
                    }
                };
                new Chart(roomCanvas, {
                    type: "doughnut",
                    plugins: [centerTextPlugin],
                    data: {
                        labels: ["Còn trống", "Đang có khách", "Bảo trì"],
                        datasets: [
                            {
                                data: roomValues,
                                backgroundColor: [
                                    luxuryGreen,
                                    luxuryBlue,
                                    luxuryWarning
                                ],
                                borderColor: "#ffffff",
                                borderWidth: 5,
                                hoverOffset: 7
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "72%",
                        animation: reducedMotion ? false : {
                            duration: 850,
                            easing: "easeOutQuart"
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: luxuryNavy,
                                titleColor: "#ffffff",
                                bodyColor: "#ffffff",
                                borderColor: "rgba(201, 169, 110, 0.45)",
                                borderWidth: 1,
                                padding: 12,
                                callbacks: {
                                    label: function (context) {
                                        return context.label + ": " + context.parsed + " phòng";
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
