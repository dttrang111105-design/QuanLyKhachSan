@using System.Text.Json
@using QuanLyKhachSan.Enums
@model QuanLyKhachSan.ViewModels.Dashboard.DashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan quản trị";
    ViewData["BodyClass"] = "admin-dashboard-page";

    double occupancyRate =
        Model.TotalRooms > 0
            ? (double)Model.OccupiedRooms / Model.TotalRooms * 100
            : 0;

    double availableRate =
        Model.TotalRooms > 0
            ? (double)Model.AvailableRooms / Model.TotalRooms * 100
            : 0;

    double maintenanceRate =
        Model.TotalRooms > 0
            ? (double)Model.MaintenanceRooms / Model.TotalRooms * 100
            : 0;

    string occupancyRateCss = System.Math.Min(100, System.Math.Max(0, occupancyRate))
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    string occupancyRateText = occupancyRate.ToString("0.0");

    string BookingStatusText(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "Chờ xác nhận",
            BookingStatus.Confirmed => "Đã xác nhận",
            BookingStatus.CheckedIn => "Đang lưu trú",
            BookingStatus.CheckedOut => "Đã trả phòng",
            BookingStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }

    string BookingStatusClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending => "status-pending",
            BookingStatus.Confirmed => "status-confirmed",
            BookingStatus.CheckedIn => "status-checkedin",
            BookingStatus.CheckedOut => "status-checkedout",
            BookingStatus.Cancelled => "status-cancelled",
            _ => string.Empty
        };
    }

    string Initial(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "K"
            : value.Trim().Substring(0, 1).ToUpper();
    }

    string RoomList(QuanLyKhachSan.Models.Booking booking)
    {
        if (booking.BookingDetails == null ||
            !booking.BookingDetails.Any())
        {
            return "Chưa xếp phòng";
        }

        var roomNumbers = booking.BookingDetails
            .Where(detail =>
                !detail.IsDeleted &&
                detail.Room != null)
            .Select(detail => detail.Room!.RoomNumber)
            .Distinct()
            .ToList();

        return roomNumbers.Any()
            ? string.Join(", ", roomNumbers)
            : "Chưa xếp phòng";
    }
}

<section class="admin-dashboard-hero" aria-labelledby="adminDashboardTitle">
    <div class="admin-dashboard-hero-content">
        <span class="admin-dashboard-kicker">
            <i class="bi bi-stars"></i>
            Luxury Hotel Management
        </span>

        <h2 id="adminDashboardTitle">
            Chào mừng trở lại,
            <span>
                @(Model.FullName
                    ?? User.FindFirst("FullName")?.Value
                    ?? User.Identity?.Name
                    ?? "Quản trị viên")
            </span>
        </h2>

        <p>
            Theo dõi doanh thu, công suất phòng, khách lưu trú và các hoạt động
            vận hành quan trọng của khách sạn trên một màn hình quản trị thống nhất.
        </p>

        <div class="admin-dashboard-actions">
            <a asp-controller="Bookings"
               asp-action="Index"
               class="admin-outline-action">
                <i class="bi bi-calendar2-check"></i>
                Quản lý Booking
            </a>

            <a asp-controller="Rooms"
               asp-action="Create"
               class="admin-primary-action">
                <i class="bi bi-plus-lg"></i>
                Thêm phòng mới
            </a>
        </div>
    </div>

    <div class="admin-dashboard-hero-overview" aria-label="Tổng quan vận hành">
        <div class="admin-hero-overview-card admin-hero-overview-main">
            <div class="admin-hero-overview-heading">
                <span>Công suất phòng hiện tại</span>
                <i class="bi bi-bar-chart-line-fill"></i>
            </div>

            <strong>@occupancyRate.ToString("0.0")%</strong>

            <div class="admin-hero-progress" aria-hidden="true">
                <span style="width: @occupancyRateCss%"></span>
            </div>

            <small>
                @Model.OccupiedRooms phòng đang có khách trên tổng số @Model.TotalRooms phòng
            </small>
        </div>

        <div class="admin-hero-overview-grid">
            <div class="admin-hero-mini-card">
                <span class="admin-hero-mini-icon">
                    <i class="bi bi-door-open"></i>
                </span>
                <div>
                    <small>Phòng trống</small>
                    <strong>@Model.AvailableRooms</strong>
                </div>
            </div>

            <div class="admin-hero-mini-card">
                <span class="admin-hero-mini-icon gold">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <div>
                    <small>Chờ xác nhận</small>
                    <strong>@Model.PendingBookings</strong>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="admin-dashboard-stat-grid" aria-label="Chỉ số quản trị">
    <a asp-controller="Payments"
       asp-action="Index"
       class="admin-stat-card stat-revenue">
        <div class="admin-stat-card-top">
            <span class="admin-stat-icon">
                <i class="bi bi-wallet2"></i>
            </span>

            <span class="admin-stat-trend positive">
                <i class="bi bi-graph-up-arrow"></i>
                Tháng này
            </span>
        </div>

        <span class="admin-stat-label">Doanh thu tháng</span>

        <strong class="admin-stat-value admin-money-value">
            @Model.RevenueThisMonth.ToString("N0")
            <small>VNĐ</small>
        </strong>

        <div class="admin-stat-footer">
            <span>
                Hôm nay:
                <b>@Model.RevenueToday.ToString("N0") VNĐ</b>
            </span>
            <i class="bi bi-arrow-up-right"></i>
        </div>
    </a>

    <a asp-controller="Bookings"
       asp-action="Index"
       class="admin-stat-card stat-booking">
        <div class="admin-stat-card-top">
            <span class="admin-stat-icon">
                <i class="bi bi-calendar2-week-fill"></i>
            </span>

            <span class="admin-stat-trend neutral">
                @Model.PendingBookings chờ duyệt
            </span>
        </div>

        <span class="admin-stat-label">Tổng Booking</span>

        <strong class="admin-stat-value">@Model.TotalBookings</strong>

        <div class="admin-stat-footer">
            <span>
                Đã xác nhận:
                <b>@Model.ConfirmedBookings booking</b>
            </span>
            <i class="bi bi-arrow-up-right"></i>
        </div>
    </a>

    <a asp-controller="Rooms"
       asp-action="Index"
       class="admin-stat-card stat-room">
        <div class="admin-stat-card-top">
            <span class="admin-stat-icon">
                <i class="bi bi-door-open-fill"></i>
            </span>

            <span class="admin-stat-trend neutral">
                @occupancyRate.ToString("0.0")% sử dụng
            </span>
        </div>

        <span class="admin-stat-label">Tổng số phòng</span>

        <strong class="admin-stat-value">@Model.TotalRooms</strong>

        <div class="admin-stat-footer">
            <span>
                Còn trống:
                <b>@Model.AvailableRooms phòng</b>
            </span>
            <i class="bi bi-arrow-up-right"></i>
        </div>
    </a>

    <a asp-controller="Customers"
       asp-action="Index"
       class="admin-stat-card stat-customer">
        <div class="admin-stat-card-top">
            <span class="admin-stat-icon">
                <i class="bi bi-people-fill"></i>
            </span>

            <span class="admin-stat-trend positive">
                <i class="bi bi-person-check"></i>
                Đang hoạt động
            </span>
        </div>

        <span class="admin-stat-label">Tổng khách hàng</span>

        <strong class="admin-stat-value">@Model.TotalCustomers</strong>

        <div class="admin-stat-footer">
            <span>
                Nhân sự:
                <b>@Model.TotalEmployees người</b>
            </span>
            <i class="bi bi-arrow-up-right"></i>
        </div>
    </a>
</section>

<section class="admin-today-strip" aria-labelledby="todayActivityTitle">
    <div class="admin-today-heading">
        <span class="admin-today-icon">
            <i class="bi bi-sun-fill"></i>
        </span>

        <div>
            <strong id="todayActivityTitle">Hoạt động hôm nay</strong>
            <small>Cập nhật theo dữ liệu hiện có</small>
        </div>
    </div>

    <div class="admin-today-items">
        <a asp-controller="Bookings"
           asp-action="Index"
           class="admin-today-item">
            <span class="today-item-icon today-checkin">
                <i class="bi bi-box-arrow-in-right"></i>
            </span>
            <div>
                <strong>@Model.CheckInsToday</strong>
                <small>Nhận phòng hôm nay</small>
            </div>
            <i class="bi bi-chevron-right admin-today-arrow"></i>
        </a>

        <a asp-controller="Bookings"
           asp-action="Index"
           class="admin-today-item">
            <span class="today-item-icon today-checkout">
                <i class="bi bi-box-arrow-right"></i>
            </span>
            <div>
                <strong>@Model.CheckOutsToday</strong>
                <small>Trả phòng hôm nay</small>
            </div>
            <i class="bi bi-chevron-right admin-today-arrow"></i>
        </a>

        <a asp-controller="Bookings"
           asp-action="Index"
           class="admin-today-item">
            <span class="today-item-icon today-pending">
                <i class="bi bi-hourglass-split"></i>
            </span>
            <div>
                <strong>@Model.PendingBookings</strong>
                <small>Booking chờ xử lý</small>
            </div>
            <i class="bi bi-chevron-right admin-today-arrow"></i>
        </a>

        <a asp-controller="Rooms"
           asp-action="Index"
           class="admin-today-item">
            <span class="today-item-icon today-maintenance">
                <i class="bi bi-tools"></i>
            </span>
            <div>
                <strong>@Model.MaintenanceRooms</strong>
                <small>Phòng đang bảo trì</small>
            </div>
            <i class="bi bi-chevron-right admin-today-arrow"></i>
        </a>
    </div>
</section>

<section class="admin-dashboard-insights-grid">
    <article class="admin-panel admin-revenue-panel">
        <div class="admin-panel-header">
            <div>
                <span>Phân tích doanh thu</span>
                <h3>Doanh thu 7 ngày gần nhất</h3>
            </div>

            <div class="admin-panel-summary">
                <small>Doanh thu dịch vụ tháng</small>
                <strong>@Model.ServiceRevenueThisMonth.ToString("N0") VNĐ</strong>
            </div>
        </div>

        <div class="admin-chart-container admin-revenue-chart">
            <canvas id="adminRevenueChart"
                    role="img"
                    aria-label="Biểu đồ doanh thu 7 ngày gần nhất"></canvas>
        </div>
    </article>

    <article class="admin-panel admin-room-panel">
        <div class="admin-panel-header">
            <div>
                <span>Tình trạng phòng</span>
                <h3>Cơ cấu sử dụng phòng</h3>
            </div>
        </div>

        <div class="admin-chart-container admin-room-chart">
            <canvas id="adminRoomChart"
                    role="img"
                    aria-label="Biểu đồ tình trạng phòng"></canvas>
        </div>

        <div class="admin-room-legend">
            <div>
                <span class="legend-dot available"></span>
                <div>
                    <small>Còn trống</small>
                    <strong>@Model.AvailableRooms</strong>
                    <span>@availableRate.ToString("0.0")%</span>
                </div>
            </div>

            <div>
                <span class="legend-dot occupied"></span>
                <div>
                    <small>Đang có khách</small>
                    <strong>@Model.OccupiedRooms</strong>
                    <span>@occupancyRate.ToString("0.0")%</span>
                </div>
            </div>

            <div>
                <span class="legend-dot maintenance"></span>
                <div>
                    <small>Bảo trì</small>
                    <strong>@Model.MaintenanceRooms</strong>
                    <span>@maintenanceRate.ToString("0.0")%</span>
                </div>
            </div>
        </div>
    </article>
</section>

<section class="admin-dashboard-bottom-grid">
    <article class="admin-panel admin-quick-panel">
        <div class="admin-panel-header">
            <div>
                <span>Truy cập nhanh</span>
                <h3>Thao tác quản trị</h3>
            </div>
        </div>

        <div class="admin-quick-actions">
            <a asp-controller="Bookings"
               asp-action="Index"
               class="admin-quick-action">
                <span class="quick-action-icon booking">
                    <i class="bi bi-calendar-plus"></i>
                </span>
                <div>
                    <strong>Quản lý Booking</strong>
                    <small>Xác nhận, Check In và Check Out</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>

            <a asp-controller="Rooms"
               asp-action="Create"
               class="admin-quick-action">
                <span class="quick-action-icon room">
                    <i class="bi bi-door-open"></i>
                </span>
                <div>
                    <strong>Thêm phòng mới</strong>
                    <small>Cập nhật kho phòng khách sạn</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>

            <a asp-controller="Employees"
               asp-action="Create"
               class="admin-quick-action">
                <span class="quick-action-icon employee">
                    <i class="bi bi-person-plus"></i>
                </span>
                <div>
                    <strong>Thêm nhân viên</strong>
                    <small>Quản lý nhân sự khách sạn</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>

            <a asp-controller="Invoices"
               asp-action="Index"
               class="admin-quick-action">
                <span class="quick-action-icon invoice">
                    <i class="bi bi-receipt"></i>
                </span>
                <div>
                    <strong>Kiểm tra hóa đơn</strong>
                    <small>Doanh thu và thanh toán</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </article>

    <article class="admin-panel admin-booking-panel">
        <div class="admin-panel-header">
            <div>
                <span>Hoạt động mới nhất</span>
                <h3>Booking gần đây</h3>
            </div>

            <a asp-controller="Bookings"
               asp-action="Index"
               class="admin-panel-link">
                Xem tất cả
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="table-responsive admin-dashboard-table-wrap">
            <table class="table admin-dashboard-table align-middle">
                <thead>
                    <tr>
                        <th>Mã Booking</th>
                        <th>Khách hàng</th>
                        <th>Phòng</th>
                        <th>Nhận phòng</th>
                        <th>Trạng thái</th>
                        <th><span class="visually-hidden">Thao tác</span></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.RecentBookings != null &&
                         Model.RecentBookings.Any())
                    {
                        foreach (var booking in Model.RecentBookings)
                        {
                            <tr>
                                <td>
                                    <strong class="admin-booking-code">
                                        @booking.BookingCode
                                    </strong>
                                    <small>
                                        @booking.BookingDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>

                                <td>
                                    <div class="admin-customer-cell">
                                        <span class="admin-customer-avatar">
                                            @Initial(booking.Customer?.FullName)
                                        </span>

                                        <div>
                                            <strong>
                                                @(booking.Customer?.FullName
                                                    ?? "Không xác định")
                                            </strong>
                                            <small>
                                                @(booking.Customer?.Phone
                                                    ?? "Chưa có SĐT")
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="admin-room-list">
                                        <i class="bi bi-door-closed"></i>
                                        @RoomList(booking)
                                    </span>
                                </td>

                                <td>
                                    <span class="admin-checkin-date">
                                        <i class="bi bi-calendar3"></i>
                                        @booking.CheckInDate.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="admin-status-badge @BookingStatusClass(booking.Status)">
                                        @BookingStatusText(booking.Status)
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Bookings"
                                       asp-action="Details"
                                       asp-route-id="@booking.Id"
                                       class="admin-table-action"
                                       title="Xem chi tiết"
                                       aria-label="Xem chi tiết booking @booking.BookingCode">
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="admin-empty-state">
                                    <i class="bi bi-calendar-x"></i>
                                    <strong>Chưa có Booking</strong>
                                    <span>Booking mới sẽ xuất hiện tại đây.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const revenueLabels =
                @Html.Raw(JsonSerializer.Serialize(Model.RevenueLabels));

            const revenueValues =
                @Html.Raw(JsonSerializer.Serialize(Model.RevenueValues));

            const roomValues = [
                @Model.AvailableRooms,
                @Model.OccupiedRooms,
                @Model.MaintenanceRooms
            ];

            const bodyStyles = getComputedStyle(document.body);
            const luxuryBlue =
                bodyStyles.getPropertyValue("--dashboard-blue").trim() || "#2f7395";
            const luxuryNavy =
                bodyStyles.getPropertyValue("--dashboard-navy").trim() || "#123d55";
            const luxuryGold =
                bodyStyles.getPropertyValue("--dashboard-gold").trim() || "#c9a96e";
            const luxuryGreen = "#3b9b7a";
            const luxuryWarning = "#d9a24a";
            const mutedText = "#7d919c";
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            Chart.defaults.font.family = "Poppins, DM Sans, sans-serif";
            Chart.defaults.color = mutedText;

            const revenueCanvas = document.getElementById("adminRevenueChart");

            if (revenueCanvas && window.Chart) {
                const revenueContext = revenueCanvas.getContext("2d");
                const revenueGradient = revenueContext.createLinearGradient(0, 0, 0, 330);
                revenueGradient.addColorStop(0, "rgba(47, 115, 149, 0.28)");
                revenueGradient.addColorStop(1, "rgba(47, 115, 149, 0.01)");

                new Chart(revenueCanvas, {
                    type: "line",
                    data: {
                        labels: revenueLabels,
                        datasets: [
                            {
                                label: "Doanh thu",
                                data: revenueValues,
                                borderColor: luxuryBlue,
                                backgroundColor: revenueGradient,
                                pointBackgroundColor: "#ffffff",
                                pointBorderColor: luxuryBlue,
                                pointBorderWidth: 3,
                                pointRadius: 4,
                                pointHoverRadius: 7,
                                borderWidth: 3,
                                fill: true,
                                tension: 0.38
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: reducedMotion ? false : {
                            duration: 850,
                            easing: "easeOutQuart"
                        },
                        interaction: {
                            intersect: false,
                            mode: "index"
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: luxuryNavy,
                                titleColor: "#ffffff",
                                bodyColor: "#ffffff",
                                borderColor: "rgba(201, 169, 110, 0.45)",
                                borderWidth: 1,
                                padding: 13,
                                displayColors: false,
                                callbacks: {
                                    label: function (context) {
                                        return new Intl.NumberFormat("vi-VN").format(
                                            context.parsed.y
                                        ) + " VNĐ";
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    color: mutedText,
                                    font: {
                                        size: 11,
                                        weight: "500"
                                    }
                                },
                                border: {
                                    display: false
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: "rgba(23, 56, 76, 0.075)",
                                    drawTicks: false
                                },
                                ticks: {
                                    color: mutedText,
                                    padding: 10,
                                    callback: function (value) {
                                        if (value >= 1000000) {
                                            return (
                                                value / 1000000
                                            ).toLocaleString("vi-VN") + "tr";
                                        }

                                        if (value >= 1000) {
                                            return (
                                                value / 1000
                                            ).toLocaleString("vi-VN") + "k";
                                        }

                                        return value;
                                    }
                                },
                                border: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }

            const roomCanvas = document.getElementById("adminRoomChart");

            if (roomCanvas && window.Chart) {
                const centerTextPlugin = {
                    id: "roomCenterText",
                    afterDraw(chart) {
                        const { ctx, chartArea } = chart;

                        if (!chartArea) {
                            return;
                        }

                        const centerX = (chartArea.left + chartArea.right) / 2;
                        const centerY = (chartArea.top + chartArea.bottom) / 2;

                        ctx.save();
                        ctx.textAlign = "center";
                        ctx.textBaseline = "middle";
                        ctx.fillStyle = luxuryNavy;
                        ctx.font = "700 25px Poppins";
                        ctx.fillText("@occupancyRateText%", centerX, centerY - 7);
                        ctx.fillStyle = mutedText;
                        ctx.font = "500 10px Poppins";
                        ctx.fillText("CÔNG SUẤT", centerX, centerY + 17);
                        ctx.restore();
                    }
                };

                new Chart(roomCanvas, {
                    type: "doughnut",
                    plugins: [centerTextPlugin],
                    data: {
                        labels: [
                            "Còn trống",
                            "Đang có khách",
                            "Bảo trì"
                        ],
                        datasets: [
                            {
                                data: roomValues,
                                backgroundColor: [
                                    luxuryGreen,
                                    luxuryBlue,
                                    luxuryWarning
                                ],
                                borderColor: "#ffffff",
                                borderWidth: 5,
                                hoverOffset: 7
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "72%",
                        animation: reducedMotion ? false : {
                            duration: 850,
                            easing: "easeOutQuart"
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: luxuryNavy,
                                titleColor: "#ffffff",
                                bodyColor: "#ffffff",
                                borderColor: "rgba(201, 169, 110, 0.45)",
                                borderWidth: 1,
                                padding: 12,
                                callbacks: {
                                    label: function (context) {
                                        return context.label + ": " + context.parsed + " phòng";
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
