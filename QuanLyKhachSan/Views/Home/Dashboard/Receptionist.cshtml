@model QuanLyKhachSan.ViewModels.Dashboard.DashboardViewModel

@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models

@{
    Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";

    ViewData["Title"] = "Tổng quan lễ tân";

    string receptionistName =
        Model.FullName
        ?? User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "Lễ tân";

    double occupancyRate =
        Model.TotalRooms > 0
            ? (double)Model.OccupiedRooms /
              Model.TotalRooms * 100
            : 0;

    string Initial(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "K"
            : value.Trim()
                .Substring(0, 1)
                .ToUpper();
    }

    string StatusText(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending =>
                "Chờ xác nhận",

            BookingStatus.Confirmed =>
                "Đã xác nhận",

            BookingStatus.CheckedIn =>
                "Đang lưu trú",

            BookingStatus.CheckedOut =>
                "Đã trả phòng",

            BookingStatus.Cancelled =>
                "Đã hủy",

            _ => status.ToString()
        };
    }

    string StatusClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Pending =>
                "reception-status-pending",

            BookingStatus.Confirmed =>
                "reception-status-confirmed",

            BookingStatus.CheckedIn =>
                "reception-status-checkedin",

            BookingStatus.CheckedOut =>
                "reception-status-checkedout",

            BookingStatus.Cancelled =>
                "reception-status-cancelled",

            _ => string.Empty
        };
    }

    string RoomNumbers(Booking booking)
    {
        if (booking.BookingDetails == null ||
            !booking.BookingDetails.Any())
        {
            return "Chưa xếp phòng";
        }

        List<string> roomNumbers =
            booking.BookingDetails
                .Where(detail =>
                    !detail.IsDeleted &&
                    detail.Room != null)
                .Select(detail =>
                    detail.Room!.RoomNumber)
                .Distinct()
                .ToList();

        return roomNumbers.Any()
            ? string.Join(", ", roomNumbers)
            : "Chưa xếp phòng";
    }
}

<!-- =====================================================
     TIÊU ĐỀ
     ===================================================== -->
<section class="reception-dashboard-heading">

    <div>

        <span class="reception-dashboard-kicker">
            Bảng điều khiển
        </span>

        <h2>
            Chào mừng trở lại, @receptionistName
        </h2>

        <p>
            Theo dõi Booking, tình trạng phòng,
            khách nhận phòng và trả phòng trong ngày.
        </p>

    </div>

    <div class="reception-dashboard-actions">

        <a asp-controller="Bookings"
           asp-action="Index"
           class="reception-outline-action">

            <i class="bi bi-calendar2-check"></i>
            Quản lý Booking

        </a>

        <a asp-controller="Rooms"
           asp-action="Index"
           class="reception-primary-action">

            <i class="bi bi-door-open"></i>
            Phòng trống

        </a>

    </div>

</section>

<!-- =====================================================
     THẺ THỐNG KÊ
     ===================================================== -->
<section class="row g-4 mb-4">

    <!-- Tổng Booking -->
    <div class="col-xl-3 col-md-6">

        <a asp-controller="Bookings"
           asp-action="Index"
           class="reception-stat-card reception-stat-booking">

            <div class="reception-stat-top">

                <span class="reception-stat-icon">
                    <i class="bi bi-calendar2-week-fill"></i>
                </span>

                <span class="reception-stat-tag">
                    @Model.PendingBookings chờ xử lý
                </span>

            </div>

            <span class="reception-stat-label">
                Tổng Booking
            </span>

            <strong class="reception-stat-value">
                @Model.TotalBookings
            </strong>

            <div class="reception-stat-footer">

                <span>
                    Đã xác nhận:
                    <b>@Model.ConfirmedBookings</b>
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>

    </div>

    <!-- Phòng trống -->
    <div class="col-xl-3 col-md-6">

        <a asp-controller="Rooms"
           asp-action="Index"
           class="reception-stat-card reception-stat-available">

            <div class="reception-stat-top">

                <span class="reception-stat-icon">
                    <i class="bi bi-door-open-fill"></i>
                </span>

                <span class="reception-stat-tag success">
                    Sẵn sàng
                </span>

            </div>

            <span class="reception-stat-label">
                Phòng còn trống
            </span>

            <strong class="reception-stat-value">
                @Model.AvailableRooms
            </strong>

            <div class="reception-stat-footer">

                <span>
                    Tổng cộng:
                    <b>@Model.TotalRooms phòng</b>
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>

    </div>

    <!-- Đang có khách -->
    <div class="col-xl-3 col-md-6">

        <a asp-controller="Rooms"
           asp-action="Index"
           class="reception-stat-card reception-stat-occupied">

            <div class="reception-stat-top">

                <span class="reception-stat-icon">
                    <i class="bi bi-person-check-fill"></i>
                </span>

                <span class="reception-stat-tag">
                    @occupancyRate.ToString("0.0")% sử dụng
                </span>

            </div>

            <span class="reception-stat-label">
                Phòng đang có khách
            </span>

            <strong class="reception-stat-value">
                @Model.OccupiedRooms
            </strong>

            <div class="reception-stat-footer">

                <span>
                    Đang được sử dụng
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>

    </div>

    <!-- Bảo trì -->
    <div class="col-xl-3 col-md-6">

        <a asp-controller="Rooms"
           asp-action="Index"
           class="reception-stat-card reception-stat-maintenance">

            <div class="reception-stat-top">

                <span class="reception-stat-icon">
                    <i class="bi bi-tools"></i>
                </span>

                <span class="reception-stat-tag danger">
                    Cần theo dõi
                </span>

            </div>

            <span class="reception-stat-label">
                Phòng đang bảo trì
            </span>

            <strong class="reception-stat-value">
                @Model.MaintenanceRooms
            </strong>

            <div class="reception-stat-footer">

                <span>
                    Chưa thể sử dụng
                </span>

                <i class="bi bi-arrow-up-right"></i>

            </div>

        </a>

    </div>

</section>

<!-- =====================================================
     HOẠT ĐỘNG HÔM NAY
     ===================================================== -->
<section class="reception-today-strip mb-4">

    <div class="reception-today-heading">

        <span class="reception-today-main-icon">
            <i class="bi bi-sun-fill"></i>
        </span>

        <div>

            <strong>
                Hoạt động hôm nay
            </strong>

            <small>
                Cập nhật theo dữ liệu hiện có
            </small>

        </div>

    </div>

    <div class="reception-today-list">

        <a asp-controller="Bookings"
           asp-action="Index"
           class="reception-today-item">

            <span class="today-icon today-checkin">
                <i class="bi bi-box-arrow-in-right"></i>
            </span>

            <div>

                <strong>
                    @Model.CheckInsToday
                </strong>

                <small>
                    Nhận phòng hôm nay
                </small>

            </div>

        </a>

        <a asp-controller="Bookings"
           asp-action="Index"
           class="reception-today-item">

            <span class="today-icon today-checkout">
                <i class="bi bi-box-arrow-right"></i>
            </span>

            <div>

                <strong>
                    @Model.CheckOutsToday
                </strong>

                <small>
                    Trả phòng hôm nay
                </small>

            </div>

        </a>

        <a asp-controller="Bookings"
           asp-action="Index"
           class="reception-today-item">

            <span class="today-icon today-pending">
                <i class="bi bi-hourglass-split"></i>
            </span>

            <div>

                <strong>
                    @Model.PendingBookings
                </strong>

                <small>
                    Booking chờ xử lý
                </small>

            </div>

        </a>

        <a asp-controller="Rooms"
           asp-action="Index"
           class="reception-today-item">

            <span class="today-icon today-room">
                <i class="bi bi-door-open-fill"></i>
            </span>

            <div>

                <strong>
                    @Model.AvailableRooms
                </strong>

                <small>
                    Phòng sẵn sàng
                </small>

            </div>

        </a>

    </div>

</section>

<!-- =====================================================
     PHÒNG TRỐNG
     ===================================================== -->
<section class="reception-panel mb-4">

    <div class="reception-panel-header">

        <div>

            <span>
                Tình trạng phòng
            </span>

            <h3>
                Phòng trống hiện tại
            </h3>

        </div>

        <a asp-controller="Rooms"
           asp-action="Index"
           class="reception-panel-link">

            Xem tất cả
            <i class="bi bi-arrow-right"></i>

        </a>

    </div>

    @if (Model.AvailableRoomList != null &&
         Model.AvailableRoomList.Any())
    {
        <div class="reception-room-grid">

            @foreach (Room room in Model.AvailableRoomList)
            {
                <a asp-controller="Rooms"
                   asp-action="Details"
                   asp-route-id="@room.Id"
                   class="reception-room-card">

                    <div class="reception-room-card-top">

                        <span class="reception-room-number">
                            @room.RoomNumber
                        </span>

                        <span class="reception-room-status">
                            <i class="bi bi-check-circle-fill"></i>
                            Còn trống
                        </span>

                    </div>

                    <div class="reception-room-type">

                        <i class="bi bi-house-door"></i>

                        @(room.RoomType?.Name
                            ?? "Chưa xác định")

                    </div>

                    <div class="reception-room-info">

                        <span>

                            <i class="bi bi-building"></i>
                            Tầng @room.Floor

                        </span>

                        <span>

                            <i class="bi bi-people"></i>
                            @room.MaxOccupancy người

                        </span>

                    </div>

                    <div class="reception-room-footer">

                        <strong>
                            @room.PriceDay.ToString("N0")
                            <small>VNĐ/ngày</small>
                        </strong>

                        <i class="bi bi-arrow-up-right"></i>

                    </div>

                </a>
            }

        </div>
    }
    else
    {
        <div class="reception-empty-state">

            <i class="bi bi-door-closed"></i>

            <strong>
                Không còn phòng trống
            </strong>

            <span>
                Hiện tại tất cả phòng đang được sử dụng
                hoặc đang bảo trì.
            </span>

        </div>
    }

</section>

<!-- =====================================================
     THAO TÁC NHANH VÀ BOOKING GẦN ĐÂY
     ===================================================== -->
<section class="row g-4">

    <div class="col-xl-4">

        <article class="reception-panel h-100">

            <div class="reception-panel-header">

                <div>

                    <span>
                        Truy cập nhanh
                    </span>

                    <h3>
                        Thao tác lễ tân
                    </h3>

                </div>

            </div>

            <div class="reception-quick-list">

                <a asp-controller="Bookings"
                   asp-action="Index"
                   class="reception-quick-item">

                    <span class="quick-icon booking">
                        <i class="bi bi-calendar-plus"></i>
                    </span>

                    <div>

                        <strong>
                            Quản lý Booking
                        </strong>

                        <small>
                            Xác nhận, Check In, Check Out
                        </small>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>

                <a asp-controller="Rooms"
                   asp-action="Index"
                   class="reception-quick-item">

                    <span class="quick-icon room">
                        <i class="bi bi-door-open"></i>
                    </span>

                    <div>

                        <strong>
                            Tình trạng phòng
                        </strong>

                        <small>
                            Xem phòng trống và phòng có khách
                        </small>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>

                <a asp-controller="ServiceBookings"
                   asp-action="Index"
                   class="reception-quick-item">

                    <span class="quick-icon service">
                        <i class="bi bi-bag-check"></i>
                    </span>

                    <div>

                        <strong>
                            Dịch vụ đã đặt
                        </strong>

                        <small>
                            Xử lý yêu cầu dịch vụ của khách
                        </small>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="reception-quick-item">

                    <span class="quick-icon invoice">
                        <i class="bi bi-receipt"></i>
                    </span>

                    <div>

                        <strong>
                            Hóa đơn và thanh toán
                        </strong>

                        <small>
                            Kiểm tra và xử lý thanh toán
                        </small>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>

            </div>

        </article>

    </div>

    <div class="col-xl-8">

        <article class="reception-panel h-100">

            <div class="reception-panel-header">

                <div>

                    <span>
                        Hoạt động mới nhất
                    </span>

                    <h3>
                        Booking gần đây
                    </h3>

                </div>

                <a asp-controller="Bookings"
                   asp-action="Index"
                   class="reception-panel-link">

                    Xem tất cả
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

            <div class="table-responsive">

                <table class="table reception-booking-table
                    align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="ps-4">
                                Mã Booking
                            </th>

                            <th>
                                Khách hàng
                            </th>

                            <th>
                                Phòng
                            </th>

                            <th>
                                Nhận phòng
                            </th>

                            <th>
                                Trạng thái
                            </th>

                            <th class="pe-4"></th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.RecentBookings != null &&
                             Model.RecentBookings.Any())
                        {
                            foreach (Booking booking
                                     in Model.RecentBookings)
                            {
                                string customerName =
                                    booking.Customer?.FullName
                                    ?? "Không xác định";

                                <tr>

                                    <td class="ps-4">

                                        <strong class="reception-booking-code">
                                            @booking.BookingCode
                                        </strong>

                                        <small class="d-block text-muted">
                                            @booking.BookingDate
                                            .ToString("dd/MM/yyyy HH:mm")
                                        </small>

                                    </td>

                                    <td>

                                        <div class="reception-customer-cell">

                                            <span>
                                                @Initial(customerName)
                                            </span>

                                            <div>

                                                <strong>
                                                    @customerName
                                                </strong>

                                                <small>
                                                    @(booking.Customer?.Phone
                                                        ?? "Chưa có SĐT")
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="reception-room-badge">
                                            @RoomNumbers(booking)
                                        </span>

                                    </td>

                                    <td>

                                        @booking.CheckInDate
                                        .ToString("dd/MM/yyyy")

                                    </td>

                                    <td>

                                        <span class="reception-booking-status
                                            @StatusClass(
                                                  booking.Status)">

                                            @StatusText(booking.Status)

                                        </span>

                                    </td>

                                    <td class="text-end pe-4">

                                        <a asp-controller="Bookings"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="reception-table-button"
                                           title="Xem chi tiết">

                                            <i class="bi bi-arrow-up-right"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="reception-empty-state">

                                        <i class="bi bi-calendar-x"></i>

                                        <strong>
                                            Chưa có Booking
                                        </strong>

                                        <span>
                                            Booking mới sẽ xuất hiện tại đây.
                                        </span>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </article>

    </div>

</section>

@section Styles
{
    <style>
        .reception-dashboard-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 28px;
        }

        .reception-dashboard-kicker {
            color: #b58a42;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .reception-dashboard-heading h2 {
            margin: 8px 0;
            color: #242834;
            font-family: "Playfair Display", serif;
            font-size: clamp(28px, 3vw, 38px);
            font-weight: 700;
        }

        .reception-dashboard-heading p {
            max-width: 730px;
            margin: 0;
            color: #838897;
            line-height: 1.7;
        }

        .reception-dashboard-actions {
            display: flex;
            gap: 10px;
        }

        .reception-outline-action,
        .reception-primary-action {
            min-height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 17px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
        }

        .reception-outline-action {
            border: 1px solid #e8e9ee;
            background: #ffffff;
            color: #555b69;
        }

        .reception-primary-action {
            border: 1px solid #b58a42;
            background: linear-gradient(
                135deg,
                #c49a51,
                #8f692f
            );
            color: #ffffff;
            box-shadow:
                0 10px 23px rgba(181, 138, 66, 0.2);
        }

        .reception-primary-action:hover {
            color: #ffffff;
        }

        .reception-stat-card {
            position: relative;
            min-height: 205px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 22px;
            border: 1px solid #e8e9ee;
            border-radius: 18px;
            background: #ffffff;
            color: #242834;
            box-shadow:
                0 18px 45px rgba(34, 38, 51, 0.07);
            transition: 0.3s ease;
        }

        .reception-stat-card:hover {
            color: #242834;
            transform: translateY(-5px);
        }

        .reception-stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 20px;
        }

        .reception-stat-icon {
            width: 49px;
            height: 49px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            font-size: 21px;
        }

        .reception-stat-booking .reception-stat-icon {
            background: #eaf0ff;
            color: #4f6fd8;
        }

        .reception-stat-available .reception-stat-icon {
            background: #e4f7ef;
            color: #27875e;
        }

        .reception-stat-occupied .reception-stat-icon {
            background: #f0ebff;
            color: #8567d4;
        }

        .reception-stat-maintenance .reception-stat-icon {
            background: #fde9eb;
            color: #cf535d;
        }

        .reception-stat-tag {
            padding: 6px 9px;
            border-radius: 20px;
            background: #f0f1f5;
            color: #747987;
            font-size: 10px;
            font-weight: 700;
        }

        .reception-stat-tag.success {
            background: #e7f7ef;
            color: #25885e;
        }

        .reception-stat-tag.danger {
            background: #fde9eb;
            color: #c34c55;
        }

        .reception-stat-label {
            color: #838897;
            font-size: 12px;
            font-weight: 600;
        }

        .reception-stat-value {
            margin: 5px 0 18px;
            color: #242833;
            font-size: 36px;
            font-weight: 800;
        }

        .reception-stat-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: auto;
            padding-top: 15px;
            border-top: 1px solid #eeeef2;
            color: #838897;
            font-size: 11px;
        }

        .reception-today-strip {
            display: flex;
            gap: 20px;
            padding: 18px 20px;
            border: 1px solid #e8e9ee;
            border-radius: 18px;
            background: #ffffff;
            box-shadow:
                0 18px 45px rgba(34, 38, 51, 0.07);
        }

        .reception-today-heading {
            min-width: 220px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding-right: 20px;
            border-right: 1px solid #e8e9ee;
        }

        .reception-today-main-icon {
            width: 46px;
            height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #fff4d8;
            color: #d29522;
            font-size: 20px;
        }

        .reception-today-heading div,
        .reception-today-item div {
            display: flex;
            flex-direction: column;
        }

        .reception-today-heading small,
        .reception-today-item small {
            color: #838897;
            font-size: 10px;
        }

        .reception-today-list {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .reception-today-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 8px 10px;
            border-radius: 12px;
            color: #242834;
        }

        .reception-today-item:hover {
            background: #f8f8fa;
            color: #242834;
        }

        .today-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
        }

        .today-checkin {
            background: #e5f6ef;
            color: #29895f;
        }

        .today-checkout {
            background: #eaf0ff;
            color: #4f6fd8;
        }

        .today-pending {
            background: #fff3df;
            color: #d38d20;
        }

        .today-room {
            background: #f0ebff;
            color: #8567d4;
        }

        .reception-today-item strong {
            font-size: 20px;
        }

        .reception-panel {
