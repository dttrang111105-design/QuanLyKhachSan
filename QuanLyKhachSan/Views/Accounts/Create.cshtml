@model QuanLyKhachSan.Models.Account
@using QuanLyKhachSan.Enums

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm tài khoản";
}

<section class="account-form-heading">
    <div>
        <span>Quản trị hệ thống</span>
        <h2>Thêm tài khoản</h2>
        <p>Tạo tài khoản đăng nhập mới và phân quyền sử dụng hệ thống.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</section>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card account-form-card">
            <div class="card-header">
                <div class="account-form-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h4>Thông tin tài khoản</h4>
                    <p>Nhập thông tin đăng nhập và vai trò của tài khoản.</p>
                </div>
            </div>

            <form asp-controller="Accounts" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                            <div class="account-input-group">
                                <i class="bi bi-person"></i>
                                <input asp-for="Username" class="form-control" placeholder="Ví dụ: recep02" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PasswordHash" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                            <div class="account-input-group">
                                <i class="bi bi-lock"></i>
                                <input asp-for="PasswordHash" type="password" class="form-control password-input" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                                <button type="button" class="password-toggle" aria-label="Hiện mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <div class="account-input-group">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="Email" type="email" class="form-control" placeholder="example@hotel.com" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                            <div class="account-input-group">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxx" autocomplete="off" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Role" class="form-label">Vai trò <span class="text-danger">*</span></label>
                            <div class="account-input-group">
                                <i class="bi bi-shield-check"></i>
                                <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                </select>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>

                            <div class="role-help mt-3">
                                <div><i class="bi bi-shield-lock-fill"></i><strong>Admin:</strong> Toàn quyền quản trị hệ thống.</div>
                                <div><i class="bi bi-person-badge-fill"></i><strong>Receptionist:</strong> Quản lý Booking, phòng, dịch vụ và hóa đơn.</div>
                                <div><i class="bi bi-person-fill"></i><strong>Customer:</strong> Đặt phòng và sử dụng chức năng khách hàng.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .account-form-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 26px;
        }

        .account-form-heading > div > span {
            color: #b58a42;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .account-form-heading h2 {
            margin: 6px 0;
            font-weight: 700;
        }

        .account-form-heading p,
        .account-form-card .card-header p {
            margin: 0;
            color: #838897;
        }

        .account-form-card {
            overflow: hidden;
            border: 1px solid #e8e9ee;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(34, 38, 51, 0.07);
        }

        .account-form-card .card-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 22px 24px;
            border-bottom: 1px solid #e8e9ee;
            background: #fff;
        }

        .account-form-card .card-header h4 {
            margin: 0 0 4px;
            font-weight: 700;
        }

        .account-form-icon {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #f4ead7;
            color: #8f692f;
            font-size: 20px;
        }

        .account-form-card .form-label {
            color: #4d5360;
            font-size: 13px;
            font-weight: 700;
        }

        .account-input-group {
            position: relative;
        }

        .account-input-group > i {
            position: absolute;
            top: 50%;
            left: 14px;
            z-index: 2;
            color: #9a9fab;
            transform: translateY(-50%);
        }

        .account-input-group .form-control,
        .account-input-group .form-select {
            min-height: 46px;
            padding-left: 42px;
            border-color: #e1e3e9;
            border-radius: 11px;
        }

        .account-input-group .password-input {
            padding-right: 45px;
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            z-index: 3;
            width: 35px;
            height: 35px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #858b97;
            transform: translateY(-50%);
        }

        .password-toggle:hover {
            background: #f4ead7;
            color: #8f692f;
        }

        .role-help {
            display: grid;
            gap: 8px;
            padding: 14px;
            border-radius: 12px;
            background: #f8f8fa;
            color: #6f7582;
            font-size: 11px;
        }

        .role-help div {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .role-help i {
            color: #b58a42;
        }

        .account-form-card .card-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 18px 24px;
            border-top: 1px solid #e8e9ee;
            background: #fff;
        }

        @@media (max-width: 767.98px) {
            .account-form-heading {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".password-toggle").forEach(function (button) {
                button.addEventListener("click", function () {
                    const input = button.parentElement.querySelector(".password-input");
                    const icon = button.querySelector("i");
                    const showPassword = input.type === "password";

                    input.type = showPassword ? "text" : "password";
                    icon.className = showPassword ? "bi bi-eye-slash" : "bi bi-eye";
                    button.setAttribute("aria-label", showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu");
                });
            });
        });
    </script>
}