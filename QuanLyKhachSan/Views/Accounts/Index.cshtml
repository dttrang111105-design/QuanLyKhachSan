                transform: translateY(-50%);
            }

            .account-search-box input {
                width: 285px;
                min-height: 42px;
                padding: 9px 13px 9px 38px;
                border: 1px solid #e1e3e9;
                border-radius: 11px;
                outline: none;
                font-size: 12px;
            }

        .account-filter-area .form-select {
            width: 170px;
            min-height: 42px;
            border-color: #e1e3e9;
            border-radius: 11px;
            font-size: 12px;
        }

            .account-search-box input:focus,
            .account-filter-area .form-select:focus {
                border-color: #b58a42;
                box-shadow: 0 0 0 3px rgba(181, 138, 66, 0.12);
            }

        .account-table thead th {
            padding: 14px 12px;
