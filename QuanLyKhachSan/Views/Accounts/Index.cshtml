@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const searchInput =
                    document.getElementById(
                        "accountSearch"
                    );

                const roleFilter =
                    document.getElementById(
                        "accountRoleFilter"
                    );

                const statusFilter =
                    document.getElementById(
                        "accountStatusFilter"
                    );

                const rows =
                    document.querySelectorAll(
                        ".account-row"
                    );

                const emptyState =
                    document.getElementById(
                        "accountFilterEmpty"
                    );

                function filterAccounts() {

                    const keyword =
                        searchInput?.value
                            .trim()
                            .toLowerCase()
                        ?? "";

                    const role =
                        roleFilter?.value
                        ?? "";

                    const status =
                        statusFilter?.value
                        ?? "";

                    let visibleCount = 0;

                    rows.forEach(function (row) {

                        const rowSearch =
                            row.dataset.search
                            ?? "";

                        const rowRole =
                            row.dataset.role
                            ?? "";

                        const rowStatus =
                            row.dataset.status
                            ?? "";

                        const keywordMatched =
                            !keyword ||
                            rowSearch.includes(keyword);

                        const roleMatched =
                            !role ||
                            rowRole === role;

                        const statusMatched =
                            !status ||
                            rowStatus === status;

                        const visible =
                            keywordMatched &&
                            roleMatched &&
                            statusMatched;

                        row.classList.toggle(
                            "d-none",
                            !visible
                        );

                        if (visible) {
                            visibleCount++;
                        }

                    });

                    if (emptyState) {
                        emptyState.classList.toggle(
                            "d-none",
                            visibleCount > 0
                        );
                    }
                }

                searchInput?.addEventListener(
                    "input",
                    filterAccounts
                );

                roleFilter?.addEventListener(
                    "change",
                    filterAccounts
                );

                statusFilter?.addEventListener(
                    "change",
                    filterAccounts
                );

            }
        );
    </script>
}