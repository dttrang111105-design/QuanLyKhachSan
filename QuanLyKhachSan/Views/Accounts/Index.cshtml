@model IEnumerable<QuanLyKhachSan.Models.Account>

@using QuanLyKhachSan.Models

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý tài khoản";

    List<Account> accounts =
        Model?.ToList() ?? new List<Account>();

    int totalAccounts = accounts.Count;

    int activeAccounts = accounts.Count(account =>
        account.IsActive);

    int inactiveAccounts = accounts.Count(account =>
        !account.IsActive);

    int adminAccounts = accounts.Count(account =>
        string.Equals(
            Convert.ToString(account.Role),
            "Admin",
            StringComparison.OrdinalIgnoreCase));

    int receptionistAccounts = accounts.Count(account =>
        string.Equals(
            Convert.ToString(account.Role),
            "Receptionist",
            StringComparison.OrdinalIgnoreCase));

    int customerAccounts = accounts.Count(account =>
        string.Equals(
            Convert.ToString(account.Role),
            "Customer",
            StringComparison.OrdinalIgnoreCase));

    List<string> roles = accounts
        .Select(account =>
            Convert.ToString(account.Role)?.Trim())
        .Where(role =>
            !string.IsNullOrWhiteSpace(role))
        .Select(role => role!)
        .Distinct()
        .OrderBy(role => role)
        .ToList();

    string RoleText(object? role)
    {
        string value =
            Convert.ToString(role)?.Trim()
            ?? string.Empty;

        return value.ToLowerInvariant() switch
        {
            "admin" => "Quản trị viên",
            "receptionist" => "Lễ tân",
            "customer" => "Khách hàng",
            "" => "Chưa xác định",
            _ => value
        };
    }

    string RoleIcon(object? role)
    {
        string value =
            Convert.ToString(role)?
                .Trim()
                .ToLowerInvariant()
            ?? string.Empty;

        return value switch
        {
            "admin" => "bi-shield-lock-fill",
            "receptionist" => "bi-person-badge-fill",
            "customer" => "bi-person-fill",
            _ => "bi-person-circle"
        };
    }

    string RoleClass(object? role)
    {
        string value =
            Convert.ToString(role)?
                .Trim()
                .ToLowerInvariant()
            ?? string.Empty;

        return value switch
        {
            "admin" => "account-role-admin",
            "receptionist" => "account-role-receptionist",
            "customer" => "account-role-customer",
            _ => "account-role-default"
        };
    }

    string AccountInitial(string? username)
    {
        return string.IsNullOrWhiteSpace(username)
            ? "A"
            : username.Trim()
                .Substring(0, 1)
                .ToUpperInvariant();
    }

    string ProfileName(Account account)
    {
        if (account.Employee != null &&
            !string.IsNullOrWhiteSpace(
                account.Employee.FullName))
        {
            return account.Employee.FullName;
        }

        if (account.Customer != null &&
            !string.IsNullOrWhiteSpace(
                account.Customer.FullName))
        {
            return account.Customer.FullName;
        }

        return "Chưa liên kết hồ sơ";
    }

    string ProfileType(Account account)
    {
        if (account.Employee != null)
        {
            return "Nhân viên";
        }

        if (account.Customer != null)
        {
            return "Khách hàng";
        }

        return "Chưa liên kết";
    }

    string LastLoginText(Account account)
    {
        object? value = account.LastLogin;

        if (value is DateTime date)
        {
            return date.ToString("dd/MM/yyyy HH:mm");
        }

        return "Chưa đăng nhập";
    }
}

<!-- =====================================================
     TIÊU ĐỀ
     ===================================================== -->
<section class="account-page-heading">

    <div>

        <span class="account-page-kicker">
            Quản trị hệ thống
        </span>

        <h2>
            Quản lý tài khoản
        </h2>

        <p>
            Quản lý thông tin đăng nhập, vai trò,
            trạng thái hoạt động và hồ sơ được liên kết.
        </p>

    </div>

    <div class="account-heading-actions">

        <a asp-controller="Employees"
           asp-action="Index"
           class="account-heading-button">

            <i class="bi bi-person-badge"></i>
            Nhân viên

        </a>

        <a asp-controller="Customers"
           asp-action="Index"
           class="account-heading-button">

            <i class="bi bi-people"></i>
            Khách hàng

        </a>

        <a asp-controller="Accounts"
           asp-action="Create"
           class="account-heading-button primary">

            <i class="bi bi-person-plus"></i>
            Thêm tài khoản

        </a>

    </div>

</section>

<!-- =====================================================
     THÔNG BÁO
     ===================================================== -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng">
        </button>

    </div>
}

<!-- =====================================================
     THỐNG KÊ
     ===================================================== -->
<div class="row g-4 mb-4">

    <!-- Tổng tài khoản -->
    <div class="col-xl-3 col-md-6">

        <div class="account-stat-card">

            <div class="account-stat-top">

                <span class="account-stat-icon blue">
                    <i class="bi bi-person-lock"></i>
                </span>

                <span class="account-stat-tag">
                    Tổng cộng
                </span>

            </div>

            <span class="account-stat-title">
                Tổng tài khoản
            </span>

            <strong class="account-stat-value">
                @totalAccounts
            </strong>

            <small>
                Tài khoản chưa bị xóa
            </small>

        </div>

    </div>

    <!-- Hoạt động -->
    <div class="col-xl-3 col-md-6">

        <div class="account-stat-card">

            <div class="account-stat-top">

                <span class="account-stat-icon green">
                    <i class="bi bi-person-check-fill"></i>
                </span>

                <span class="account-stat-tag">
                    Hoạt động
                </span>

            </div>

            <span class="account-stat-title">
                Đang hoạt động
            </span>

            <strong class="account-stat-value">
                @activeAccounts
            </strong>

            <small>
                @inactiveAccounts tài khoản đã khóa
            </small>

        </div>

    </div>

    <!-- Nhân sự -->
    <div class="col-xl-3 col-md-6">

        <div class="account-stat-card">

            <div class="account-stat-top">

                <span class="account-stat-icon gold">
                    <i class="bi bi-shield-check"></i>
                </span>

                <span class="account-stat-tag">
                    Nhân sự
                </span>

            </div>

            <span class="account-stat-title">
                Tài khoản quản trị
            </span>

            <strong class="account-stat-value">
                @(adminAccounts + receptionistAccounts)
            </strong>

            <small>
                @adminAccounts Admin ·
                @receptionistAccounts lễ tân
            </small>

        </div>

    </div>

    <!-- Khách hàng -->
    <div class="col-xl-3 col-md-6">

        <div class="account-stat-card">

            <div class="account-stat-top">

                <span class="account-stat-icon purple">
                    <i class="bi bi-people-fill"></i>
                </span>

                <span class="account-stat-tag">
                    Khách hàng
                </span>

            </div>

            <span class="account-stat-title">
                Tài khoản khách hàng
            </span>

            <strong class="account-stat-value">
                @customerAccounts
            </strong>

            <small>
                Dùng để đặt phòng và dịch vụ
            </small>

        </div>

    </div>

</div>

<!-- =====================================================
     DANH SÁCH TÀI KHOẢN
     ===================================================== -->
<div class="account-panel">

    <div class="account-panel-header">

        <div>

            <span class="account-page-kicker">
                Danh sách dữ liệu
            </span>

            <h3>
                Tài khoản hệ thống
            </h3>

            <p>
                Có @totalAccounts tài khoản được hiển thị.
            </p>

        </div>

        <div class="account-filter-area">

            <div class="account-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="accountSearch"
                       placeholder="Tìm username, email, SĐT, họ tên..." />

            </div>

            <select id="accountRoleFilter"
                    class="form-select">

                <option value="">
                    Tất cả vai trò
                </option>

                @foreach (string role in roles)
                {
                    <option value="@role">
                        @RoleText(role)
                    </option>
                }

            </select>

            <select id="accountStatusFilter"
                    class="form-select">

                <option value="">
                    Tất cả trạng thái
                </option>

                <option value="active">
                    Đang hoạt động
                </option>

                <option value="inactive">
                    Đã khóa
                </option>

            </select>

        </div>

    </div>

    @if (accounts.Any())
    {
        <div class="table-responsive">

            <table class="table account-table align-middle mb-0">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Tài khoản
                        </th>

                        <th>
                            Vai trò
                        </th>

                        <th>
                            Hồ sơ liên kết
                        </th>

                        <th>
                            Liên hệ
                        </th>

                        <th>
                            Trạng thái
                        </th>

                        <th>
                            Đăng nhập gần nhất
                        </th>

                        <th>
                            Ngày tạo
                        </th>

                        <th class="text-end pe-4">
                            Thao tác
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (Account account in accounts)
                    {
                        string status =
                            account.IsActive
                                ? "active"
                                : "inactive";

                        string role =
                            Convert.ToString(account.Role)
                            ?? string.Empty;

                        string profileName =
                            ProfileName(account);

                        bool isCurrentAccount =
                            string.Equals(
                                account.Username,
                                User.Identity?.Name,
                                StringComparison.OrdinalIgnoreCase);

                        string searchData =
                            $"{account.Username} " +
                            $"{account.Email} " +
                            $"{account.PhoneNumber} " +
                            $"{profileName} " +
                            $"{role}"
                                .ToLowerInvariant();

                        <tr class="account-row"
                            data-role="@role"
                            data-status="@status"
                            data-search="@searchData">

                            <!-- Tài khoản -->
                            <td class="ps-4">

                                <div class="account-name-cell">

                                    <span class="account-avatar">

                                        @AccountInitial(
                                            account.Username)

                                    </span>

                                    <div>

                                        <strong>
                                            @account.Username
                                        </strong>

                                        <small>
                                            Mã tài khoản:
                                            #@account.Id
                                        </small>

                                        @if (isCurrentAccount)
                                        {
                                            <span class="account-current-label">

                                                <i class="bi bi-check-circle-fill"></i>
                                                Tài khoản hiện tại

                                            </span>
                                        }

                                    </div>

                                </div>

                            </td>

                            <!-- Vai trò -->
                            <td>

                                <span class="account-role
                                    @RoleClass(account.Role)">

                                    <i class="bi
                                        @RoleIcon(account.Role)">
                                    </i>

                                    @RoleText(account.Role)

                                </span>

                            </td>

                            <!-- Hồ sơ -->
                            <td>

                                <div class="account-profile-cell">

                                    <strong>
                                        @profileName
                                    </strong>

                                    <small>
                                        <i class="bi bi-link-45deg"></i>
                                        @ProfileType(account)
                                    </small>

                                </div>

                            </td>

                            <!-- Liên hệ -->
                            <td>

                                <div class="account-contact-cell">

                                    <span title="@account.Email">

                                        <i class="bi bi-envelope"></i>

                                        @(string.IsNullOrWhiteSpace(
                                            account.Email)
                                            ? "Chưa có email"
                                            : account.Email)

                                    </span>

                                    <small>

                                        <i class="bi bi-telephone"></i>

                                        @(string.IsNullOrWhiteSpace(
                                            account.PhoneNumber)
                                            ? "Chưa có SĐT"
                                            : account.PhoneNumber)

                                    </small>

                                </div>

                            </td>

                            <!-- Trạng thái -->
                            <td>

                                @if (account.IsActive)
                                {
                                    <span class="account-status
                                        account-status-active">

                                        <i class="bi bi-check-circle-fill"></i>
                                        Đang hoạt động

                                    </span>
                                }
                                else
                                {
                                    <span class="account-status
                                        account-status-inactive">

                                        <i class="bi bi-lock-fill"></i>
                                        Đã khóa

                                    </span>
                                }

                            </td>

                            <!-- Lần đăng nhập cuối -->
                            <td>

                                <div class="account-login-cell">

                                    <i class="bi bi-clock-history"></i>

                                    <span>
                                        @LastLoginText(account)
                                    </span>

                                </div>

                            </td>

                            <!-- Ngày tạo -->
                            <td>

                                <div class="account-created-cell">

                                    <strong>
                                        @account.CreatedAt.ToString(
                                            "dd/MM/yyyy")
                                    </strong>

                                    <small>
                                        @account.CreatedAt.ToString(
                                            "HH:mm")
                                    </small>

                                </div>

                            </td>

                            <!-- Thao tác -->
                            <td class="text-end pe-4">

                                <div class="account-action-group">

                                    <a asp-controller="Accounts"
                                       asp-action="Details"
                                       asp-route-id="@account.Id"
                                       class="account-action view"
                                       title="Xem chi tiết">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-controller="Accounts"
                                       asp-action="Edit"
                                       asp-route-id="@account.Id"
                                       class="account-action edit"
                                       title="Chỉnh sửa">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    @if (!isCurrentAccount)
                                    {
                                        <a asp-controller="Accounts"
                                           asp-action="Delete"
                                           asp-route-id="@account.Id"
                                           class="account-action delete"
                                           title="Xóa tài khoản">

                                            <i class="bi bi-trash"></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div id="accountFilterEmpty"
             class="account-empty-state d-none">

            <i class="bi bi-search"></i>

            <h4>
                Không tìm thấy tài khoản
            </h4>

            <p>
                Hãy thử từ khóa, vai trò hoặc trạng thái khác.
            </p>

        </div>
    }
    else
    {
        <div class="account-empty-state">

            <i class="bi bi-person-lock"></i>

            <h4>
                Chưa có tài khoản
            </h4>

            <p>
                Hãy tạo tài khoản đầu tiên
                để bắt đầu quản trị hệ thống.
            </p>

            <a asp-controller="Accounts"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-person-plus me-1"></i>
                Thêm tài khoản đầu tiên

            </a>

        </div>
    }

</div>

@section Styles
{
    <style>
        .account-page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 26px;
        }

            .account-page-heading h2 {
                margin: 5px 0 7px;
                color: #252a35;
                font-weight: 700;
            }

            .account-page-heading p {
                margin: 0;
                color: #838897;
            }

        .account-page-kicker {
            color: #b58a42;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .account-heading-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .account-heading-button {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 16px;
            border: 1px solid #e1e3e9;
            border-radius: 11px;
            background: #ffffff;
            color: #555c69;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s ease;
        }

            .account-heading-button:hover {
                border-color: #b58a42;
                color: #8f692f;
                transform: translateY(-2px);
            }

            .account-heading-button.primary {
                border-color: #b58a42;
                background: linear-gradient( 135deg, #c49a51, #8f692f );
                color: #ffffff;
                box-shadow: 0 10px 23px rgba(181, 138, 66, 0.2);
            }

                .account-heading-button.primary:hover {
                    color: #ffffff;
                }

        .account-stat-card {
            height: 100%;
            padding: 21px;
            border: 1px solid #e8e9ee;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(34, 38, 51, 0.065);
        }

        .account-stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 17px;
        }

        .account-stat-icon {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            font-size: 21px;
        }

            .account-stat-icon.blue {
                background: #eaf0ff;
                color: #4f6fd8;
            }

            .account-stat-icon.green {
                background: #e4f7ef;
                color: #27875e;
            }

            .account-stat-icon.gold {
                background: #f4ead7;
                color: #8f692f;
            }

            .account-stat-icon.purple {
                background: #f0ebff;
                color: #8567d4;
            }

        .account-stat-tag {
            padding: 5px 9px;
            border-radius: 20px;
            background: #f3f4f7;
            color: #838897;
            font-size: 10px;
            font-weight: 700;
        }

        .account-stat-title {
            display: block;
            color: #838897;
            font-size: 12px;
            font-weight: 600;
        }

        .account-stat-value {
            display: block;
            margin: 5px 0 11px;
            color: #252a35;
            font-size: 32px;
            font-weight: 800;
