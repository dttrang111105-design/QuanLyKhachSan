        }

        .account-table tbody td {
            padding: 15px 12px;
            border-bottom: 1px solid #eff0f3;
            color: #555b68;
            font-size: 11px;
            vertical-align: middle;
        }

        .account-table tbody tr:hover {
            background: #fcfbf9;
        }

        .account-name-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .account-avatar {
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: #f4ead7;
            color: #8f692f;
            font-size: 16px;
            font-weight: 800;
        }

        .account-name-cell > div {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .account-name-cell strong {
            color: #343944;
            font-size: 12px;
        }

        .account-name-cell small {
            color: #9297a3;
            font-size: 9px;
        }

        .account-current-label {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 3px;
            color: #258459;
            font-size: 8px;
            font-weight: 700;
        }

        .account-role {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 9px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 700;
            white-space: nowrap;
        }

        .account-role-admin {
            background: #f0ebff;
            color: #8567d4;
        }

        .account-role-receptionist {
            background: #eaf0ff;
            color: #4f6fd8;
        }

        .account-role-customer {
            background: #e4f7ef;
            color: #27875e;
        }

        .account-role-default {
            background: #eceef2;
            color: #646b79;
        }

        .account-profile-cell,
        .account-contact-cell,
        .account-created-cell {
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 3px;
