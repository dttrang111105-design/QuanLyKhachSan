@model QuanLyKhachSan.ViewModels.Profile.ChangePasswordViewModel
@{
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (User.IsInRole("Receptionist"))
    {
        Layout = "~/Views/Shared/_ReceptionistLayout.cshtml";
    }
    else if (User.IsInRole("Customer"))
    {
        Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    ViewData["Title"] = "Đổi mật khẩu";
}
<div class="container py-4">
    <div class="mb-4">
        <a asp-controller="Profile"
           asp-action="Index"
           class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Quay lại hồ sơ
        </a>
    </div>
    <div class="row justify-content-center">
        <div class="col-xl-7 col-lg-8">
            <div class="card border-0 shadow-lg overflow-hidden">
                <div class="card-header border-0 text-white p-4"
                     style="background:linear-gradient(135deg,#121212,#3b2d18);">
                    <div class="d-flex align-items-center gap-3">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                              style="width:52px;height:52px;background:#c8a96a;color:#111;">
                            <i class="bi bi-shield-lock fs-4"></i>
                        </span>
                        <div>
                            <h3 class="mb-1">Đổi mật khẩu</h3>
                            <p class="mb-0 text-white-50">
                                Cập nhật mật khẩu để bảo vệ tài khoản của bạn
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <form asp-controller="Profile"
                          asp-action="ChangePassword"
                          method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>
                        <div class="mb-4">
                            <label asp-for="OldPassword"
                                   class="form-label fw-semibold">
                                Mật khẩu cũ
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="OldPassword"
                                       type="password"
                                       id="oldPassword"
                                       class="form-control"
                                       placeholder="Nhập mật khẩu hiện tại"
                                       autocomplete="current-password" />
                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle"
                                        data-target="oldPassword"
                                        aria-label="Hiện hoặc ẩn mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="OldPassword"
                                  class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                                Mật khẩu mới
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input asp-for="NewPassword"
                                       type="password"
                                       id="newPassword"
                                       class="form-control"
                                       placeholder="Nhập mật khẩu mới"
                                       autocomplete="new-password" />
                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle"
                                        data-target="newPassword"
                                        aria-label="Hiện hoặc ẩn mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword"
                                  class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Nhập lại mật khẩu mới
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       id="confirmPassword"
                                       class="form-control"
                                       placeholder="Nhập lại mật khẩu mới"
                                       autocomplete="new-password" />
                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle"
                                        data-target="confirmPassword"
                                        aria-label="Hiện hoặc ẩn mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>
                        <div class="alert alert-light border">
                            <div class="d-flex gap-2">
                                <i class="bi bi-info-circle text-warning"></i>
                                <small class="text-muted">
                                    Nên sử dụng mật khẩu có chữ hoa, chữ thường,
                                    chữ số và ký tự đặc biệt.
                                </small>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit"
                                    class="btn btn-warning px-4 py-2 fw-semibold">
                                <i class="bi bi-shield-check me-2"></i>
                                Đổi mật khẩu
                            </button>
                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="btn btn-secondary px-4 py-2">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll(".password-toggle")
            .forEach(function (button) {
                button.addEventListener("click", function () {
                    const input = document.getElementById(
                        button.dataset.target
                    );
                    if (!input) {
                        return;
                    }
                    const showPassword =
                        input.type === "password";
                    input.type =
                        showPassword ? "text" : "password";
                    const icon =
                        button.querySelector("i");
                    if (icon) {
                        icon.className =
                            showPassword
                                ? "bi bi-eye-slash"
                                : "bi bi-eye";
                    }
                });
            });
    </script>
}
