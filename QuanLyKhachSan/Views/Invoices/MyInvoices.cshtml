@using QuanLyKhachSan.Enums
@model IEnumerable<QuanLyKhachSan.Models.Invoice>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Hóa đơn của tôi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h2 class="mb-1">Hóa đơn của tôi</h2>
        <p class="text-muted mb-0">
            Xem lại tiền phòng, dịch vụ và trạng thái thanh toán.
        </p>
    </div>

    <a asp-controller="Bookings"
       asp-action="MyBookings"
       class="btn btn-outline-secondary mt-3 mt-md-0">
        Booking của tôi
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã hóa đơn</th>
                    <th>Mã Booking</th>
                    <th>Phòng</th>
                    <th>Ngày lập</th>
                    <th class="text-end">Tổng hóa đơn</th>
                    <th class="text-end">Tiền cọc</th>
                    <th class="text-end">Đã thanh toán</th>
                    <th class="text-end">Còn lại</th>
                    <th>Trạng thái</th>
                    <th style="min-width: 190px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    decimal amountAfterDeposit =
                        item.TotalAmount - (item.Booking?.Deposit ?? 0);

                    if (amountAfterDeposit < 0)
                    {
                        amountAfterDeposit = 0;
                    }

                    decimal paidAmount = item.Payments?
                        .Where(p =>
                            !p.IsDeleted &&
                            p.PaymentStatus == PaymentStatus.Paid)
                        .Sum(p => p.Amount) ?? 0;

                    decimal remainingAmount = amountAfterDeposit - paidAmount;

                    if (remainingAmount < 0)
                    {
                        remainingAmount = 0;
                    }

                    bool isPaid =
                        amountAfterDeposit == 0 ||
                        remainingAmount == 0;

                    string rooms =
                        item.Booking?.BookingDetails != null &&
                        item.Booking.BookingDetails.Any()
                            ? string.Join(
                                ", ",
                                item.Booking.BookingDetails
                                    .Where(d => !d.IsDeleted && d.Room != null)
                                    .Select(d => d.Room!.RoomNumber))
                            : "Không xác định";

                    <tr>
                        <td>
                            <strong>@item.InvoiceCode</strong>
                        </td>

                        <td>@item.Booking?.BookingCode</td>

                        <td>@rooms</td>

                        <td>
                            @item.InvoiceDate.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td class="text-end fw-semibold">
                            @item.TotalAmount.ToString("N0") VNĐ
                        </td>

                        <td class="text-end">
                            @((item.Booking?.Deposit ?? 0).ToString("N0")) VNĐ
                        </td>

                        <td class="text-end text-success fw-semibold">
                            @paidAmount.ToString("N0") VNĐ
                        </td>

                        <td class="text-end fw-bold @(remainingAmount > 0 ? "text-danger" : "text-success")">
                            @remainingAmount.ToString("N0") VNĐ
                        </td>

                        <td>
                            @if (isPaid)
                            {
                                <span class="badge bg-success">
                                    Đã thanh toán
                                </span>
                            }
                            else
                            {
                                var latestPayment = item.Payments?
                                    .Where(p => !p.IsDeleted)
                                    .OrderByDescending(p => p.PaymentDate)
                                    .FirstOrDefault();

                                if (latestPayment?.PaymentStatus ==
                                    PaymentStatus.Pending)
                                {
                                    <span class="badge bg-info text-dark">
                                        Đang xử lý
                                    </span>
                                }
                                else if (latestPayment?.PaymentStatus ==
                                         PaymentStatus.Failed)
                                {
                                    <span class="badge bg-danger">
                                        Thất bại
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Chưa thanh toán
                                    </span>
                                }
                            }
                        </td>

                        <td class="text-nowrap">
                            <a asp-action="MyDetails"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">
                                Xem hóa đơn
                            </a>

                            @if (!isPaid)
                            {
                                <a asp-controller="Payments"
                                   asp-action="PaymentQr"
                                   asp-route-invoiceId="@item.Id"
                                   class="btn btn-success btn-sm">
                                    Thanh toán QR
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="display-5 mb-3">🧾</div>
            <h4>Chưa có hóa đơn</h4>
            <p class="text-muted mb-4">
                Hóa đơn sẽ xuất hiện sau khi Booking được Check Out và lập hóa đơn.
            </p>

            <a asp-controller="Bookings"
               asp-action="MyBookings"
               class="btn btn-primary">
                Xem Booking của tôi
            </a>
        </div>
    </div>
}
