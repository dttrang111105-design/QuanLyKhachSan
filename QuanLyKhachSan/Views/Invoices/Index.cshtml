            background: #fafafb;
            color: #818795;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .invoice-table tbody td {
            padding: 15px 12px;
            border-bottom: 1px solid #eff0f3;
            color: #555b68;
            font-size: 11px;
        }
        .invoice-table tbody tr:hover {
            background: #fcfbf9;
        }
        .invoice-code-cell {
            display: flex;
            align-items: center;
            gap: 9px;
        }
        .invoice-code-icon {
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: #f4ead7;
            color: #8f692f;
        }
        .invoice-code-cell div,
        .invoice-booking-cell,
        .invoice-date-cell {
            display: flex;
            flex-direction: column;
        }
            .invoice-code-cell strong,
            .invoice-booking-cell strong,
            .invoice-date-cell strong {
                color: #343944;
