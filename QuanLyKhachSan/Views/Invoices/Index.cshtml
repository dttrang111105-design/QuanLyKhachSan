            .invoice-total small {
                color: #9499a5;
                font-size: 8px;
            }
        .invoice-total {
            color: #222733;
        }
        .invoice-tax-info {
            display: block;
            margin-top: 2px;
            color: #999eaa;
            font-size: 8px;
            white-space: nowrap;
        }
        .invoice-deposit {
            color: #936d2e;
        }
        .invoice-paid,
        .invoice-complete {
            color: #27875e;
        }
        .invoice-remaining {
            color: #cf535d;
        }
        .invoice-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 9px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 700;
            white-space: nowrap;
        }
        .invoice-status-paid {
            background: #e3f6ec;
            color: #258459;
        }
        .invoice-status-partial {
            background: #eaf0ff;
            color: #4f6fd8;
        }
        .invoice-status-unpaid {
            background: #fff1d9;
            color: #b87610;
        }
        .invoice-action-button {
            width: 33px;
            height: 33px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-left: 2px;
            border: 1px solid #e1e3e8;
            border-radius: 9px;
            transition: 0.2s ease;
        }
        .invoice-action-view {
            color: #4f6fd8;
        }
        .invoice-action-pdf {
            color: #cf535d;
        }
        .invoice-action-edit {
            color: #b58025;
        }
        .invoice-action-pay {
            color: #27875e;
        }
        .invoice-action-delete {
            color: #cf535d;
        }
        .invoice-action-button:hover {
            background: #f4f5f8;
            transform: translateY(-2px);
        }
        .invoice-action-view:hover {
            border-color: #4f6fd8;
            background: #eaf0ff;
        }
        .invoice-action-pdf:hover,
        .invoice-action-delete:hover {
            border-color: #cf535d;
            background: #fde9eb;
        }
        .invoice-action-edit:hover {
            border-color: #d49a36;
            background: #fff3df;
        }
        .invoice-action-pay:hover {
            border-color: #27875e;
            background: #e4f7ef;
        }
        .invoice-empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 70px 20px;
            color: #858b98;
            text-align: center;
        }
            .invoice-empty-state i {
                margin-bottom: 12px;
                color: #c1c5ce;
                font-size: 48px;
            }
            .invoice-empty-state h4 {
                color: #454b57;
            }
        @@media (max-width: 1199.98px) {
            .invoice-panel-header {
                align-items: flex-start;
                flex-direction: column;
            }
            .invoice-filter-area {
                width: 100%;
            }
            .invoice-search-box {
                flex: 1;
            }
                .invoice-search-box input {
                    width: 100%;
                }
        }
        @@media (max-width: 767.98px) {
            .invoice-filter-area {
                align-items: stretch;
                flex-direction: column;
            }
                .invoice-filter-area .form-select {
                    width: 100%;
                }
        }
    </style>
}
@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const searchInput =
                    document.getElementById(
                        "invoiceSearch"
                    );
                const statusFilter =
                    document.getElementById(
                        "invoiceStatusFilter"
                    );
                const rows =
                    document.querySelectorAll(
                        ".invoice-row"
                    );
                const emptyState =
                    document.getElementById(
                        "invoiceFilterEmpty"
                    );
                function filterInvoices() {
                    const keyword =
                        searchInput?.value
                            .trim()
                            .toLowerCase()
                        ?? "";
                    const status =
                        statusFilter?.value
                        ?? "";
                    let visibleCount = 0;
                    rows.forEach(function (row) {
                        const rowSearch =
                            row.dataset.search
                            ?? "";
                        const rowStatus =
                            row.dataset.status
                            ?? "";
                        const searchMatched =
                            !keyword ||
                            rowSearch.includes(keyword);
                        const statusMatched =
                            !status ||
                            rowStatus === status;
                        const visible =
                            searchMatched &&
                            statusMatched;
                        row.classList.toggle(
                            "d-none",
                            !visible
                        );
                        if (visible) {
                            visibleCount++;
                        }
                    });
                    if (emptyState) {
                        emptyState.classList.toggle(
                            "d-none",
                            visibleCount > 0
                        );
                    }
                }
                searchInput?.addEventListener(
                    "input",
                    filterInvoices
                );
                statusFilter?.addEventListener(
                    "change",
                    filterInvoices
                );
            }
        );
    </script>
}