@model IEnumerable<QuanLyKhachSan.Models.Invoice>
@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models

@{
    bool isReceptionist = User.IsInRole("Receptionist");

    Layout = isReceptionist
        ? "~/Views/Shared/_ReceptionistLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Quản lý hóa đơn";

    List<Invoice> invoices = Model?.ToList() ?? new List<Invoice>();

    decimal PaidAmount(Invoice invoice)
    {
        return invoice.Payments?
            .Where(payment =>
                !payment.IsDeleted &&
                payment.PaymentStatus == PaymentStatus.Paid)
            .Sum(payment => payment.Amount)
            ?? 0;
    }
    decimal DepositAmount(Invoice invoice)
    {
        return invoice.Booking?.Deposit ?? 0;
    }
    decimal NeedToPay(Invoice invoice)
    {
        return Math.Max(
            0m,
            invoice.TotalAmount - DepositAmount(invoice));
    }
    decimal RemainingAmount(Invoice invoice)
    {
        return Math.Max(
            0m,
            NeedToPay(invoice) - PaidAmount(invoice));
    }
    string InvoiceStatus(Invoice invoice)
    {
        decimal paid = PaidAmount(invoice);
        decimal remaining = RemainingAmount(invoice);
        if (remaining <= 0)
        {
            return "paid";
        }
        if (paid > 0)
        {
            return "partial";
        }
        return "unpaid";
    }
    string InvoiceStatusText(Invoice invoice)
    {
        return InvoiceStatus(invoice) switch
        {
            "paid" => "Đã thanh toán",
            "partial" => "Thanh toán một phần",
            _ => "Chưa thanh toán"
        };
    }
    string InvoiceStatusClass(Invoice invoice)
    {
        return InvoiceStatus(invoice) switch
        {
            "paid" => "invoice-status-paid",
            "partial" => "invoice-status-partial",
            _ => "invoice-status-unpaid"
        };
    }
    decimal totalInvoiceAmount =
        invoices.Sum(invoice => invoice.TotalAmount);
    decimal totalNeedToPay =
        invoices.Sum(invoice => NeedToPay(invoice));
    decimal totalPaidAmount =
        invoices.Sum(invoice => PaidAmount(invoice));
    decimal totalRemaining =
        invoices.Sum(invoice => RemainingAmount(invoice));
    int paidInvoiceCount =
        invoices.Count(invoice =>
            RemainingAmount(invoice) <= 0);
    int unpaidInvoiceCount =
        invoices.Count(invoice =>
            RemainingAmount(invoice) > 0);
}
<!-- TIÊU ĐỀ -->
<section class="admin-dashboard-heading">
    <div>
        <span class="admin-dashboard-kicker">
            Tài chính khách sạn
        </span>
        <h2>
            Quản lý hóa đơn
        </h2>
        <p>
            Theo dõi tiền phòng, dịch vụ, tiền cọc,
            trạng thái thanh toán và các giao dịch liên quan.
        </p>
    </div>
    <div class="admin-dashboard-actions">
        <a asp-controller="Payments"
           asp-action="Index"
           class="admin-outline-action">
            <i class="bi bi-credit-card"></i>
            Lịch sử thanh toán
        </a>
        <a asp-controller="Invoices"
           asp-action="Create"
           class="admin-primary-action">
            <i class="bi bi-plus-lg"></i>
            Lập hóa đơn
        </a>
    </div>
</section>
<!-- THÔNG BÁO -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng">
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng">
        </button>
    </div>
}
<!-- THẺ THỐNG KÊ -->
<div class="row g-4 mb-4">
    <!-- Tổng hóa đơn -->
    <div class="col-xl-3 col-md-6">
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-icon invoice-icon-blue">
                    <i class="bi bi-receipt-cutoff"></i>
                </span>
                <span class="invoice-stat-tag">
                    Tất cả
                </span>
            </div>
            <span class="invoice-stat-title">
                Tổng số hóa đơn
            </span>
            <strong class="invoice-stat-value">
                @invoices.Count
            </strong>
            <small>
                Hóa đơn trong hệ thống
            </small>
        </div>
    </div>
    <!-- Tổng giá trị -->
    <div class="col-xl-3 col-md-6">
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-icon invoice-icon-gold">
                    <i class="bi bi-cash-stack"></i>
                </span>
                <span class="invoice-stat-tag">
                    Giá trị
                </span>
            </div>
            <span class="invoice-stat-title">
                Tổng tiền hóa đơn
            </span>
            <strong class="invoice-stat-value invoice-stat-money">
                @totalInvoiceAmount.ToString("N0")
                <small>VNĐ</small>
            </strong>
            <small>
                Bao gồm tiền phòng và dịch vụ
            </small>
        </div>
    </div>
    <!-- Đã thu -->
    <div class="col-xl-3 col-md-6">
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-icon invoice-icon-green">
                    <i class="bi bi-check-circle"></i>
                </span>
                <span class="invoice-stat-tag">
                    @paidInvoiceCount hóa đơn
                </span>
            </div>
            <span class="invoice-stat-title">
                Số tiền đã thu
            </span>
            <strong class="invoice-stat-value invoice-stat-money">
                @totalPaidAmount.ToString("N0")
                <small>VNĐ</small>
            </strong>
            <small>
                Không bao gồm tiền cọc đã trừ
            </small>
        </div>
    </div>
    <!-- Còn phải thu -->
    <div class="col-xl-3 col-md-6">
        <div class="invoice-stat-card">
            <div class="invoice-stat-top">
                <span class="invoice-stat-icon invoice-icon-red">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <span class="invoice-stat-tag">
                    @unpaidInvoiceCount chưa đủ
                </span>
            </div>
            <span class="invoice-stat-title">
                Còn phải thu
            </span>
            <strong class="invoice-stat-value invoice-stat-money">
                @totalRemaining.ToString("N0")
                <small>VNĐ</small>
            </strong>
            <small>
                Sau khi trừ cọc và thanh toán
            </small>
        </div>
    </div>
</div>
<!-- DANH SÁCH HÓA ĐƠN -->
<div class="admin-panel">
    <div class="invoice-panel-header">
        <div>
            <span class="admin-dashboard-kicker">
                Danh sách dữ liệu
            </span>
            <h3>
                Hóa đơn khách sạn
            </h3>
            <p>
                Có @invoices.Count hóa đơn được ghi nhận.
            </p>
        </div>
        <div class="invoice-filter-area">
            <div class="invoice-search-box">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="invoiceSearch"
                       placeholder="Tìm mã hóa đơn, Booking, khách hàng..." />
            </div>
            <select id="invoiceStatusFilter"
                    class="form-select">
                <option value="">
                    Tất cả trạng thái
                </option>
                <option value="paid">
                    Đã thanh toán
                </option>
                <option value="partial">
                    Thanh toán một phần
                </option>
                <option value="unpaid">
                    Chưa thanh toán
                </option>
            </select>
        </div>
    </div>
    @if (invoices.Any())
    {
        <div class="table-responsive">
            <table class="table invoice-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4"> Hóa đơn </th>
                        <th> Booking / Khách hàng </th>
                        <th> Ngày lập </th>
                        <th> Tiền phòng </th>
                        <th> Dịch vụ </th>
                        <th> Cọc </th>
                        <th> Tổng tiền </th>
                        <th> Đã thu </th>
                        <th> Còn lại </th>
                        <th> Trạng thái </th>
                        <th class="text-end pe-4"> Thao tác </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Invoice invoice in invoices)
                    {
                        decimal paidAmount = PaidAmount(invoice);
                        decimal deposit = DepositAmount(invoice);
                        decimal remaining = RemainingAmount(invoice);
                        string customerName = invoice.Booking?.Customer?.FullName ?? "Chưa xác định";
                        string bookingCode = invoice.Booking?.BookingCode ?? "Chưa xác định";
                        string searchData = $"{invoice.InvoiceCode} {bookingCode} {customerName}".ToLower();
                        <tr class="invoice-row"
                            data-status="@InvoiceStatus(invoice)"
                            data-search="@searchData">
                            <!-- Mã hóa đơn -->
                            <td class="ps-4">
                                <div class="invoice-code-cell">
                                    <span class="invoice-code-icon">
                                        <i class="bi bi-receipt"></i>
                                    </span>
                                    <div>
                                        <strong>  @invoice.InvoiceCode </strong>
                                        <small> #@invoice.Id </small>
                                    </div>
                                </div>
                            </td>
                            <!-- Booking và khách -->
                            <td>
                                <div class="invoice-booking-cell">
                                    <strong> @bookingCode </strong>
                                    <small>
                                        <i class="bi bi-person me-1"></i>
                                        @customerName
                                    </small>
                                </div>
                            </td>
                            <!-- Ngày lập -->
                            <td>
                                <div class="invoice-date-cell">
                                    <strong>
                                        @invoice.InvoiceDate.ToString("dd/MM/yyyy")
                                    </strong>
                                    <small>
                                        @invoice.InvoiceDate.ToString("HH:mm")
                                    </small>
                                </div>
                            </td>
                            <!-- Tiền phòng -->
                            <td>
                                <span class="invoice-money">
                                    @invoice.RoomAmount.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Tiền dịch vụ -->
                            <td>
                                <span class="invoice-money">
                                    @invoice.ServiceAmount.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Tiền cọc -->
                            <td>
                                <span class="invoice-money invoice-deposit">
                                    @deposit.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Tổng tiền -->
                            <td>
                                <strong class="invoice-total">
                                    @invoice.TotalAmount.ToString("N0")
                                    <small>VNĐ</small>
                                </strong>
                                <small class="invoice-tax-info">
                                    Giảm @invoice.DiscountPercent%
                                    · VAT @invoice.TaxPercent%
                                </small>
                            </td>
                            <!-- Đã thu -->
                            <td>
                                <span class="invoice-money invoice-paid">
                                    @paidAmount.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Còn lại -->
                            <td>
                                <span class="invoice-money
                                    @(remaining > 0 ? "invoice-remaining" : "invoice-complete")">
                                    @remaining.ToString("N0")
                                    <small>VNĐ</small>
                                </span>
                            </td>
                            <!-- Trạng thái -->
                            <td>
                                <span class="invoice-status
                                    @InvoiceStatusClass(invoice)">
                                    @if (InvoiceStatus(invoice) == "paid")
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                    }
                                    else if (InvoiceStatus(invoice) == "partial")
                                    {
                                        <i class="bi bi-pie-chart-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clock-fill"></i>
                                    }
                                    @InvoiceStatusText(invoice)
                                </span>
                            </td>
                            <!-- Thao tác -->
                            <td class="text-end text-nowrap pe-4">
                                <a asp-controller="Invoices"
                                   asp-action="Details"
                                   asp-route-id="@invoice.Id"
                                   class="invoice-action-button
                                    invoice-action-view"
                                   title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Invoices"
                                   asp-action="ExportPdf"
                                   asp-route-id="@invoice.Id"
                                   class="invoice-action-button
                                    invoice-action-pdf"
                                   title="Tải PDF">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                                <a asp-controller="Invoices"
                                   asp-action="Edit"
                                   asp-route-id="@invoice.Id"
                                   class="invoice-action-button
                                    invoice-action-edit"
                                   title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                @if (remaining > 0)
                                {
                                    <a asp-controller="Payments"
                                       asp-action="Create"
                                       asp-route-invoiceId="@invoice.Id"
                                       class="invoice-action-button
                                        invoice-action-pay"
                                       title="Thanh toán">
                                        <i class="bi bi-credit-card"></i>
                                    </a>
                                }
                                @if (isReceptionist)
                                {
                                    <a asp-controller="Invoices"
                                       asp-action="Delete"
                                       asp-route-id="@invoice.Id"
                                       class="invoice-action-button invoice-action-delete"
                                       title="Xóa hóa đơn">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="invoiceFilterEmpty" class="invoice-empty-state d-none">
            <i class="bi bi-search"></i>
            <h4> Không tìm thấy hóa đơn </h4>
            <p> Hãy thử từ khóa hoặc trạng thái khác. </p>
        </div>
    }
    else
    {
        <div class="invoice-empty-state">
            <i class="bi bi-receipt"></i>
            <h4> Chưa có hóa đơn </h4>
            <p>
                Hóa đơn sẽ được tạo sau khi khách hàng
                hoàn tất quá trình trả phòng.
            </p>
            <a asp-controller="Invoices" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Lập hóa đơn đầu tiên
            </a>
        </div>
    }
</div>
@section Styles
{
    <style>
        .invoice-stat-card {
            height: 100%;
            padding: 22px;
            border: 1px solid #e8e9ee;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(34, 38, 51, 0.07);
        }
        .invoice-stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }
        .invoice-stat-icon {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            font-size: 21px;
        }
        .invoice-icon-blue {
            background: #eaf0ff;
            color: #4f6fd8;
        }
        .invoice-icon-gold {
            background: #f4ead7;
            color: #8f692f;
        }
        .invoice-icon-green {
            background: #e4f7ef;
            color: #27875e;
        }
        .invoice-icon-red {
            background: #fde9eb;
            color: #cf535d;
        }
        .invoice-stat-tag {
            padding: 5px 9px;
            border-radius: 20px;
            background: #f3f4f7;
            color: #838897;
            font-size: 10px;
            font-weight: 700;
        }
        .invoice-stat-title {
            display: block;
            color: #838897;
            font-size: 12px;
            font-weight: 600;
        }
        .invoice-stat-value {
            display: block;
            margin: 5px 0 13px;
            color: #242834;
            font-size: 34px;
            line-height: 1.15;
        }
        .invoice-stat-money {
            font-size: 24px;
        }
        .invoice-stat-value small {
            color: #838897;
            font-size: 10px;
        }
        .invoice-stat-card > small {
            color: #8b909e;
            font-size: 11px;
        }
        .invoice-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 22px;
            border-bottom: 1px solid #e8e9ee;
        }
            .invoice-panel-header h3 {
                margin: 3px 0;
                font-family: "Playfair Display", serif;
                font-size: 21px;
            }
            .invoice-panel-header p {
                margin: 0;
                color: #838897;
                font-size: 12px;
            }
        .invoice-filter-area {
            display: flex;
            gap: 9px;
        }
            .invoice-filter-area .form-select {
                width: 190px;
                min-height: 42px;
                border-color: #e1e3e9;
                border-radius: 11px;
                font-size: 12px;
            }
        .invoice-search-box {
            position: relative;
        }
            .invoice-search-box i {
                position: absolute;
                top: 50%;
                left: 13px;
                color: #999eaa;
                transform: translateY(-50%);
