@model QuanLyKhachSan.Models.Payment

@using QuanLyKhachSan.Enums

@{
    Layout = User.IsInRole("Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";

    ViewData["Title"] = "Chỉnh sửa thanh toán";
}

<style>
    .payment-edit-page {
        max-width: 1080px;
        margin: 0 auto;
    }

    .payment-edit-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }

    .payment-edit-kicker {
        display: block;
        margin-bottom: 6px;
        color: #b58a42;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }

    .payment-edit-heading h2 {
        margin: 0;
        color: #252a35;
        font-size: 30px;
        font-weight: 800;
    }

    .payment-edit-back {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border: 1px solid #dfe2e8;
        border-radius: 11px;
        background: #ffffff;
        color: #555c69;
        font-size: 13px;
        font-weight: 700;
    }

        .payment-edit-back:hover {
            border-color: #b58a42;
            color: #8f692f;
        }

    .payment-edit-card {
        overflow: hidden;
        border: 1px solid #e7e9ee;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 22px 55px rgba(34,38,51,.08);
    }

    .payment-edit-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 26px 28px;
        background: radial-gradient(circle at 90% 10%, rgba(200,169,106,.25), transparent 28%), linear-gradient(135deg,#111111,#332717);
        color: #ffffff;
    }

    .payment-edit-icon {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 56px;
        border-radius: 16px;
        background: linear-gradient(145deg,#e5c470,#ad7729);
        color: #171008;
        font-size: 25px;
    }

    .payment-edit-card-header h3 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
    }

    .payment-edit-card-header p {
        margin: 0;
        color: rgba(255,255,255,.65);
        font-size: 13px;
    }

    .payment-edit-body {
        padding: 30px;
    }

    .payment-edit-summary {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 14px;
        margin-bottom: 28px;
    }

    .payment-edit-summary-item {
        padding: 17px;
        border: 1px solid #e8e9ee;
        border-radius: 14px;
        background: #fcfcfd;
    }

        .payment-edit-summary-item span {
            display: block;
            margin-bottom: 5px;
            color: #8a909b;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .payment-edit-summary-item strong {
            color: #303641;
            font-size: 14px;
        }

    .payment-edit-field label {
        margin-bottom: 7px;
        color: #3c424d;
        font-size: 13px;
        font-weight: 700;
    }

    .payment-edit-field .form-control,
    .payment-edit-field .form-select {
        min-height: 50px;
        border: 1px solid #dfe2e8;
        border-radius: 11px;
        background: #fcfcfd;
        box-shadow: none;
    }

    .payment-edit-field textarea.form-control {
        min-height: 125px;
        resize: vertical;
    }

    .payment-edit-field .form-control:focus,
    .payment-edit-field .form-select:focus {
        border-color: #b58a42;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(181,138,66,.12);
    }

    .payment-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #eceef2;
    }

    .payment-edit-save,
    .payment-edit-cancel {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 21px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 800;
    }

    .payment-edit-save {
        border: 1px solid #b58a42;
        background: linear-gradient(145deg,#d8b25e,#a8752d);
        color: #ffffff;
    }

        .payment-edit-save:hover {
            background: linear-gradient(145deg,#e5c87f,#b98235);
            color: #ffffff;
        }

    .payment-edit-cancel {
        border: 1px solid #dfe2e8;
        background: #ffffff;
        color: #555c69;
    }

    @@media (max-width: 767.98px) {
        .payment-edit-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .payment-edit-summary {
            grid-template-columns: 1fr;
        }

        .payment-edit-card-header,
        .payment-edit-body {
            padding: 22px;
        }

        .payment-edit-actions {
            flex-direction: column;
        }

        .payment-edit-save,
        .payment-edit-cancel {
            width: 100%;
        }
    }
</style>

<div class="payment-edit-page">
    <div class="payment-edit-heading">
        <div>
            <span class="payment-edit-kicker">Quản lý thanh toán</span>
            <h2>Chỉnh sửa giao dịch</h2>
        </div>

        <a asp-controller="Payments"
           asp-action="Index"
           class="payment-edit-back">
            <i class="bi bi-arrow-left"></i>
            Quay lại danh sách
        </a>
    </div>

    <div class="payment-edit-card">
        <div class="payment-edit-card-header">
            <span class="payment-edit-icon">
                <i class="bi bi-credit-card-2-front-fill"></i>
            </span>

            <div>
                <h3>@Model.TransactionCode</h3>
                <p>Cập nhật phương thức, trạng thái và thông tin giao dịch.</p>
            </div>
        </div>

        <div class="payment-edit-body">
            <div class="payment-edit-summary">
                <div class="payment-edit-summary-item">
                    <span>Mã hóa đơn</span>
                    <strong>@(Model.Invoice?.InvoiceCode ?? $"#{Model.InvoiceId}")</strong>
                </div>

                <div class="payment-edit-summary-item">
                    <span>Mã Booking</span>
                    <strong>@(Model.Invoice?.Booking?.BookingCode ?? "Chưa có")</strong>
                </div>

                <div class="payment-edit-summary-item">
                    <span>Ngày tạo giao dịch</span>
                    <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>

            <form asp-controller="Payments"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-4">
                    <div class="col-md-6 payment-edit-field">
                        <label asp-for="PaymentMethod">Phương thức thanh toán</label>
                        <select asp-for="PaymentMethod"
                                asp-items="Html.GetEnumSelectList<PaymentMethod>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="PaymentMethod"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 payment-edit-field">
                        <label asp-for="PaymentStatus">Trạng thái thanh toán</label>
                        <select asp-for="PaymentStatus"
                                asp-items="Html.GetEnumSelectList<PaymentStatus>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="PaymentStatus"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 payment-edit-field">
                        <label asp-for="Amount">Số tiền</label>
                        <div class="input-group">
                            <input asp-for="Amount"
                                   type="number"
                                   min="0"
                                   step="1000"
                                   class="form-control" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Amount"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 payment-edit-field">
                        <label asp-for="TransactionCode">Mã giao dịch</label>
                        <input asp-for="TransactionCode"
                               class="form-control"
                               placeholder="Nhập mã giao dịch" />
                        <span asp-validation-for="TransactionCode"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 payment-edit-field">
                        <label asp-for="PaymentDate">Ngày thanh toán</label>
                        <input asp-for="PaymentDate"
                               type="datetime-local"
                               class="form-control" />
                        <span asp-validation-for="PaymentDate"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 payment-edit-field">
                        <label asp-for="Note">Ghi chú</label>
                        <textarea asp-for="Note"
                                  class="form-control"
                                  placeholder="Nhập ghi chú giao dịch"></textarea>
                        <span asp-validation-for="Note"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="payment-edit-actions">
                    <button type="submit"
                            class="payment-edit-save">
                        <i class="bi bi-check-circle"></i>
                        Lưu thay đổi
                    </button>

                    <a asp-controller="Payments"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="payment-edit-cancel">
                        <i class="bi bi-x-circle"></i>
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
