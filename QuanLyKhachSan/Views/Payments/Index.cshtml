        }

        .payment-stat-title {
            display: block;
            color: #838897;
            font-size: 12px;
            font-weight: 600;
        }

        .payment-stat-value {
            display: block;
            margin: 5px 0 13px;
            color: #242834;
            font-size: 34px;
            line-height: 1.15;
        }

        .payment-money-value {
            font-size: 25px;
        }

        .payment-stat-value small {
