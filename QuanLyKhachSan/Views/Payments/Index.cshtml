@model IEnumerable<QuanLyKhachSan.Models.Payment>

@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");

    Layout = isAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_ReceptionistLayout.cshtml";

    ViewData["Title"] = "Quản lý thanh toán";

    List<Payment> payments =
        Model?.ToList() ?? new List<Payment>();

    int totalPayments = payments.Count;

    int paidPayments = payments.Count(payment =>
        payment.PaymentStatus == PaymentStatus.Paid);

    int pendingPayments = payments.Count(payment =>
        payment.PaymentStatus == PaymentStatus.Pending);

    decimal totalPaidAmount = payments
        .Where(payment =>
            payment.PaymentStatus == PaymentStatus.Paid)
        .Sum(payment => payment.Amount);

    decimal paidToday = payments
        .Where(payment =>
            payment.PaymentStatus == PaymentStatus.Paid &&
            payment.PaymentDate.Date == DateTime.Today)
        .Sum(payment => payment.Amount);

    string PaymentMethodText(PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.Cash => "Tiền mặt",
            PaymentMethod.BankTransfer => "Chuyển khoản",
            PaymentMethod.Momo => "MoMo",
            PaymentMethod.VNPay => "VNPay",
            _ => method.ToString()
        };
    }

    string PaymentMethodIcon(PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.Cash => "bi-cash-stack",
            PaymentMethod.BankTransfer => "bi-bank",
            PaymentMethod.Momo => "bi-phone",
            PaymentMethod.VNPay => "bi-qr-code",
            _ => "bi-credit-card"
        };
    }

    string PaymentStatusText(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Paid => "Đã thanh toán",
            PaymentStatus.Pending => "Đang xử lý",
            PaymentStatus.Failed => "Thất bại",
            PaymentStatus.Refunded => "Đã hoàn tiền",
            _ => status.ToString()
        };
    }

    string PaymentStatusClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Paid => "payment-status-paid",
            PaymentStatus.Pending => "payment-status-pending",
            PaymentStatus.Failed => "payment-status-failed",
            PaymentStatus.Refunded => "payment-status-refunded",
            _ => "payment-status-default"
        };
    }
}

<section class="admin-dashboard-heading">

    <div>

        <span class="admin-dashboard-kicker">
            Tài chính khách sạn
        </span>

        <h2>
            Quản lý thanh toán
        </h2>

        <p>
            Theo dõi giao dịch thanh toán từ tiền mặt,
            chuyển khoản, MoMo, VNPay và VietQR.
        </p>

    </div>

    <div class="admin-dashboard-actions">

        <a asp-controller="Invoices"
           asp-action="Index"
           class="admin-outline-action">

            <i class="bi bi-receipt"></i>
            Danh sách hóa đơn

        </a>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="admin-primary-action">

            <i class="bi bi-grid-1x2"></i>
            Tổng quan

        </a>

    </div>

</section>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng">
        </button>

    </div>
}

<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="payment-stat-card">

            <div class="payment-stat-header">

                <span class="payment-stat-icon payment-stat-blue">
                    <i class="bi bi-credit-card-2-front"></i>
                </span>

                <span class="payment-stat-label">
                    Tất cả
                </span>

            </div>

            <span class="payment-stat-title">
                Tổng giao dịch
            </span>

            <strong class="payment-stat-value">
                @totalPayments
            </strong>

            <small>
                Giao dịch trong hệ thống
            </small>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="payment-stat-card">

            <div class="payment-stat-header">

                <span class="payment-stat-icon payment-stat-green">
                    <i class="bi bi-check-circle"></i>
                </span>

                <span class="payment-stat-label">
                    Thành công
                </span>

            </div>

            <span class="payment-stat-title">
                Đã thanh toán
            </span>

            <strong class="payment-stat-value">
                @paidPayments
            </strong>

            <small>
                @pendingPayments giao dịch đang xử lý
            </small>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="payment-stat-card">

            <div class="payment-stat-header">

                <span class="payment-stat-icon payment-stat-gold">
                    <i class="bi bi-wallet2"></i>
                </span>

                <span class="payment-stat-label">
                    Doanh thu
                </span>

            </div>

            <span class="payment-stat-title">
                Tổng tiền đã thu
            </span>

            <strong class="payment-stat-value payment-money-value">

                @totalPaidAmount.ToString("N0")

                <small>VNĐ</small>

            </strong>

            <small>
                Từ các giao dịch đã thanh toán
            </small>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="payment-stat-card">

            <div class="payment-stat-header">

                <span class="payment-stat-icon payment-stat-purple">
                    <i class="bi bi-calendar-check"></i>
                </span>

                <span class="payment-stat-label">
                    Hôm nay
                </span>

            </div>

            <span class="payment-stat-title">
                Thu trong ngày
            </span>

            <strong class="payment-stat-value payment-money-value">

                @paidToday.ToString("N0")

                <small>VNĐ</small>

            </strong>

            <small>
                Ngày @DateTime.Today.ToString("dd/MM/yyyy")
            </small>

        </div>

    </div>

</div>

<div class="admin-panel">

    <div class="payment-panel-header">

        <div>

            <span class="admin-dashboard-kicker">
                Lịch sử giao dịch
            </span>

            <h3>
                Danh sách thanh toán
            </h3>

            <p>
                Có @totalPayments giao dịch được ghi nhận.
            </p>

        </div>

        <div class="payment-filter-group">

            <div class="payment-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="paymentSearchInput"
                       placeholder="Tìm mã hóa đơn, mã giao dịch..." />

            </div>

            <select id="paymentStatusFilter"
                    class="form-select">

                <option value="">
                    Tất cả trạng thái
                </option>

                <option value="Paid">
                    Đã thanh toán
                </option>

                <option value="Pending">
                    Đang xử lý
                </option>

                <option value="Failed">
                    Thất bại
                </option>

                <option value="Refunded">
                    Đã hoàn tiền
                </option>

            </select>

            <select id="paymentMethodFilter"
                    class="form-select">

                <option value="">
                    Tất cả phương thức
                </option>

                <option value="Cash">
                    Tiền mặt
                </option>

                <option value="BankTransfer">
                    Chuyển khoản
                </option>

                <option value="Momo">
                    MoMo
                </option>

                <option value="VNPay">
                    VNPay
                </option>

            </select>

        </div>

    </div>

    @if (payments.Any())
    {
        <div class="table-responsive">

            <table class="table payment-table align-middle mb-0"
                   id="paymentTable">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Mã hóa đơn
                        </th>

                        <th>
                            Phương thức
                        </th>

                        <th>
                            Trạng thái
                        </th>

                        <th>
                            Số tiền
                        </th>

                        <th>
                            Mã giao dịch
                        </th>

                        <th>
                            Ngày thanh toán
                        </th>

                        <th>
                            Ghi chú
                        </th>

                        <th class="text-end pe-4">
                            Thao tác
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (Payment payment in payments)
                    {
                        string invoiceCode =
                        payment.Invoice?.InvoiceCode
                        ?? "Không xác định";

                        string searchData =
                        $"{invoiceCode} {payment.TransactionCode} {payment.Note}"
                        .ToLower();

                        <tr class="payment-row"
                            data-status="@payment.PaymentStatus"
                            data-method="@payment.PaymentMethod"
                            data-search="@searchData">

                            <td class="ps-4">

                                <div class="payment-invoice-cell">

                                    <span class="payment-invoice-icon">
                                        <i class="bi bi-receipt"></i>
                                    </span>

                                    <div>

                                        <strong>
                                            @invoiceCode
                                        </strong>

                                        <small>
                                            Thanh toán #@payment.Id
                                        </small>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="payment-method">

                                    <i class="bi @PaymentMethodIcon(
                                                                               payment.PaymentMethod)">
                            </i>

                                    @PaymentMethodText(
                                                        payment.PaymentMethod)

                        </span>

                    </td>

                    <td>

                        <span class="payment-status
                                    @PaymentStatusClass(
                                                                      payment.PaymentStatus)">

                            @if (payment.PaymentStatus ==
                                                        PaymentStatus.Paid)
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                    }
                                    else if (payment.PaymentStatus ==
                                    PaymentStatus.Pending)
                                    {
                                        <i class="bi bi-hourglass-split"></i>
                                    }
                                    else if (payment.PaymentStatus ==
                                    PaymentStatus.Failed)
                                    {
                                        <i class="bi bi-x-circle-fill"></i>
                                    }
                                    else if (payment.PaymentStatus ==
                                    PaymentStatus.Refunded)
                                    {
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    }

                                    @PaymentStatusText(
                                    payment.PaymentStatus)

                        </span>

                    </td>

                    <td>

                        <strong class="payment-amount">

                            @payment.Amount.ToString("N0")

                            <small>
                                VNĐ
                            </small>

                        </strong>

                    </td>

                    <td>

                        @if (!string.IsNullOrWhiteSpace(
                                                payment.TransactionCode))
                                {
                                    <code class="payment-transaction-code">
                                        @payment.TransactionCode
                                    </code>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Chưa có
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="payment-date">

                                    <strong>
                                        @payment.PaymentDate.ToString(
                                                    "dd/MM/yyyy")
                            </strong>

                            <small>
                                @payment.PaymentDate.ToString(
                                                                                        "HH:mm")
                            </small>

                        </div>

                    </td>

                    <td>

                        @if (!string.IsNullOrWhiteSpace(
                                                payment.Note))
                                {
                                    <span class="payment-note"
                                          title="@payment.Note">

                                        @payment.Note

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>

                            <td class="text-end pe-4 text-nowrap">

                                <a asp-controller="Payments"
                                   asp-action="Details"
                                   asp-route-id="@payment.Id"
                                   class="payment-action-button
                                                  payment-action-details"
                                   title="Xem chi tiết">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-controller="Payments"
                                   asp-action="Edit"
                                   asp-route-id="@payment.Id"
                                   class="payment-action-button
                                                  payment-action-edit"
                                   title="Chỉnh sửa">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                @if (isAdmin)
                                {
                                    <a asp-controller="Payments"
                                       asp-action="Delete"
                                       asp-route-id="@payment.Id"
                                       class="payment-action-button
                                                          payment-action-delete"
                                       title="Xóa">

                                        <i class="bi bi-trash"></i>

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div id="paymentEmptyFilter"
             class="payment-empty-filter d-none">

            <i class="bi bi-search"></i>

            <strong>
                Không tìm thấy giao dịch
            </strong>

            <span>
                Hãy thử từ khóa hoặc bộ lọc khác.
            </span>

        </div>
    }
    else
    {
        <div class="payment-empty-state">

            <i class="bi bi-credit-card"></i>

            <h4>
                Chưa có giao dịch thanh toán
            </h4>

            <p>
                Thanh toán sẽ xuất hiện sau khi một hóa đơn
                được khách hàng hoặc nhân viên thanh toán.
            </p>

            <a asp-controller="Invoices"
               asp-action="Index"
               class="btn btn-primary">

                <i class="bi bi-receipt me-1"></i>
                Xem danh sách hóa đơn

            </a>

        </div>
    }

</div>
