@using QuanLyKhachSan.Enums
@model IEnumerable<QuanLyKhachSan.Models.Payment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã hóa đơn</th>
            <th>Phương thức</th>
            <th>Trạng thái</th>
            <th>Số tiền</th>
            <th>Mã giao dịch</th>
            <th>Ngày thanh toán</th>
            <th>Ghi chú</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Invoice?.InvoiceCode</td>
                <td>@item.PaymentMethod</td>
                <td>

                    @if (item.PaymentStatus == PaymentStatus.Pending)
                    {
                        <span class="badge bg-warning">
                            Pending
                        </span>
                    }
                    else if (item.PaymentStatus == PaymentStatus.Paid)
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else if (item.PaymentStatus == PaymentStatus.Failed)
                    {
                        <span class="badge bg-danger">
                            Failed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Refunded
                        </span>
                    }

                </td>
                @string.Format("{0:N0} VNĐ", item.Amount)
                <td>@item.TransactionCode</td>
                <td>@item.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Note</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
